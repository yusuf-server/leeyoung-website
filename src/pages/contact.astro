---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Contact Us - LEEYOUNG"
  description="Contact LEEYOUNG – email, phone, and service support. We respond as quickly as possible."
>
  <Header />

  <!-- Map/Address Section -->
  <section class="map-section">
    <div class="map-container">
      <div class="map-image">
        <img
          src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=1920&h=600&fit=crop"
          alt="LEEYOUNG Office"
          class="office-image"
        />
      </div>
      <div class="address-overlay">
        <div class="address-content">
          <h5>China, Guangdong, Guangzhou City, Baiyun District</h5>
          <a href="https://maps.google.com" target="_blank" rel="noopener noreferrer" class="map-link">
            Map Directions
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Options Title -->
  <section class="contact-title-section">
    <div class="container">
      <h2 class="contact-main-title">CONTACT OPTIONS</h2>
    </div>
  </section>

  <!-- Contact Options -->
  <section class="contact-options-section">
    <div class="container">
      <div class="contact-options-grid">
        <div class="contact-option">
          <div class="option-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <div class="option-content">
            <h3 class="option-title">INFO@LEEYOUNG.COM</h3>
            <p class="option-text">
              We reply as soon as possible<br/>
              Languages: English, Chinese
            </p>
          </div>
        </div>

        <div class="contact-option">
          <div class="option-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <div class="option-content">
            <h3 class="option-title">+86 138 0000 0000</h3>
            <p class="option-text">
              Phone language: Chinese, English<br/>
              Office hours: Monday-Friday: 9:00-18:00
            </p>
          </div>
        </div>

        <div class="contact-option">
          <div class="option-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 16v-4"/>
              <path d="M12 8h.01"/>
            </svg>
          </div>
          <div class="option-content">
            <h3 class="option-title">SUPPORT@LEEYOUNG.COM</h3>
            <p class="option-text">
              Direct contact with Service and Warranty Support<br/>
              24/7 Available
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Support Form CTA -->
  <section class="support-cta-section">
    <div class="container">
      <div class="support-cta-content">
        <div class="cta-text">
          <p>
            <strong>If you need product recommendations or have any questions, we're here to help.</strong>
          </p>
          <p>
            Based on your requirements, we will recommend the best products for your needs.
            We will send detailed information to your email address.
          </p>
        </div>
        <a href="#contact-form" class="cta-button">
          GET IN TOUCH
        </a>
      </div>
    </div>
  </section>

  <!-- Contact Form Section -->
  <section class="contact-form-section" id="contact-form">
    <div class="container">
      <div class="form-wrapper">
        <div class="form-header">
          <h2 class="form-title">Send us a message</h2>
          <p class="form-description">
            Fill out the form below and we'll get back to you as soon as possible.
          </p>
        </div>

        <form class="contact-form" id="contactForm">
          <div class="form-row">
            <div class="form-group">
              <label for="name">Name *</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Your name"
              />
            </div>

            <div class="form-group">
              <label for="email">Email *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="your@email.com"
              />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="phone">Phone</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                placeholder="+86 138 0000 0000"
              />
            </div>

            <div class="form-group">
              <label for="subject">Subject *</label>
              <input
                type="text"
                id="subject"
                name="subject"
                required
                placeholder="How can we help?"
              />
            </div>
          </div>

          <div class="form-group">
            <label for="message">Message *</label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              placeholder="Tell us more about your inquiry..."
            ></textarea>
          </div>

          <button type="submit" class="submit-button">
            Send Message
          </button>

          <div class="form-message" id="formMessage"></div>
        </form>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  const contactForm = document.getElementById('contactForm') as HTMLFormElement;
  const formMessage = document.getElementById('formMessage') as HTMLDivElement;

  if (contactForm) {
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(contactForm);
      const data = Object.fromEntries(formData.entries());

      try {
        // Here you would send the data to your backend API
        // For now, we'll just show a success message
        formMessage.textContent = 'Thank you for your message! We will get back to you soon.';
        formMessage.className = 'form-message success';
        contactForm.reset();

        // Hide message after 5 seconds
        setTimeout(() => {
          formMessage.textContent = '';
          formMessage.className = 'form-message';
        }, 5000);

      } catch (error) {
        formMessage.textContent = 'Something went wrong. Please try again.';
        formMessage.className = 'form-message error';
      }
    });
  }
</script>

<style>
  /* Map Section */
  .map-section {
    margin-top: 80px;
    position: relative;
  }

  .map-container {
    position: relative;
    width: 100%;
    height: 400px;
    overflow: hidden;
  }

  .map-image {
    width: 100%;
    height: 100%;
  }

  .office-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .address-overlay {
    position: absolute;
    top: 20px;
    left: 20px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    padding: 1.5rem 2rem;
    border-radius: 8px;
    max-width: 400px;
  }

  .address-content h5 {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 1rem 0;
    color: #000;
  }

  .map-link {
    color: #000;
    text-decoration: underline;
    font-weight: 600;
    font-size: 0.95rem;
    transition: opacity 0.3s;
  }

  .map-link:hover {
    opacity: 0.7;
  }

  /* Contact Title Section */
  .contact-title-section {
    background: #f4f4f4;
    padding: 2rem 0;
  }

  .contact-main-title {
    text-align: center;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin: 0;
    color: #000;
  }

  /* Contact Options Section */
  .contact-options-section {
    background: #f4f4f4;
    padding: 2rem 0 4rem;
  }

  .container {
    max-width: 1800px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .contact-options-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
  }

  .contact-option {
    text-align: left;
  }

  .option-icon {
    width: 48px;
    height: 48px;
    margin-bottom: 1.5rem;
    color: #000;
  }

  .option-icon svg {
    width: 100%;
    height: 100%;
  }

  .option-title {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: #000;
  }

  .option-text {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #666;
    margin: 0;
  }

  /* Support CTA Section */
  .support-cta-section {
    background: #fff;
    padding: 3rem 0;
  }

  .support-cta-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 3rem;
  }

  .cta-text {
    flex: 1;
  }

  .cta-text p {
    font-size: 1rem;
    line-height: 1.7;
    color: #333;
    margin-bottom: 1rem;
  }

  .cta-text p:last-child {
    margin-bottom: 0;
  }

  .cta-button {
    background: #000;
    color: #fff;
    padding: 1rem 2.5rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.05em;
    transition: background 0.3s;
    white-space: nowrap;
    display: inline-block;
  }

  .cta-button:hover {
    background: #333;
  }

  /* Contact Form Section */
  .contact-form-section {
    background: #f4f4f4;
    padding: 4rem 0;
  }

  .form-wrapper {
    max-width: 800px;
    margin: 0 auto;
    background: #fff;
    padding: 3rem;
    border-radius: 8px;
  }

  .form-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .form-title {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: #000;
  }

  .form-description {
    font-size: 1rem;
    color: #666;
    margin: 0;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
  }

  .form-group label {
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: #333;
  }

  .form-group input,
  .form-group textarea {
    padding: 0.875rem 1rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 0.95rem;
    font-family: inherit;
    transition: border-color 0.3s;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #000;
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .submit-button {
    background: #000;
    color: #fff;
    padding: 1rem 2rem;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: background 0.3s;
    margin-top: 0.5rem;
  }

  .submit-button:hover {
    background: #333;
  }

  .form-message {
    display: none;
    padding: 1rem;
    border-radius: 4px;
    text-align: center;
    margin-top: 1rem;
    font-weight: 600;
  }

  .form-message.success {
    display: block;
    background: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .form-message.error {
    display: block;
    background: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .contact-options-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .support-cta-content {
      flex-direction: column;
      text-align: center;
    }

    .form-row {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .map-section {
      margin-top: 60px;
    }

    .map-container {
      height: 300px;
    }

    .address-overlay {
      position: static;
      max-width: none;
      border-radius: 0;
      margin-top: -4px;
    }

    .contact-main-title {
      font-size: 1.5rem;
    }

    .container {
      padding: 0 1.5rem;
    }

    .support-cta-section {
      padding: 2rem 0;
    }

    .form-wrapper {
      padding: 2rem 1.5rem;
    }

    .form-title {
      font-size: 1.5rem;
    }
  }
</style>
