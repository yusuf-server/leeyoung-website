---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// 启用服务器端渲染
export const prerender = false;
---

<BaseLayout title="Shopping Cart - LEEYOUNG" description="View your shopping cart">
  <Header />

  <!-- Cart Page -->
  <section class="cart-page">
    <div class="cart-container">
      <h1 class="cart-page-title">Shopping Cart</h1>

      <!-- Cart Content -->
      <div class="cart-content" data-cart-page="content">

        <!-- Empty Cart -->
        <div class="cart-empty-page" data-cart-page="empty" style="display: none;">
          <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <h2>Your cart is empty</h2>
          <p>Add some products to your cart and they will appear here.</p>
          <a href="/shop" class="continue-shopping-btn">Continue Shopping</a>
        </div>

        <!-- Cart Items -->
        <div class="cart-grid" data-cart-page="grid">

          <!-- Items List -->
          <div class="cart-items-section">
            <div class="cart-items-header">
              <span>Product</span>
              <span>Price</span>
              <span>Quantity</span>
              <span>Total</span>
            </div>

            <div class="cart-items-list" data-cart-page="items">
              <!-- Cart items will be rendered here -->
            </div>
          </div>

          <!-- Cart Summary -->
          <div class="cart-summary-section">
            <h3 class="summary-title">Order Summary</h3>

            <div class="summary-rows">
              <div class="summary-row">
                <span>Subtotal</span>
                <span data-cart-page="subtotal">$0.00</span>
              </div>
              <div class="summary-row">
                <span>Shipping</span>
                <span data-cart-page="shipping">$0.00</span>
              </div>
              <div class="summary-row summary-total">
                <span>Total</span>
                <span data-cart-page="total">$0.00</span>
              </div>
            </div>

            <div class="summary-actions">
              <a href="/checkout" class="btn btn-primary btn-full">Proceed to Checkout</a>
              <a href="/shop" class="btn btn-secondary btn-full">Continue Shopping</a>
            </div>

            <div class="shipping-note">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="1" y="3" width="15" height="13"></rect>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                <circle cx="5.5" cy="18.5" r="2.5"></circle>
                <circle cx="18.5" cy="18.5" r="2.5"></circle>
              </svg>
              <span>Free shipping on orders over $100</span>
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  import { CartManager, type Cart } from '../lib/cart-manager';
  import { gsap } from '../lib/gsap';

  // ==================== 购物车状态 ====================
  let currentCart: Cart = CartManager.getCart();

  // ==================== DOM 元素 ====================
  const emptySection = document.querySelector('[data-cart-page="empty"]') as HTMLElement;
  const gridSection = document.querySelector('[data-cart-page="grid"]') as HTMLElement;
  const itemsList = document.querySelector('[data-cart-page="items"]') as HTMLElement;

  // ==================== 渲染购物车 ====================
  function renderCart(cart: Cart) {
    currentCart = cart;

    if (cart.items.length === 0) {
      // 显示空购物车
      if (emptySection) emptySection.style.display = 'flex';
      if (gridSection) gridSection.style.display = 'none';
    } else {
      // 显示购物车商品
      if (emptySection) emptySection.style.display = 'none';
      if (gridSection) gridSection.style.display = 'grid';

      // 渲染商品列表
      if (itemsList) {
        itemsList.innerHTML = cart.items
          .map(
            (item) => `
          <div class="cart-item" data-item-id="${item.id}">
            <div class="cart-item-product">
              <a href="/products/${item.slug}" class="cart-item-image">
                <img src="${item.image}" alt="${item.name}" />
              </a>
              <div class="cart-item-info">
                <a href="/products/${item.slug}" class="cart-item-name">${item.name}</a>
                <button class="cart-item-remove-btn" data-action="remove" data-item-id="${item.id}">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                  </svg>
                  Remove
                </button>
              </div>
            </div>

            <div class="cart-item-price">
              <span>$${item.price.toFixed(2)}</span>
            </div>

            <div class="cart-item-quantity">
              <button class="qty-btn" data-action="decrease" data-item-id="${item.id}">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </button>
              <input type="number" class="qty-input" value="${item.quantity}" min="1" data-item-id="${item.id}" />
              <button class="qty-btn" data-action="increase" data-item-id="${item.id}">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="12" y1="5" x2="12" y2="19"></line>
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
              </button>
            </div>

            <div class="cart-item-total">
              <span>$${(item.price * item.quantity).toFixed(2)}</span>
            </div>
          </div>
        `
          )
          .join('');

        // 事件已通过事件委托绑定，无需重复绑定
      }

      // 更新总价
      updateSummary(cart);
    }
  }

  // ==================== 更新总价 ====================
  function updateSummary(cart: Cart) {
    const subtotalEl = document.querySelector('[data-cart-page="subtotal"]');
    const shippingEl = document.querySelector('[data-cart-page="shipping"]');
    const totalEl = document.querySelector('[data-cart-page="total"]');

    if (subtotalEl) subtotalEl.textContent = `$${cart.subtotal.toFixed(2)}`;
    if (shippingEl) shippingEl.textContent = cart.shipping === 0 ? 'FREE' : `$${cart.shipping.toFixed(2)}`;
    if (totalEl) totalEl.textContent = `$${cart.total.toFixed(2)}`;
  }

  // ==================== 购物车商品事件（使用事件委托） ====================
  if (itemsList) {
    itemsList.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const btn = target.closest('[data-action]') as HTMLElement;

      if (!btn) return;

      const action = btn.dataset.action;
      const itemId = parseInt(btn.dataset.itemId || '0');

      // 始终从CartManager获取最新的购物车数据
      const latestCart = CartManager.getCart();
      const item = latestCart.items.find((i) => i.id === itemId);

      if (action === 'increase' && item) {
        const updatedCart = CartManager.updateQuantity(itemId, item.quantity + 1);
        renderCart(updatedCart);
      } else if (action === 'decrease' && item && item.quantity > 1) {
        const updatedCart = CartManager.updateQuantity(itemId, item.quantity - 1);
        renderCart(updatedCart);
      } else if (action === 'remove') {
        const itemElement = document.querySelector(`[data-item-id="${itemId}"]`);

        if (confirm('Are you sure you want to remove this item?')) {
          // 动画后移除
          if (itemElement) {
            gsap.to(itemElement, {
              opacity: 0,
              height: 0,
              marginBottom: 0,
              duration: 0.3,
              ease: 'power2.in',
              onComplete: () => {
                const updatedCart = CartManager.removeItem(itemId);
                renderCart(updatedCart);
              },
            });
          }
        }
      }
    });

    // 输入框数量修改
    itemsList.addEventListener('change', (e) => {
      const target = e.target as HTMLElement;
      if (target.classList.contains('qty-input')) {
        const input = target as HTMLInputElement;
        const itemId = parseInt(input.dataset.itemId || '0');
        const newQuantity = parseInt(input.value) || 1;

        if (newQuantity > 0) {
          const updatedCart = CartManager.updateQuantity(itemId, newQuantity);
          renderCart(updatedCart);
        }
      }
    });
  }

  // ==================== 监听购物车更新 ====================
  window.addEventListener('cart-updated', ((e: CustomEvent) => {
    renderCart(e.detail);
  }) as EventListener);

  // ==================== 入场动画 ====================
  gsap.from('.cart-page-title', {
    opacity: 0,
    y: 30,
    duration: 0.6,
    ease: 'power2.out',
  });

  gsap.from('.cart-items-section', {
    opacity: 0,
    y: 20,
    duration: 0.6,
    delay: 0.2,
    ease: 'power2.out',
  });

  gsap.from('.cart-summary-section', {
    opacity: 0,
    x: 20,
    duration: 0.6,
    delay: 0.3,
    ease: 'power2.out',
  });

  // ==================== 初始化 ====================
  renderCart(currentCart);
</script>

<style is:global>
  /* Cart Page Styles - v2.0 - Updated Layout */
  /* ==================== Header Override ==================== */
  .header {
    background: #000 !important;
  }

  /* ==================== Cart Page ==================== */
  .cart-page {
    background: #f4f4f4;
    min-height: 100vh;
    padding: 8rem 0 4rem;
  }

  .cart-container {
    max-width: 1800px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .cart-page-title {
    font-size: 2.5rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin-bottom: 3rem;
  }

  /* ==================== Empty Cart ==================== */
  .cart-empty-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6rem 2rem;
    background: #fff;
    border-radius: 4px;
  }

  .cart-empty-page svg {
    color: #ccc;
    margin-bottom: 2rem;
  }

  .cart-empty-page h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .cart-empty-page p {
    color: #666;
    margin-bottom: 2rem;
  }

  .continue-shopping-btn {
    padding: 1rem 2.5rem;
    background: #d4af37;
    color: #fff;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: background 0.3s;
  }

  .continue-shopping-btn:hover {
    background: #c49d2e;
  }

  /* ==================== Cart Grid ==================== */
  .cart-grid {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 3rem;
    align-items: start;
  }

  /* ==================== Cart Items Section ==================== */
  .cart-items-section {
    background: #fff;
    border-radius: 4px;
    padding: 2rem;
  }

  .cart-items-header {
    display: grid !important;
    grid-template-columns: 1fr 150px 180px 150px !important;
    gap: 1.5rem !important;
    padding-bottom: 1rem;
    border-bottom: 2px solid #e5e5e5;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #666;
  }

  .cart-items-list {
    display: flex;
    flex-direction: column;
  }

  .cart-page .cart-item {
    display: grid !important;
    grid-template-columns: 1fr 150px 180px 150px !important;
    gap: 1.5rem !important;
    padding: 2rem 0;
    border-bottom: 1px solid #e5e5e5;
    align-items: start;
  }

  .cart-page .cart-item:last-child {
    border-bottom: none;
  }

  .cart-page .cart-item-product {
    display: flex !important;
    gap: 1rem !important;
    align-items: flex-start !important;
  }

  .cart-page .cart-item-image {
    width: 70px !important;
    height: 70px !important;
    flex-shrink: 0;
    background: #f8f8f8;
    overflow: hidden;
  }

  .cart-page .cart-item-image img {
    width: 70px !important;
    height: 70px !important;
    max-width: 70px !important;
    object-fit: cover;
  }

  .cart-page .cart-item-info {
    display: flex !important;
    flex-direction: column !important;
    gap: 0.5rem !important;
    flex: 1 !important;
  }

  .cart-page .cart-item-name {
    font-size: 0.9rem !important;
    font-weight: 600 !important;
    color: #000 !important;
    text-decoration: none !important;
    text-transform: uppercase !important;
    letter-spacing: 0.03em !important;
    line-height: 1.4 !important;
    transition: color 0.3s;
    word-wrap: break-word !important;
    overflow-wrap: break-word !important;
    white-space: normal !important;
    display: block !important;
    width: auto !important;
  }

  .cart-page .cart-item-name:hover {
    color: #666;
  }

  .cart-page .cart-item-remove-btn {
    display: flex !important;
    align-items: center !important;
    gap: 0.4rem !important;
    background: none;
    border: none;
    color: #999;
    font-size: 0.8rem !important;
    cursor: pointer;
    transition: color 0.3s;
    padding: 0;
  }

  .cart-page .cart-item-remove-btn:hover {
    color: #e74c3c;
  }

  .cart-page .cart-item-price {
    font-size: 0.95rem !important;
    font-weight: 600;
    display: flex;
    align-items: center;
  }

  .cart-page .cart-item-quantity {
    display: flex !important;
    align-items: center !important;
    gap: 0.5rem !important;
    justify-content: flex-start !important;
  }

  .cart-page .qty-btn {
    width: 28px !important;
    height: 28px !important;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f8f8f8;
    border: 1px solid #e5e5e5;
    cursor: pointer;
    transition: all 0.3s;
    flex-shrink: 0;
  }

  .cart-page .qty-btn:hover {
    background: #d4af37;
    border-color: #d4af37;
    color: #fff;
  }

  .cart-page .qty-input {
    width: 45px !important;
    height: 28px !important;
    text-align: center;
    border: 1px solid #e5e5e5;
    font-size: 0.875rem !important;
    font-weight: 600;
    flex-shrink: 0;
  }

  .cart-page .qty-input:focus {
    outline: none;
    border-color: #d4af37;
  }

  .cart-page .cart-item-total {
    font-size: 1rem !important;
    font-weight: 700;
    display: flex;
    align-items: center;
    text-align: right;
  }

  /* ==================== Cart Summary ==================== */
  .cart-summary-section {
    background: #fff;
    border-radius: 4px;
    padding: 2rem;
    position: sticky;
    top: 120px;
  }

  .summary-title {
    font-size: 1.25rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 2rem;
  }

  .summary-rows {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.95rem;
  }

  .summary-total {
    font-size: 1.25rem;
    font-weight: 700;
    padding-top: 1rem;
    border-top: 2px solid #e5e5e5;
    margin-top: 1rem;
  }

  .summary-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .btn {
    padding: 1rem;
    text-align: center;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.3s;
    border: none;
    cursor: pointer;
    display: block;
  }

  .btn-full {
    width: 100%;
  }

  .btn-primary {
    background: #d4af37;
    color: #fff;
  }

  .btn-primary:hover {
    background: #c49d2e;
  }

  .btn-secondary {
    background: #fff;
    color: #d4af37;
    border: 2px solid #d4af37;
  }

  .btn-secondary:hover {
    background: #d4af37;
    color: #fff;
  }

  .shipping-note {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    background: #f8f8f8;
    border-radius: 4px;
    font-size: 0.85rem;
    color: #666;
  }

  .shipping-note svg {
    flex-shrink: 0;
    color: #27ae60;
  }

  /* ==================== Responsive ==================== */
  @media (max-width: 1024px) {
    .cart-grid {
      grid-template-columns: 1fr;
    }

    .cart-summary-section {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .cart-page {
      padding: 6rem 0 4rem;
      overflow-x: hidden;
      width: 100%;
    }

    .cart-container {
      padding: 0 1rem;
      max-width: 100%;
      overflow-x: hidden;
    }

    .cart-page-title {
      font-size: 2rem;
      margin-bottom: 2rem;
    }

    .cart-items-section {
      padding: 1.5rem 1rem;
      overflow-x: hidden;
    }

    .cart-items-header {
      display: none !important;
    }

    .cart-page .cart-item {
      display: flex !important;
      flex-direction: column !important;
      gap: 1rem !important;
      padding: 1.5rem 0 !important;
      grid-template-columns: none !important;
    }

    .cart-page .cart-item-product {
      display: flex !important;
      flex-direction: row !important;
      gap: 1rem !important;
      width: 100%;
    }

    .cart-page .cart-item-image {
      width: 80px !important;
      height: 80px !important;
      flex-shrink: 0 !important;
    }

    .cart-page .cart-item-image img {
      width: 80px !important;
      height: 80px !important;
    }

    .cart-page .cart-item-info {
      flex: 1 !important;
      min-width: 0 !important;
    }

    .cart-page .cart-item-name {
      font-size: 0.85rem !important;
      word-break: break-word !important;
    }

    .cart-page .cart-item-price,
    .cart-page .cart-item-quantity,
    .cart-page .cart-item-total {
      justify-self: start !important;
      width: 100% !important;
    }

    .cart-page .cart-item-price {
      display: flex !important;
      justify-content: space-between !important;
      align-items: center !important;
    }

    .cart-page .cart-item-price::before {
      content: 'Price:';
      font-size: 0.8rem;
      color: #666;
      font-weight: 400;
    }

    .cart-page .cart-item-quantity {
      display: flex !important;
      justify-content: space-between !important;
      align-items: center !important;
    }

    .cart-page .cart-item-quantity::before {
      content: 'Quantity:';
      font-size: 0.8rem;
      color: #666;
      font-weight: 400;
    }

    .cart-page .cart-item-total {
      display: flex !important;
      justify-content: space-between !important;
      align-items: center !important;
      padding-top: 0.75rem !important;
      border-top: 1px solid #e5e5e5 !important;
      font-size: 1.1rem !important;
    }

    .cart-page .cart-item-total::before {
      content: 'Subtotal:';
      font-size: 0.85rem;
      color: #666;
      font-weight: 400;
    }

    .cart-summary-section {
      padding: 1.5rem 1rem;
    }

    .summary-title {
      font-size: 1.1rem;
    }
  }
</style>
