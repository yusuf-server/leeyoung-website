---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export const prerender = false;
---

<BaseLayout title="Reset Password - LEEYOUNG" description="Reset your account password">
  <Header />

  <section class="reset-password-page">
    <div class="reset-container">
      <div class="reset-card">
        <div class="reset-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>

        <h1 class="reset-title">Reset Your Password</h1>
        <p class="reset-subtitle">Enter your email address and we'll send you a link to reset your password.</p>

        <form id="resetForm" class="reset-form">
          <div class="form-group">
            <label for="email">Email Address</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="your@email.com"
              autocomplete="email"
            />
          </div>

          <button type="submit" id="submitBtn" class="submit-btn">
            Send Reset Link
          </button>

          <div id="message" class="message"></div>
        </form>

        <div class="back-to-login">
          <span>Remember your password?</span>
          <a href="/" class="login-link">Back to Login</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  /* Reset any global styles that might interfere */
  * {
    box-sizing: border-box;
  }

  /* Header Override */
  :global(.header) {
    background: #000 !important;
    position: fixed !important;
    z-index: 1000 !important;
  }

  /* Ensure Footer doesn't overlap */
  :global(.footer) {
    position: relative;
    z-index: 1;
  }

  .reset-password-page {
    min-height: 100vh;
    min-height: 100dvh; /* Dynamic viewport height for mobile */
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #000000 0%, #1a1a1a 50%, #000000 100%);
    padding: 100px 2rem 4rem;
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .reset-password-page::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 50%, rgba(212, 175, 55, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 50%, rgba(212, 175, 55, 0.05) 0%, transparent 50%);
    pointer-events: none;
    z-index: 0;
  }

  .reset-container {
    position: relative;
    z-index: 100;
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
  }

  .reset-card {
    background: #ffffff !important;
    backdrop-filter: blur(20px);
    border-radius: 16px;
    padding: 3rem;
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.1);
    position: relative;
    z-index: 100;
    opacity: 1 !important;
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .reset-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 2rem;
    background: linear-gradient(135deg, #d4af37 0%, #f4d03f 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 30px rgba(212, 175, 55, 0.3);
  }

  .reset-icon svg {
    color: #fff;
  }

  .reset-title {
    font-size: 2rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 0.75rem;
    color: #000;
  }

  .reset-subtitle {
    text-align: center;
    color: #666;
    margin-bottom: 2.5rem;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .reset-form {
    margin-bottom: 2rem;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-group label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: #333;
  }

  .form-group input {
    width: 100%;
    padding: 0.875rem 1rem;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: 0.9375rem;
    transition: all 0.2s;
    background: #fff;
  }

  .form-group input:focus {
    outline: none;
    border-color: #d4af37;
    box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.1);
  }

  .submit-btn {
    width: 100%;
    padding: 1rem;
    background: linear-gradient(135deg, #d4af37 0%, #f4d03f 100%);
    color: #000;
    border: none;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
  }

  .submit-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(212, 175, 55, 0.4);
  }

  .submit-btn:active {
    transform: translateY(0);
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .message {
    margin-top: 1rem;
    padding: 0.875rem 1rem;
    border-radius: 8px;
    font-size: 0.875rem;
    display: none;
    animation: fadeIn 0.3s ease-out;
    font-weight: 700;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .message.show {
    display: block;
  }

  .message.success {
    background: #d1fae5;
    color: #065f46;
    border: 2px solid #10b981;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
  }

  .message.error {
    background: #fee2e2;
    color: #991b1b;
    border: 2px solid #ef4444;
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
  }

  .back-to-login {
    text-align: center;
    font-size: 0.875rem;
    color: #666;
  }

  .back-to-login span {
    margin-right: 0.5rem;
  }

  .login-link {
    color: #d4af37;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s;
  }

  .login-link:hover {
    color: #c49d2e;
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .reset-password-page {
      padding: 6rem 1.5rem 2rem;
    }

    .reset-card {
      padding: 2rem 1.5rem;
    }

    .reset-icon {
      width: 64px;
      height: 64px;
    }

    .reset-icon svg {
      width: 32px;
      height: 32px;
    }

    .reset-title {
      font-size: 1.5rem;
    }
  }
</style>

<script>
  import { gsap } from '../lib/gsap';

  const form = document.getElementById('resetForm') as HTMLFormElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const message = document.getElementById('message') as HTMLDivElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const email = (document.getElementById('email') as HTMLInputElement).value;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending...';
    message.classList.remove('show', 'success', 'error');
    message.style.display = 'none';

    try {
      const response = await fetch('/api/auth/reset-password', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ email })
      });

      const data = await response.json();

      if (response.ok) {
        message.textContent = 'Password reset link has been sent to your email. Please check your inbox.';
        message.classList.add('show', 'success');
        message.style.display = 'block';
        message.style.opacity = '1';
        form.reset();

        // Animate message entrance
        gsap.fromTo(message,
          { y: -10, opacity: 0 },
          { y: 0, opacity: 1, duration: 0.3, ease: 'power2.out' }
        );
      } else {
        message.textContent = data.error || 'Failed to send reset link. Please try again.';
        message.classList.add('show', 'error');
        message.style.display = 'block';
        message.style.opacity = '1';

        // Shake animation on error
        gsap.fromTo(message,
          { x: -10 },
          { x: 10, duration: 0.1, repeat: 3, yoyo: true, ease: 'power2.inOut' }
        );
      }
    } catch (error) {
      message.textContent = 'Network error. Please try again later.';
      message.classList.add('show', 'error');
      message.style.display = 'block';
      message.style.opacity = '1';
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send Reset Link';
    }
  });

  // Entrance animations
  gsap.from('.reset-card', {
    opacity: 0,
    y: 30,
    duration: 0.6,
    ease: 'power2.out'
  });
</script>
