---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="About Us - LEEYOUNG"
  description="Learn about LEEYOUNG's history, vision, and commitment to quality in manufacturing industrial equipment."
>
  <Header />

  <!-- Hero Section -->
  <section class="about-hero">
    <div class="hero-image-container">
      <img
        src="https://images.unsplash.com/photo-1565793298595-6a879b1d9492?w=1920&h=800&fit=crop"
        alt="LEEYOUNG Factory"
        class="hero-image"
      />
      <div class="hero-overlay">
        <div class="hero-content">
          <h2 class="hero-subheading">Our Story</h2>
          <h1 class="hero-title">About LEEYOUNG</h1>
          <p class="hero-text">
            LEEYOUNG was founded in <strong>2005</strong> and has been developing high-quality industrial equipment for nearly two decades.
            We combine advanced manufacturing technology with real-world experience to create reliable, professional-grade products.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Image with Text Section 1 -->
  <section class="image-text-section bg-light">
    <div class="section-container">
      <div class="image-text-grid">
        <div class="image-column">
          <img
            src="https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=800&h=600&fit=crop"
            alt="LEEYOUNG Manufacturing"
            class="section-image"
          />
        </div>
        <div class="text-column">
          <div class="text-content">
            <p>
              Behind LEEYOUNG stands a company with <strong>over 18 years</strong> of experience in the industrial equipment manufacturing industry.
              Over the years, we have introduced many innovations and set new standards for quality and reliability.
            </p>
            <p>
              Our brand was created as a result of many years of practice, testing, and constant improvement.
              We develop our products based on real-world feedback and the evolving needs of our customers.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Image with Text Section 2 -->
  <section class="image-text-section bg-gray">
    <div class="section-container">
      <div class="image-text-grid reverse">
        <div class="image-column">
          <img
            src="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?w=800&h=600&fit=crop"
            alt="Quality Control"
            class="section-image"
          />
        </div>
        <div class="text-column">
          <div class="text-content">
            <h3 class="section-subheading">Brand Vision</h3>
            <h2 class="section-title">Our Quality</h2>
            <p>
              <strong>Every product is carefully manufactured and tested.</strong>
              We don't cut corners. Each piece of equipment goes through rigorous quality control to ensure it meets our high standards.
            </p>
            <p>
              We choose materials with care. Each product is a balanced system - reliable components, strong construction,
              and engineering that prioritizes both performance and durability.
              We don't follow trends. <strong>We build equipment for real work.</strong>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Image with Text Section 3 -->
  <section class="image-text-section bg-light">
    <div class="section-container">
      <div class="image-text-grid">
        <div class="image-column">
          <img
            src="https://images.unsplash.com/photo-1487058792275-0ad4aaf24ca7?w=800&h=600&fit=crop"
            alt="Innovation"
            class="section-image"
          />
        </div>
        <div class="text-column">
          <div class="text-content">
            <h3 class="section-subheading">Innovation</h3>
            <h2 class="section-title">Continuous Improvement</h2>
            <p>
              We invest heavily in research and development to stay at the forefront of industrial technology.
              Our engineering team constantly explores new materials, designs, and manufacturing processes.
            </p>
            <p>
              Innovation isn't just about new features - it's about making products that work better, last longer,
              and provide genuine value to our customers. Every improvement we make is tested in real-world conditions.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Image with Text Section 4 -->
  <section class="image-text-section bg-gray">
    <div class="section-container">
      <div class="image-text-grid reverse">
        <div class="image-column">
          <img
            src="https://images.unsplash.com/photo-1556761175-4b46a572b786?w=800&h=600&fit=crop"
            alt="Customer Service"
            class="section-image"
          />
        </div>
        <div class="text-column">
          <div class="text-content">
            <h3 class="section-subheading">Customer First</h3>
            <h2 class="section-title">Our Commitment</h2>
            <p>
              We're not just manufacturers - we're partners in your success.
              Our customer service team is always ready to provide support, answer questions, and help you get the most from our products.
            </p>
            <p>
              From initial consultation to after-sales service, we're committed to providing an exceptional experience.
              Your satisfaction is our priority, and we stand behind every product we make.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="values-section">
    <div class="section-container">
      <div class="section-header">
        <h3 class="section-subheading">What We Stand For</h3>
        <h2 class="section-title">Our Core Values</h2>
      </div>
      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <h3 class="value-title">Quality First</h3>
          <p class="value-description">
            We never compromise on quality. Every product meets our strict standards before it reaches you.
          </p>
        </div>

        <div class="value-card">
          <div class="value-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
            </svg>
          </div>
          <h3 class="value-title">Innovation</h3>
          <p class="value-description">
            Continuous improvement drives us forward. We're always looking for better ways to serve you.
          </p>
        </div>

        <div class="value-card">
          <div class="value-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <h3 class="value-title">Customer Focus</h3>
          <p class="value-description">
            Your success is our success. We're here to support you every step of the way.
          </p>
        </div>

        <div class="value-card">
          <div class="value-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <h3 class="value-title">Reliability</h3>
          <p class="value-description">
            Our products are built to last. We stand behind everything we make with comprehensive warranties.
          </p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  /* Hero Section */
  .about-hero {
    width: 100%;
    position: relative;
    margin-top: 80px;
  }

  .hero-image-container {
    position: relative;
    width: 100%;
    height: 600px;
    overflow: hidden;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to right, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0.3) 100%);
    display: flex;
    align-items: center;
  }

  .hero-content {
    max-width: 1800px;
    margin: 0 auto;
    padding: 0 2rem;
    width: 100%;
    color: #fff;
    max-width: 600px;
  }

  .hero-subheading {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
    font-weight: 400;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  .hero-text {
    font-size: 1.1rem;
    line-height: 1.7;
    opacity: 0.95;
  }

  /* Image with Text Sections */
  .image-text-section {
    padding: 80px 0;
  }

  .bg-light {
    background: #f7f7f7;
  }

  .bg-gray {
    background: #e6e6e6;
  }

  .section-container {
    max-width: 1800px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .image-text-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .image-text-grid.reverse {
    direction: rtl;
  }

  .image-text-grid.reverse > * {
    direction: ltr;
  }

  .image-column {
    width: 100%;
  }

  .section-image {
    width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
  }

  .text-column {
    padding: 2rem 0;
  }

  .text-content {
    max-width: 600px;
  }

  .section-subheading {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #666;
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .section-title {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: #000;
    line-height: 1.2;
  }

  .text-content p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #333;
    margin-bottom: 1.5rem;
  }

  .text-content p:last-child {
    margin-bottom: 0;
  }

  /* Values Section */
  .values-section {
    padding: 100px 0;
    background: #fff;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3rem;
  }

  .value-card {
    text-align: center;
  }

  .value-icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 1.5rem;
    color: #000;
  }

  .value-icon svg {
    width: 100%;
    height: 100%;
  }

  .value-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: #000;
  }

  .value-description {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #666;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero-title {
      font-size: 2.5rem;
    }

    .image-text-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .image-text-grid.reverse {
      direction: ltr;
    }

    .section-title {
      font-size: 2rem;
    }

    .values-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .about-hero {
      margin-top: 60px;
    }

    .hero-image-container {
      height: 500px;
    }

    .hero-content {
      padding: 0 1.5rem;
    }

    .hero-title {
      font-size: 2rem;
    }

    .hero-text {
      font-size: 1rem;
    }

    .image-text-section {
      padding: 60px 0;
    }

    .section-container {
      padding: 0 1.5rem;
    }

    .section-title {
      font-size: 1.75rem;
    }

    .text-content p {
      font-size: 1rem;
    }

    .values-section {
      padding: 60px 0;
    }

    .values-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
