        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <div class="lightbox-counter" data-lightbox-counter>1 / 1</div>
    </div>
  </div>

  <!-- Sticky Add to Cart Bar -->
  <div class="sticky-cart-bar" data-sticky-cart>
    <div class="sticky-cart-container">
      <div class="sticky-cart-product">
        <div class="sticky-cart-image">
          <img src={product.images[0]?.src || '/placeholder.jpg'} alt={product.name} />
        </div>
        <div class="sticky-cart-info">
          <h3 class="sticky-cart-title">{product.name}</h3>
          <p class="sticky-cart-price" data-sticky-price>${product.price}</p>
          <p class="sticky-cart-color" data-sticky-color-name style="display: none;">
            <span class="color-label">Color:</span>
            <span class="color-value"></span>
          </p>
        </div>
      </div>

      {/* 变体选择（如果是可变产品） */}
      {product.type === 'variable' && product.attributes && product.attributes.length > 0 && (
        <div class="sticky-variations" data-sticky-variations>
          {product.attributes
            .filter(attr => attr.variation)
            .map((attribute) => {
              const isColorAttribute = attribute.name.toLowerCase().includes('color') || attribute.name.toLowerCase().includes('colour');

              return (
                <div class="sticky-variation-group">
                  <div class={`sticky-variation-options ${isColorAttribute ? 'sticky-variation-colors' : ''}`}>
                    {attribute.options.map((option) => (
                      isColorAttribute ? (
                        <button
                          class="sticky-variation-color"
                          data-sticky-attribute={attribute.name}
                          data-sticky-value={option}
                          data-sticky-color-name={option}
                          type="button"
                          title={option}
                        >
                        </button>
                      ) : (
                        <button
                          class="sticky-variation-option"
                          data-sticky-attribute={attribute.name}
                          data-sticky-value={option}
                          type="button"
                        >
                          {option}
                        </button>
                      )
                    ))}
                  </div>
                </div>
              );
            })}
        </div>
