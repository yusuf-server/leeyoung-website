  .gallery-swiper {
    width: 100%;
    padding-bottom: 4rem;
    overflow: visible !important;
  }

  .gallery-swiper .swiper-wrapper {
    padding-left: 0;
    padding-right: 0;
  }

  .gallery-swiper .swiper-slide {
    width: auto;
    height: auto;
  }

  .gallery-slide-link {
    display: block;
    position: relative;
    cursor: pointer;
    width: 450px;
    height: 320px;
  }

  .gallery-image-container {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #111;
    transform: translateZ(0);
    backface-visibility: hidden;
    position: relative;
    border-radius: 12px;
  }

  .gallery-image-container:hover .gallery-zoom-icon {
    opacity: 1;
  }

  .gallery-zoom-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    background: rgba(0, 0, 0, 0.7);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  .gallery-zoom-icon svg {
    color: #fff;
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: translateZ(0);
    backface-visibility: hidden;
    will-change: transform;
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
    transition: transform 0.3s;
  }

  .gallery-slide-link:hover .gallery-image {
    transform: scale(1.05);
  }

  .gallery-swiper .swiper-button-prev,
  .gallery-swiper .swiper-button-next {
    width: 60px;
    height: 60px;
    background: #fff;
    border-radius: 50%;
    color: #000;
    transition: all 0.3s;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }

  .gallery-swiper .swiper-button-prev {
    left: 2rem;
  }

  .gallery-swiper .swiper-button-next {
    right: 2rem;
  }

  .gallery-swiper .swiper-button-prev:hover,
  .gallery-swiper .swiper-button-next:hover {
    background: #fff;
    box-shadow: 0 6px 25px rgba(0, 0, 0, 0.6);
    transform: scale(1.08);
  }

  .gallery-swiper .swiper-button-prev::after,
  .gallery-swiper .swiper-button-next::after {
    font-size: 22px;
    font-weight: 900;
  }

  .gallery-pagination {
    bottom: 0 !important;
  }

  .gallery-pagination :global(.swiper-pagination-bullet) {
    width: 8px;
    height: 8px;
    background: rgba(255, 255, 255, 0.3);
    opacity: 1;
    transition: all 0.3s;
  }

  .gallery-pagination :global(.swiper-pagination-bullet-active) {
    background: #fff;
    width: 24px;
    border-radius: 4px;
  }

  /* ==================== Lightbox Modal ==================== */
  .lightbox-modal {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(10px);
  }

  .lightbox-modal.active {
    display: flex;
  }

  .lightbox-overlay {
    position: absolute;
    inset: 0;
    cursor: zoom-out;
  }

  .lightbox-content {
    position: relative;
    z-index: 1;
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
  }

  .lightbox-content img {
    max-width: 100%;
    max-height: 85vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  .lightbox-counter {
    margin-top: 1rem;
    color: #fff;
    font-size: 0.875rem;
    opacity: 0.8;
  }

  .lightbox-close,
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    z-index: 2;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: #fff;
    cursor: pointer;
    border-radius: 50%;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s;
    backdrop-filter: blur(10px);
  }

  .lightbox-close:hover,
  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
  }

  .lightbox-close {
    top: 2rem;
    right: 2rem;
  }

  .lightbox-prev {
    left: 2rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-prev:hover {
    transform: translateY(-50%) scale(1.1);
  }

  .lightbox-next {
    right: 2rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-next:hover {
    transform: translateY(-50%) scale(1.1);
  }

  /* ==================== Technical Specification ==================== */
  .specification-section {
