          <label for="review-media">Add Photos or Videos (Optional)</label>
          <input type="file" id="review-media" name="media" accept="image/*,video/*" multiple data-media-input />
          <div class="media-preview" data-media-preview></div>
          <p class="form-hint">You can upload up to 5 images (max 10MB each) or videos (max 50MB each)</p>
        </div>

        <div class="form-actions">
          <button type="button" class="btn-cancel" data-close-review-modal>Cancel</button>
          <button type="submit" class="btn-submit">Submit Review</button>
