    background: rgba(0, 0, 0, 0.95);
    z-index: 10000;
    align-items: center;
    justify-content: center;
  }

  .lightbox.active {
    display: flex;
  }

  .lightbox-content {
    position: relative;
    width: 90%;
    max-width: 1200px;
    height: 80%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-image {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .lightbox-close {
    position: absolute;
    top: -3rem;
    right: 0;
    width: 40px;
    height: 40px;
    background: transparent;
    border: none;
    cursor: pointer;
    color: #fff;
    font-size: 2rem;
    line-height: 1;
    padding: 0;
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.2);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s;
  }

  .lightbox-nav:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .lightbox-nav svg {
    width: 24px;
    height: 24px;
    stroke: #fff;
  }

  .lightbox-prev {
    left: 1rem;
  }

  .lightbox-next {
    right: 1rem;
  }

  .lightbox-counter {
    position: absolute;
    bottom: -3rem;
    left: 50%;
    transform: translateX(-50%);
    color: #fff;
    font-size: 0.9rem;
  }

  .product-badge-sale {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    background: #e74c3c;
    color: #fff;
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    z-index: 2;
  }

  .product-badge-featured {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    background: #000;
    color: #fff;
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    z-index: 2;
  }

  /* 图片指示器 (默认隐藏，仅手机端显示) */
  .gallery-indicator {
    display: none;
    position: absolute;
    bottom: 0rem;
    left: 1rem;
    right: 1rem;
    z-index: 3;
  }

  .gallery-counter {
    background: rgba(255, 255, 255, 0.95);
    color: #000;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.4rem 0.8rem;
    border-radius: 4px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .gallery-progress-bar {
    width: 100%;
    height: 4px;
    background: #e0e0e0;
    overflow: hidden;
    position: relative;
    border-radius: 2px;
  }

  .gallery-progress-fill {
    height: 100%;
    background: #000;
    transition: width 0.3s ease;
    position: absolute;
    left: 0;
    top: 0;
  }

  /* ==================== Product Info ==================== */
  .product-info {
    background: #fff;
    padding: 1.75rem;
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
    border-radius: 4px;
  }

  /* Product Badges */
  .product-badges {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .badge {
    display: inline-block;
    padding: 0.35rem 0.7rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
  }

  .badge-sale {
    background: #e74c3c;
  }

  .badge-featured {
    background: #353535;
  }

  .product-title {
    font-size: clamp(1.1rem, 3vw, 1.25rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin-bottom: 0.65rem;
    line-height: 1.1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* 品牌金标徽章 */
  .brand-badge {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem 0.75rem;
    background: linear-gradient(135deg, #FFD700 0%, #FFA500 50%, #FFD700 100%);
    border-radius: 20px;
    box-shadow:
      0 2px 8px rgba(255, 215, 0, 0.4),
      0 0 0 2px rgba(255, 215, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.5);
    overflow: hidden;
    animation: float 3s ease-in-out infinite;
  }

  .badge-text {
    font-size: 0.65rem;
    font-weight: 900;
    color: #fff;
    letter-spacing: 0.08em;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
    position: relative;
    z-index: 2;
    white-space: nowrap;
  }

  /* 闪光扫过效果 */
  .badge-shine {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.8) 50%,
      rgba(255, 255, 255, 0) 100%
    );
    transform: rotate(45deg);
    animation: shine 3s ease-in-out infinite;
  }

  /* 悬浮漂浮动画 */
  @keyframes float {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    25% {
      transform: translateY(-3px) rotate(2deg);
    }
    50% {
      transform: translateY(0px) rotate(0deg);
    }
    75% {
      transform: translateY(-3px) rotate(-2deg);
    }
  }

  /* 闪光扫过动画 */
  @keyframes shine {
    0% {
      transform: translateX(-100%) rotate(45deg);
    }
    20%, 100% {
      transform: translateX(200%) rotate(45deg);
    }
  }

  /* Hover 效果 */
  .brand-badge:hover {
    animation: float 3s ease-in-out infinite, pulse 0.6s ease-in-out;
    box-shadow:
      0 4px 16px rgba(255, 215, 0, 0.6),
      0 0 0 3px rgba(255, 215, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  @keyframes pulse {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
  }

  /* 移动端调整 */
  @media (max-width: 768px) {
    .brand-badge {
      padding: 0.3rem 0.65rem;
    }

    .badge-text {
      font-size: 0.6rem;
    }
  }

  .product-price-section {
    margin-bottom: 0.85rem;
  }

  .price-wrapper {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .price-sale {
    font-size: 1.35rem;
    font-weight: 700;
    color: #e74c3c;
  }

  .price-regular {
    font-size: 1rem;
    font-weight: 400;
    color: #999;
    text-decoration: line-through;
  }

  .price-current {
    font-size: 1.35rem;
    font-weight: 700;
    color: #000;
  }

  .product-rating {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }

  .rating-stars {
    display: flex;
    gap: 0.2rem;
    color: #f39c12;
  }

  .rating-stars svg {
    width: 14px;
    height: 14px;
  }

  .rating-count {
    font-size: 0.8rem;
    color: #666;
  }

  /* Product Features */
  .product-features {
    margin-bottom: 1.5rem;
  }

  .features-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    position: relative;
  }

  .features-grid.collapsed .feature-item:nth-child(n+6) {
    display: none !important;
  }

  .features-grid.collapsed .features-toggle {
    display: inline-flex !important;
  }

  /* 3D Model Badge - Only show if model exists */
  .feature-3d-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1.1rem;
    background: linear-gradient(-45deg, #ee7752, #e73c7e, #23a6d5, #23d5ab);
    background-size: 400% 400%;
    animation: gradientShift 8s ease infinite;
    border: none;
    border-radius: 50px;
    color: #fff;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 2px 12px rgba(231, 60, 126, 0.3);
    white-space: nowrap;
    order: -1;
  }

  @keyframes gradientShift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  .feature-3d-badge:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 4px 20px rgba(231, 60, 126, 0.5);
  }

  .badge-icon {
    flex-shrink: 0;
    animation: rotate3d 3s ease-in-out infinite;
  }

  @keyframes rotate3d {
    0%, 100% { transform: rotateY(0deg); }
    50% { transform: rotateY(180deg); }
  }

  .badge-text {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .badge-arrow {
    flex-shrink: 0;
    animation: bounce 2s ease-in-out infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(3px); }
  }

  .feature-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 50px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: default;
    white-space: nowrap;
  }

  .feature-item:hover {
    background: #f9f9f9;
    border-color: #000;
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .feature-check {
    flex-shrink: 0;
    color: #4caf50;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .feature-item:hover .feature-check {
    transform: scale(1.2);
  }

  .feature-text {
    font-size: 0.75rem;
    font-weight: 500;
    color: #333;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }

  .features-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 1rem;
    background: #fff;
    border: 1px dashed #999;
    border-radius: 50px;
    font-size: 0.7rem;
    font-weight: 600;
    color: #666;
    cursor: pointer;
    transition: all 0.3s;
    white-space: nowrap;
  }

  .features-toggle:hover {
    background: #f9f9f9;
    border-color: #000;
    color: #000;
  }

  .features-toggle svg {
    transition: transform 0.3s;
  }

  .features-grid:not(.collapsed) .features-toggle svg {
    transform: rotate(180deg);
  }

  .product-separator {
    border: none;
    border-top: 1px solid #e5e5e5;
    margin: 1rem 0;
  }

  .product-stock {
    margin-bottom: 0.85rem;
  }

  .stock-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Product Variations */
  .product-variations {
    margin-bottom: 1.5rem;
  }

  .variation-group {
    margin-bottom: 1.25rem;
  }

  .variation-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: #333;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .variation-label .selected-value {
    font-weight: 700;
    color: #d4af37;
    margin-left: 0.5rem;
  }

  .variation-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* 颜色选项 - 圆形色卡 */
  .variation-colors {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.5rem;
    margin: -0.5rem;
  }

  /* 桌面端：单行显示，横向滚动 */
  @media (min-width: 769px) {
    .variation-colors {
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      /* 自定义滚动条样式 */
      scrollbar-width: thin;
      scrollbar-color: #d4af37 #f0f0f0;
    }

    .variation-colors::-webkit-scrollbar {
      height: 6px;
    }

    .variation-colors::-webkit-scrollbar-track {
      background: #f0f0f0;
      border-radius: 3px;
    }

    .variation-colors::-webkit-scrollbar-thumb {
      background: #d4af37;
      border-radius: 3px;
    }

    .variation-colors::-webkit-scrollbar-thumb:hover {
      background: #b8941f;
    }
  }

  /* 移动端：自动换行，最多显示每行合适的数量 */
  @media (max-width: 768px) {
    .variation-colors {
      flex-wrap: wrap;
      gap: 0.5rem;
      max-width: 100%;
    }
  }

  .variation-color {
    position: relative;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 3px solid #e5e5e5;
    cursor: pointer;
    transition: all 0.3s;
    flex-shrink: 0;
    padding: 0;
    overflow: hidden;
  }

  /* 移动端：稍微减小尺寸以适配更多 */
  @media (max-width: 768px) {
    .variation-color {
      width: 40px;
      height: 40px;
      border-width: 2px;
    }
  }

  @media (max-width: 480px) {
    .variation-color {
      width: 36px;
      height: 36px;
    }
  }

  .variation-color:hover {
    border-color: #d4af37;
  }

  .variation-color.selected {
    border-color: #d4af37;
    box-shadow: 0 0 0 2px #fff, 0 0 0 4px #d4af37;
  }

  @media (max-width: 768px) {
    .variation-color.selected {
      box-shadow: 0 0 0 1px #fff, 0 0 0 3px #d4af37;
    }
  }

  .variation-color:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .variation-color .color-name {
    position: absolute;
    bottom: -25px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.65rem;
    color: #666;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .variation-color:hover .color-name,
  .variation-color.selected .color-name {
    opacity: 1;
  }

  /* 移动端：隐藏 hover 提示，避免占用空间 */
  @media (max-width: 768px) {
    .variation-color .color-name {
      display: none;
    }
  }

  /* 普通选项（尺寸等） */
  .variation-option {
    padding: 0.65rem 1.25rem;
    background: #fff;
    border: 2px solid #e5e5e5;
    color: #666;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.3s;
  }

  .variation-option:hover {
    border-color: #d4af37;
    color: #d4af37;
  }

  .variation-option.selected {
    background: #d4af37;
    border-color: #d4af37;
    color: #fff;
  }

  .variation-option:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    text-decoration: line-through;
  }

  .stock-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .stock-status svg {
    width: 13px;
    height: 13px;
  }

  .stock-status.in-stock {
    color: #27ae60;
  }

  .stock-status.out-of-stock {
    color: #e74c3c;
  }

  /* Product Info Icons */
  .product-info-icons {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }

  .info-icon-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .info-icon-item svg {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: #000;
  }

  .info-icon-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .info-icon-text strong {
    font-size: 0.8rem;
    font-weight: 600;
    color: #000;
  }

  .info-icon-text span {
    font-size: 0.75rem;
    color: #666;
  }

  .payment-icon-item {
    display: block !important;
  }

  .payment-icon-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .payment-icon-content strong {
    font-size: 0.8rem;
    font-weight: 600;
    color: #000;
  }

  .payment-icons-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .payment-icons-group img {
    height: 20px;
    width: auto;
    object-fit: contain;
  }

  /* ==================== Product Actions ==================== */
  .product-actions {
    display: flex;
    gap: 0.65rem;
    margin-bottom: 1rem;
  }

  .quantity-selector {
    display: flex;
    align-items: center;
    border: 1px solid #e5e5e5;
    background: #fff;
  }

  .qty-btn {
    width: 36px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    cursor: pointer;
    transition: background 0.3s;
  }

  .qty-btn:hover {
    background: #f8f8f8;
  }

  .qty-btn svg {
    width: 13px;
    height: 13px;
  }

  .qty-input {
    width: 45px;
    height: 44px;
    text-align: center;
    border: none;
    border-left: 1px solid #e5e5e5;
    border-right: 1px solid #e5e5e5;
    font-size: 0.9rem;
    font-weight: 600;
    -moz-appearance: textfield;
  }

  .qty-input::-webkit-inner-spin-button,
  .qty-input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .qty-input:focus {
    outline: none;
  }

  .add-to-cart-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.65rem 1.25rem;
    background: #d4af37;
    color: #fff;
    border: none;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.3s;
  }

  .add-to-cart-btn svg {
    width: 16px;
    height: 16px;
  }

  .add-to-cart-btn:hover {
    background: #c49d2e;
    transform: translateX(5px);
  }

  /* ==================== Product Meta ==================== */
  .product-meta {
    padding-top: 1rem;
    border-top: 1px solid #e5e5e5;
  }

  .meta-item {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 0.45rem;
    font-size: 0.8rem;
  }

  .meta-label {
    font-weight: 600;
    color: #333;
  }

  .meta-value {
    color: #666;
  }

  .meta-value a {
    color: #666;
    text-decoration: none;
    transition: color 0.3s;
  }

  .meta-value a:hover {
    color: #000;
  }

  /* ==================== Product Description Custom ==================== */
  .product-description-custom {
    background: #fff;
    padding: 5rem 0;
  }

  .description-wrapper {
    max-width: 1800px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
    align-items: start;
  }

  .description-heading {
    position: sticky;
    top: 120px;
  }

  .description-subheading {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #999;
    margin-bottom: 1rem;
  }

  .description-title {
    font-size: 2.5rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0;
  }

  .description-text {
    font-size: 1rem;
    line-height: 1.8;
    color: #333;
  }

  .description-text p {
    margin-bottom: 1.5rem;
  }

  /* Usage Types */
  .usage-types {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 3rem;
  }

  .usage-type-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.5rem;
    background: #f8f8f8;
    border-radius: 8px;
  }

  .usage-type-content {
    flex: 1;
  }

  .usage-type-label {
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #666;
    margin-bottom: 0.75rem;
  }

  .usage-type-scale {
    display: flex;
    gap: 0.5rem;
  }

  .usage-scale-block {
    width: 40px;
    height: 12px;
    background: #e5e5e5;
    border-radius: 2px;
    transition: background 0.3s;
  }

  .usage-scale-block-full {
    background: #000;
  }

  .usage-type-icon {
    flex-shrink: 0;
