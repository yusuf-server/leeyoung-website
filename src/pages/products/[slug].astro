            class="sticky-qty-input"
            value="1"
            min="1"
            max="99"
            data-sticky-qty-input
          />
          <button class="sticky-qty-btn sticky-qty-increase" data-sticky-qty="increase">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </button>
        </div>

        <button class="sticky-add-to-cart-btn" data-sticky-add-cart data-product-id={product.id}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="9" cy="21" r="1"/>
            <circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          <span>ADD TO CART</span>
        </button>
      </div>
    </div>
  </div>

  <AdvantagesBar />

  <Footer />
</BaseLayout>

<script>
  import { gsap } from '../../lib/gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { showError, showWarning } from '../../lib/alert';

  // ==================== Breadcrumbs Animation ====================
  gsap.from('[data-product="breadcrumbs"] li', {
    opacity: 0,
    x: -20,
    stagger: 0.1,
    duration: 0.6,
    ease: 'power2.out',
  });

  // ==================== Gallery Animation ====================
  gsap.from('.gallery-main', {
    scrollTrigger: {
      trigger: '.product-section',
      start: 'top 80%',
    },
    opacity: 0,
    scale: 0.95,
    duration: 0.8,
    ease: 'power2.out',
  });

  gsap.from('.thumbnail-item', {
    scrollTrigger: {
      trigger: '.product-section',
      start: 'top 80%',
    },
    opacity: 0,
    y: 20,
    stagger: 0.1,
    duration: 0.6,
    ease: 'power2.out',
    clearProps: 'all', // 动画完成后清除所有GSAP属性
  });

  // ==================== Product Info Animation ====================
  gsap.from('[data-product="title"]', {
    scrollTrigger: {
      trigger: '.product-section',
      start: 'top 80%',
    },
    opacity: 0,
    y: 30,
    duration: 0.8,
    ease: 'power2.out',
  });

  gsap.from('[data-product="price"]', {
    scrollTrigger: {
      trigger: '.product-section',
      start: 'top 80%',
    },
    opacity: 0,
    y: 20,
    duration: 0.6,
    delay: 0.2,
    ease: 'power2.out',
  });

  gsap.from('[data-product="short-desc"]', {
    scrollTrigger: {
      trigger: '.product-section',
      start: 'top 80%',
    },
    opacity: 0,
    y: 20,
    duration: 0.6,
    delay: 0.3,
    ease: 'power2.out',
  });

  // ==================== Gallery Thumbnail Switcher ====================
  const mainImage = document.querySelector('[data-main-image]') as HTMLImageElement;
  const thumbnails = document.querySelectorAll('[data-thumbnail]');
  const currentIndexEl = document.querySelector('.current-index');
  const progressFill = document.querySelector('.gallery-progress-fill') as HTMLElement;
  const totalImages = thumbnails.length;
  const zoomImage = document.querySelector('[data-zoom-image]') as HTMLImageElement;
  const galleryMainEl = document.querySelector('.gallery-main') as HTMLElement;
  const zoomPreview = document.querySelector('[data-zoom-preview]') as HTMLElement;

  // 更新图片指示器
  function updateGalleryIndicator(index: number) {
    if (currentIndexEl) {
      currentIndexEl.textContent = (index + 1).toString();
    }
    if (progressFill && totalImages > 0) {
      const percentage = ((index + 1) / totalImages) * 100;
      progressFill.style.width = `${percentage}%`;
    }
  }

  // 初始化进度条
  if (totalImages > 0) {
    updateGalleryIndicator(0);
  }

  // ==================== Touch Swipe for Gallery (Mobile) ====================
  let currentImageIndex = 0;
  const galleryMain = document.querySelector('.gallery-main') as HTMLElement;

  if (galleryMain && thumbnails.length > 1) {
    let touchStartX = 0;
    let touchEndX = 0;
    let isSwiping = false;

    galleryMain.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      isSwiping = true;
      stopAutoSlide(); // 触摸时暂停自动轮播
    }, { passive: true });

    galleryMain.addEventListener('touchmove', (e) => {
      if (!isSwiping) return;
      touchEndX = e.changedTouches[0].screenX;
    }, { passive: true });

    galleryMain.addEventListener('touchend', () => {
      if (!isSwiping) return;
      isSwiping = false;

      const swipeThreshold = 50; // 最小滑动距离
      const swipeDistance = touchStartX - touchEndX;

      if (Math.abs(swipeDistance) > swipeThreshold) {
        if (swipeDistance > 0 && currentImageIndex < thumbnails.length - 1) {
          // 向左滑动 - 下一张
          switchToImage(currentImageIndex + 1);
        } else if (swipeDistance < 0 && currentImageIndex > 0) {
          // 向右滑动 - 上一张
          switchToImage(currentImageIndex - 1);
        }
      }

      touchStartX = 0;
      touchEndX = 0;
      startAutoSlide(); // 滑动结束后恢复自动轮播
    });
  }

  // ==================== Auto Slide Gallery ====================
  let autoSlideInterval: number | null = null;
  const autoSlideDelay = 4000; // 4秒切换一次

  function switchToImage(index: number) {
    if (index < 0 || index >= thumbnails.length || !mainImage) return;

    const targetThumbnail = thumbnails[index] as HTMLElement;
    const targetImg = targetThumbnail.querySelector('img') as HTMLImageElement;

    if (targetImg) {
      // 获取大图 URL（从缩略图转换）
      const newImageSrc = targetImg.src.replace('-300x300', '-1024x1024');

      // 预加载新图片
      const tempImg = new Image();
      tempImg.onload = () => {
        // 图片加载完成后再切换
        gsap.to(mainImage, {
          opacity: 0,
          duration: 0.3,
          onComplete: () => {
            mainImage.src = newImageSrc;
            // 同步更新放大预览图片
            if (zoomImage) {
              zoomImage.src = newImageSrc;
            }
            gsap.to(mainImage, { opacity: 1, duration: 0.3 });
          }
        });
      };

      tempImg.onerror = () => {
        // 加载失败，直接切换
        gsap.to(mainImage, {
          opacity: 0,
          duration: 0.3,
          onComplete: () => {
            mainImage.src = newImageSrc;
            if (zoomImage) {
              zoomImage.src = newImageSrc;
            }
            gsap.to(mainImage, { opacity: 1, duration: 0.3 });
          }
        });
      };

      // 开始预加载
      tempImg.src = newImageSrc;

      // Update active state
      thumbnails.forEach(t => t.classList.remove('active'));
      targetThumbnail.classList.add('active');

      // Update gallery indicator
      updateGalleryIndicator(index);

      currentImageIndex = index;

      // 预加载下一张图片（优化滚动体验）
      if (index + 1 < thumbnails.length) {
        const nextThumb = thumbnails[index + 1] as HTMLElement;
        const nextImg = nextThumb.querySelector('img') as HTMLImageElement;
        if (nextImg) {
          const nextSrc = nextImg.src.replace('-300x300', '-1024x1024');
          const preloadImg = new Image();
          preloadImg.src = nextSrc;
        }
      }
    }
  }

  function startAutoSlide() {
    if (thumbnails.length <= 1) return;

    autoSlideInterval = window.setInterval(() => {
      const nextIndex = (currentImageIndex + 1) % thumbnails.length;
      switchToImage(nextIndex);
    }, autoSlideDelay);
  }

  function stopAutoSlide() {
    if (autoSlideInterval) {
      clearInterval(autoSlideInterval);
      autoSlideInterval = null;
    }
  }

  // 启动自动轮播
  if (thumbnails.length > 1) {
    // 预加载前 3 张图片（优化移动端体验）
    Array.from(thumbnails).slice(0, 3).forEach(thumb => {
      const img = (thumb as HTMLElement).querySelector('img') as HTMLImageElement;
      if (img) {
        const largeSrc = img.src.replace('-300x300', '-1024x1024');
        const preloadImg = new Image();
        preloadImg.src = largeSrc;
      }
    });

    startAutoSlide();

    // 用户手动切换时，重置定时器
    thumbnails.forEach((thumbnail, index) => {
      thumbnail.addEventListener('click', () => {
        stopAutoSlide();
        switchToImage(index);
        startAutoSlide();
      });
    });

    // 桌面端箭头按钮切换
    const galleryPrevBtn = document.querySelector('[data-gallery-prev]');
    const galleryNextBtn = document.querySelector('[data-gallery-next]');

    if (galleryPrevBtn) {
      galleryPrevBtn.addEventListener('click', () => {
        stopAutoSlide();
        const prevIndex = currentImageIndex > 0 ? currentImageIndex - 1 : thumbnails.length - 1;
        switchToImage(prevIndex);
        startAutoSlide();
      });
    }

    if (galleryNextBtn) {
      galleryNextBtn.addEventListener('click', () => {
        stopAutoSlide();
        const nextIndex = (currentImageIndex + 1) % thumbnails.length;
        switchToImage(nextIndex);
        startAutoSlide();
      });
    }
  }

  // ==================== Quantity Selector ====================
  const qtyInput = document.querySelector('[data-qty-input]') as HTMLInputElement;
  const qtyDecrease = document.querySelector('[data-qty="decrease"]');
  const qtyIncrease = document.querySelector('[data-qty="increase"]');

  if (qtyDecrease && qtyInput) {
    qtyDecrease.addEventListener('click', () => {
      const currentValue = parseInt(qtyInput.value) || 1;
      if (currentValue > 1) {
        qtyInput.value = (currentValue - 1).toString();
        gsap.from(qtyInput, { scale: 1.2, duration: 0.2, ease: 'back.out(2)' });
      }
    });
  }

  if (qtyIncrease && qtyInput) {
    qtyIncrease.addEventListener('click', () => {
      const currentValue = parseInt(qtyInput.value) || 1;
      const maxValue = parseInt(qtyInput.max) || 99;
      if (currentValue < maxValue) {
        qtyInput.value = (currentValue + 1).toString();
        gsap.from(qtyInput, { scale: 1.2, duration: 0.2, ease: 'back.out(2)' });
      }
    });
  }

  // ==================== Add to Cart ====================
  import { CartManager } from '../../lib/cart-manager';
  import analytics from '../../lib/analytics';

  // ==================== Product Variations ====================
  const variationsContainer = document.querySelector('.product-variations');
  let selectedVariation = null;
  let selectedAttributes = {};

  if (variationsContainer) {
    const variations = JSON.parse(variationsContainer.getAttribute('data-variations') || '[]');
    const variationOptions = document.querySelectorAll('.variation-option, .variation-color');

    // 获取所有必需的属性
    const requiredAttributes = new Set();
    document.querySelectorAll('.variation-group').forEach(group => {
      const firstOption = group.querySelector('[data-attribute]');
      if (firstOption) {
        requiredAttributes.add(firstOption.getAttribute('data-attribute'));
      }
    });

    // 检查是否选择了所有必需的属性
    function checkAllAttributesSelected() {
      for (const attr of requiredAttributes) {
        if (!selectedAttributes[attr]) {
          return false;
        }
      }
      return true;
    }

    // 更新加购按钮状态
    function updateAddToCartButtonState() {
      const mainBtn = document.querySelector('.add-to-cart-btn');
      const stickyBtn = document.querySelector('.sticky-add-to-cart-btn');
      const allSelected = checkAllAttributesSelected();

      if (mainBtn) {
        mainBtn.disabled = !allSelected;
        if (!allSelected) {
          mainBtn.style.opacity = '0.5';
          mainBtn.style.cursor = 'not-allowed';
        } else {
          mainBtn.style.opacity = '1';
          mainBtn.style.cursor = 'pointer';
        }
      }

      if (stickyBtn) {
        stickyBtn.disabled = !allSelected;
        if (!allSelected) {
          stickyBtn.style.opacity = '0.5';
          stickyBtn.style.cursor = 'not-allowed';
        } else {
          stickyBtn.style.opacity = '1';
          stickyBtn.style.cursor = 'pointer';
        }
      }
    }

    // 初始禁用按钮（如果是可变产品）
    if (requiredAttributes.size > 0) {
      updateAddToCartButtonState();
    }

    // 为颜色选项设置背景色（从 meta 数据中读取）
    const colorOptions = document.querySelectorAll('.variation-color');
    colorOptions.forEach(option => {
      const colorName = option.getAttribute('data-color-name');

      // 尝试从产品 meta 数据中获取颜色映射
      // 格式: color_mapping = {"Black": "#000000", "White": "#FFFFFF", "Pattern": "https://example.com/image.jpg"}
      const colorMapping = getColorMapping();

      if (colorMapping && colorMapping[colorName]) {
        const value = colorMapping[colorName];

        // 判断是颜色代码还是图片 URL
        if (value.startsWith('#') || value.startsWith('rgb')) {
          // 颜色代码
          option.style.backgroundColor = value;
        } else if (value.startsWith('http') || value.startsWith('/')) {
          // 图片 URL
          option.style.backgroundImage = `url(${value})`;
          option.style.backgroundSize = 'cover';
          option.style.backgroundPosition = 'center';
          option.style.backgroundColor = 'transparent';
        }
      } else {
        // 如果没有配置，使用默认浅灰色
        option.style.backgroundColor = '#CCCCCC';
      }
    });

    // 从产品的 meta 数据中获取颜色映射
    function getColorMapping() {
      try {
        // 尝试从页面的 data 属性中读取
        const metaElement = document.querySelector('[data-color-mapping]');
        if (metaElement) {
          return JSON.parse(metaElement.getAttribute('data-color-mapping'));
        }
      } catch (e) {
        console.error('Failed to parse color mapping:', e);
      }
      return null;
    }

    // Handle variation option click
    variationOptions.forEach(option => {
      option.addEventListener('click', () => {
        const attributeName = option.getAttribute('data-attribute');
        const attributeValue = option.getAttribute('data-value');

        // Toggle selection within the same attribute group
        const sameAttributeOptions = document.querySelectorAll(`[data-attribute="${attributeName}"]`);
        sameAttributeOptions.forEach(opt => opt.classList.remove('selected'));
        option.classList.add('selected');

        // Update selected attributes
        selectedAttributes[attributeName] = attributeValue;

        // Update the label to show selected value
        const label = document.querySelector(`[data-attribute-label="${attributeName}"]`);
        if (label) {
          label.textContent = attributeValue;
        }

        // 如果是颜色属性，更新sticky bar的颜色名称显示
        const isColorAttr = attributeName.toLowerCase().includes('color') || attributeName.toLowerCase().includes('colour');
        if (isColorAttr) {
          const stickyColorDisplay = document.querySelector('[data-sticky-color-name]');
          if (stickyColorDisplay) {
            const colorValueSpan = stickyColorDisplay.querySelector('.color-value');
            if (colorValueSpan) {
              colorValueSpan.textContent = attributeValue;
              stickyColorDisplay.style.display = 'block';
            }
          }
        }

        // 更新加购按钮状态
        updateAddToCartButtonState();

        // Find matching variation
        const matchingVariation = findMatchingVariation(variations, selectedAttributes);

        if (matchingVariation) {
          selectedVariation = matchingVariation;
          updateProductInfo(matchingVariation);
        }
      });
    });

    // Find matching variation based on selected attributes
    function findMatchingVariation(variations, selectedAttrs) {
      return variations.find(variation => {
        return variation.attributes.every(attr => {
          return selectedAttrs[attr.name] === attr.option;
        });
      });
    }

    // Update product price, stock, and image based on selected variation
    function updateProductInfo(variation) {
      // Update price
      const priceSection = document.querySelector('[data-product="price"]');
      if (priceSection) {
        const price = parseFloat(variation.price);
        const regularPrice = parseFloat(variation.regular_price);
        const onSale = variation.on_sale;

        if (onSale && variation.sale_price) {
          priceSection.innerHTML = `
            <div class="price-wrapper">
              <span class="price-sale">$${price.toFixed(2)}</span>
              <span class="price-regular">$${regularPrice.toFixed(2)}</span>
            </div>
          `;
        } else {
          priceSection.innerHTML = `<span class="price-current">$${price.toFixed(2)}</span>`;
        }
      }

      // Stock status display removed

      // Update main image if variation has image
      if (variation.image && variation.image.src) {
        const mainImage = document.querySelector('[data-main-image]');
        const zoomImage = document.querySelector('[data-zoom-image]');
        const stickyImage = document.querySelector('.sticky-cart-image img');

        if (mainImage) {
          // 强制更新主图
          mainImage.src = variation.image.src;

          // 同时更新放大预览图（桌面端）
          if (zoomImage) {
            zoomImage.src = variation.image.src;
          }

          // 同时更新粘性栏图片
          if (stickyImage) {
            stickyImage.src = variation.image.src;
          }

          // 添加视觉反馈（淡入效果）
          mainImage.style.transition = 'opacity 0.2s';
          mainImage.style.opacity = '0.7';
          setTimeout(() => {
            mainImage.style.opacity = '1';
          }, 100);
        }
      }

      // Update add to cart button data
      const addToCartBtn = document.querySelector('.add-to-cart-btn');
      if (addToCartBtn) {
        addToCartBtn.setAttribute('data-product-id', variation.id);
        addToCartBtn.disabled = variation.stock_status !== 'instock';
      }
    }
  }

  // ==================== Add to Cart ====================
  const addToCartBtn = document.querySelector('.add-to-cart-btn');

  if (addToCartBtn) {
    addToCartBtn.addEventListener('click', () => {
      // 如果按钮被禁用，不执行
      if (addToCartBtn.disabled) {
        return;
      }

      const productId = parseInt(addToCartBtn.getAttribute('data-product-id') || '0');
      const quantity = qtyInput ? parseInt(qtyInput.value) : 1;

      // Disable button temporarily
      addToCartBtn.disabled = true;
      const originalText = addToCartBtn.textContent;
      addToCartBtn.textContent = 'Adding...';

      try {
        // 获取当前产品信息
        const productName = document.querySelector('.product-title')?.textContent || '';

        // 获取图片：优先使用变体的原始图片URL
        let productImage = '';
        if (selectedVariation && selectedVariation.image && selectedVariation.image.src) {
          productImage = selectedVariation.image.src;
        } else {
          productImage = document.querySelector('[data-main-image]')?.src || '';
        }

        // 获取价格（从变体或产品价格区域）
        let productPrice = 0;
        if (selectedVariation) {
          productPrice = parseFloat(selectedVariation.price);
        } else {
          const priceText = document.querySelector('[data-product="price"]')?.textContent || '0';
          productPrice = parseFloat(priceText.replace(/[^0-9.]/g, ''));
        }

        // 准备属性数据（转换为简单格式）
        let attributes = undefined;
        if (selectedVariation && selectedVariation.attributes) {
          attributes = selectedVariation.attributes.map(attr => ({
            name: attr.name,
            value: attr.option
          }));
        }

        // 准备购物车商品数据
        const cartItem = {
          product_id: productId,
          variation_id: selectedVariation ? productId : undefined,
          quantity: quantity,
          name: productName,
          price: productPrice,
          image: productImage,
          permalink: window.location.href,
          attributes: attributes,
        };

        console.log('Adding to cart:', cartItem);

        // 添加到localStorage购物车
        CartManager.addItem(cartItem);

        // 埋点：追踪加购事件
        analytics.trackAddToCart(
          cartItem.product_id,
          cartItem.name,
          cartItem.price,
          cartItem.quantity,
          cartItem.variation_id
        );

        // Button animation
        gsap.to(addToCartBtn, {
          scale: 0.95,
          duration: 0.1,
          yoyo: true,
          repeat: 1,
          ease: 'power2.inOut'
        });

        // Success feedback
        addToCartBtn.textContent = 'Added!';
        setTimeout(() => {
          addToCartBtn.textContent = originalText;
          addToCartBtn.disabled = false;
        }, 1500);

        // 打开购物车抽屉
        setTimeout(() => {
          window.dispatchEvent(new CustomEvent('open-cart'));
        }, 300);

      } catch (error) {
        console.error('Failed to add to cart:', error);
        showError('Failed to add item to cart. Please try again.');
        addToCartBtn.textContent = originalText;
        addToCartBtn.disabled = false;
      }
    });
  }

  // ==================== Toast Notification ====================
  function showToast(message: string) {
    const toast = document.createElement('div');
    toast.className = 'toast-notification';
    toast.textContent = message;
    document.body.appendChild(toast);

    gsap.fromTo(toast,
      { opacity: 0, y: 20 },
      {
        opacity: 1,
        y: 0,
        duration: 0.3,
        ease: 'power2.out',
        onComplete: () => {
          setTimeout(() => {
            gsap.to(toast, {
              opacity: 0,
              y: -20,
              duration: 0.3,
              ease: 'power2.in',
              onComplete: () => toast.remove()
            });
          }, 2000);
        }
      }
    );
  }

  // ==================== Tabs Functionality ====================
  const tabButtons = document.querySelectorAll('.tab-button');
  const tabContents = document.querySelectorAll('.tab-content');

  tabButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const tabName = button.getAttribute('data-tab');

      // Update active states
      tabButtons.forEach(btn => btn.classList.remove('active'));
      button.classList.add('active');

      tabContents.forEach(content => {
        content.classList.remove('active');
        if (content.getAttribute('data-tab-content') === tabName) {
          content.classList.add('active');

          // Animate tab content
          gsap.from(content, {
            opacity: 0,
            y: 20,
            duration: 0.5,
            ease: 'power2.out',
          });
        }
      });
    });
  });

  // ==================== Image Zoom (Desktop) ====================
  if (galleryMainEl && zoomPreview && zoomImage && window.innerWidth > 768) {
    // 定义边缘区域的宽度（像素）
    const edgeMargin = 60; // 左右各60px的边缘区域不触发放大
    let isZoomActive = false; // 标记放大预览是否激活

    galleryMainEl.addEventListener('mousemove', (e) => {
      const rect = galleryMainEl.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      // 检查鼠标是否在边缘区域（左右各60px）
      const isInEdgeZone = x < edgeMargin || x > rect.width - edgeMargin;

      if (isInEdgeZone) {
        // 在边缘区域，隐藏放大预览
        zoomPreview.style.opacity = '0';
        if (isZoomActive) {
          isZoomActive = false;
          startAutoSlide(); // 恢复自动轮播
        }
        return;
      }

      // 在中心区域，显示放大预览并暂停自动轮播
      zoomPreview.style.opacity = '1';
      if (!isZoomActive) {
        isZoomActive = true;
        stopAutoSlide(); // 暂停自动轮播
      }

      // 计算鼠标在图片上的百分比位置
      const xPercent = x / rect.width;
      const yPercent = y / rect.height;

      // 获取放大图片的尺寸
      const zoomWidth = zoomImage.offsetWidth;
      const zoomHeight = zoomImage.offsetHeight;
      const previewWidth = zoomPreview.offsetWidth;
      const previewHeight = zoomPreview.offsetHeight;

      // 计算放大图片应该移动的距离
      // 使鼠标指向的点正好在预览窗口中心
      const offsetX = xPercent * zoomWidth - previewWidth / 2;
      const offsetY = yPercent * zoomHeight - previewHeight / 2;

      zoomImage.style.left = `-${offsetX}px`;
      zoomImage.style.top = `-${offsetY}px`;
    });

    galleryMainEl.addEventListener('mouseleave', () => {
      zoomPreview.style.opacity = '0';
      if (isZoomActive) {
        isZoomActive = false;
        startAutoSlide(); // 恢复自动轮播
      }
    });
  }

  // ==================== Lightbox (Mobile) ====================
  const lightbox = document.querySelector('[data-lightbox]') as HTMLElement;
  const lightboxTrigger = document.querySelector('[data-lightbox-trigger]') as HTMLElement;
  const lightboxClose = document.querySelector('[data-lightbox-close]');
  const lightboxImage = document.querySelector('[data-lightbox-image]') as HTMLImageElement;
  const lightboxCounter = document.querySelector('[data-lightbox-counter]');
  const lightboxPrev = document.querySelector('[data-lightbox-prev]');
  const lightboxNext = document.querySelector('[data-lightbox-next]');

  let lightboxIndex = 0;
  const lightboxImages = Array.from(document.querySelectorAll('[data-thumbnail]')).map(
    (thumb) => (thumb.querySelector('img') as HTMLImageElement)?.src || ''
  );

  // 如果只有一张图片，使用主图
  if (lightboxImages.length === 0) {
    lightboxImages.push((document.querySelector('[data-main-image]') as HTMLImageElement)?.src || '');
  }

  function updateLightbox() {
    if (lightboxImage && lightboxCounter) {
      lightboxImage.src = lightboxImages[lightboxIndex];
      lightboxCounter.textContent = `${lightboxIndex + 1} / ${lightboxImages.length}`;
    }
  }

  // 打开Lightbox
  if (lightboxTrigger && lightbox) {
    lightboxTrigger.addEventListener('click', () => {
      lightboxIndex = currentImageIndex || 0;
      updateLightbox();
      lightbox.classList.add('active');
      document.body.style.overflow = 'hidden';
    });
  }

  // 关闭Lightbox
  if (lightboxClose && lightbox) {
    lightboxClose.addEventListener('click', () => {
      lightbox.classList.remove('active');
      document.body.style.overflow = '';
    });

    // 点击背景关闭
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        lightbox.classList.remove('active');
        document.body.style.overflow = '';
      }
    });
  }

  // 上一张
  if (lightboxPrev) {
    lightboxPrev.addEventListener('click', () => {
      lightboxIndex = (lightboxIndex - 1 + lightboxImages.length) % lightboxImages.length;
      updateLightbox();
    });
  }

  // 下一张
  if (lightboxNext) {
    lightboxNext.addEventListener('click', () => {
      lightboxIndex = (lightboxIndex + 1) % lightboxImages.length;
      updateLightbox();
    });
  }

  // 键盘控制
  document.addEventListener('keydown', (e) => {
    if (lightbox?.classList.contains('active')) {
      if (e.key === 'Escape') {
        lightbox.classList.remove('active');
        document.body.style.overflow = '';
      } else if (e.key === 'ArrowLeft') {
        lightboxPrev?.click();
      } else if (e.key === 'ArrowRight') {
        lightboxNext?.click();
      }
    }
  });

  // ==================== Feature Cards Carousel ====================
  const featureCarousel = document.querySelector('[data-feature-carousel]');
  const carouselWrapper = document.querySelector('[data-carousel-wrapper]');
  const carouselPrev = document.querySelector('[data-carousel-prev]');
  const carouselNext = document.querySelector('[data-carousel-next]');
  const scrollbarThumb = document.querySelector('[data-scrollbar-thumb]');
  const scrollbar = document.querySelector('[data-carousel-scrollbar]');

  if (featureCarousel && carouselWrapper && carouselPrev && carouselNext && scrollbarThumb && scrollbar) {
    const cards = carouselWrapper.querySelectorAll('.feature-card');

    if (cards.length > 0) {
      // 更新滚动条
      function updateScrollbar() {
        const scrollLeft = carouselWrapper.scrollLeft;
        const scrollWidth = carouselWrapper.scrollWidth;
        const clientWidth = carouselWrapper.clientWidth;
        const maxScroll = scrollWidth - clientWidth;

        const thumbWidth = (clientWidth / scrollWidth) * 100;
        const thumbPosition = (scrollLeft / maxScroll) * (100 - thumbWidth);

        scrollbarThumb.style.width = `${thumbWidth}%`;
        scrollbarThumb.style.left = `${thumbPosition}%`;

        // 更新按钮状态
        carouselPrev.disabled = scrollLeft <= 0;
        carouselNext.disabled = scrollLeft >= maxScroll - 1;
      }

      // 初始化滚动条
      updateScrollbar();

      // 监听滚动事件
      carouselWrapper.addEventListener('scroll', updateScrollbar);

      // 上一张
      carouselPrev.addEventListener('click', () => {
        const cardWidth = cards[0].offsetWidth;
        const gap = 24; // 1.5rem gap
        carouselWrapper.scrollBy({ left: -(cardWidth + gap), behavior: 'smooth' });
      });

      // 下一张
      carouselNext.addEventListener('click', () => {
        const cardWidth = cards[0].offsetWidth;
        const gap = 24;
        carouselWrapper.scrollBy({ left: cardWidth + gap, behavior: 'smooth' });
      });

      // 鼠标拖动卡片区域
      let isDraggingCards = false;
      let startX = 0;
      let scrollLeft = 0;

      carouselWrapper.addEventListener('mousedown', (e) => {
        isDraggingCards = true;
        carouselWrapper.style.cursor = 'grabbing';
        carouselWrapper.style.userSelect = 'none';
        startX = e.pageX - carouselWrapper.offsetLeft;
        scrollLeft = carouselWrapper.scrollLeft;
      });

      carouselWrapper.addEventListener('mouseleave', () => {
        isDraggingCards = false;
        carouselWrapper.style.cursor = 'grab';
      });

      carouselWrapper.addEventListener('mouseup', () => {
        isDraggingCards = false;
        carouselWrapper.style.cursor = 'grab';
      });

      carouselWrapper.addEventListener('mousemove', (e) => {
        if (!isDraggingCards) return;
        e.preventDefault();
        const x = e.pageX - carouselWrapper.offsetLeft;
        const walk = (x - startX) * 2; // 滚动速度倍数
        carouselWrapper.scrollLeft = scrollLeft - walk;
      });

      // 点击滚动条跳转
      scrollbar.addEventListener('click', (e) => {
        const rect = scrollbar.getBoundingClientRect();
        const clickX = e.clientX - rect.left;
        const percentage = clickX / rect.width;
        const scrollWidth = carouselWrapper.scrollWidth;
        const clientWidth = carouselWrapper.clientWidth;
        const maxScroll = scrollWidth - clientWidth;

        carouselWrapper.scrollTo({ left: percentage * maxScroll, behavior: 'smooth' });
      });

      // 拖动滚动条
      let isDraggingScrollbar = false;
      let startScrollbarX = 0;
      let startScrollLeft = 0;
      let animationFrameId = null;

      scrollbarThumb.addEventListener('mousedown', (e) => {
        isDraggingScrollbar = true;
        startScrollbarX = e.clientX;
        startScrollLeft = carouselWrapper.scrollLeft;
        scrollbarThumb.style.cursor = 'grabbing';
        e.preventDefault();
        e.stopPropagation(); // 防止触发scrollbar的click事件
      });

      document.addEventListener('mousemove', (e) => {
        if (!isDraggingScrollbar) return;

        // 取消之前的动画帧
        if (animationFrameId) {
          cancelAnimationFrame(animationFrameId);
        }

        // 使用 requestAnimationFrame 优化性能
        animationFrameId = requestAnimationFrame(() => {
          const deltaX = e.clientX - startScrollbarX;
          const scrollbarWidth = scrollbar.clientWidth;
          const scrollWidth = carouselWrapper.scrollWidth;
          const clientWidth = carouselWrapper.clientWidth;
          const maxScroll = scrollWidth - clientWidth;

          const scrollRatio = maxScroll / scrollbarWidth;
          carouselWrapper.scrollLeft = startScrollLeft + (deltaX * scrollRatio);
        });
      });

      document.addEventListener('mouseup', () => {
        if (isDraggingScrollbar) {
          isDraggingScrollbar = false;
          scrollbarThumb.style.cursor = 'grab';
          if (animationFrameId) {
            cancelAnimationFrame(animationFrameId);
            animationFrameId = null;
          }
        }
      });

      // 窗口大小改变时更新
      window.addEventListener('resize', updateScrollbar);
    }
  }

  // ==================== Gallery Swiper ====================
  // Check if Swiper is available, if not load it
  if (typeof window !== 'undefined') {
    // Preload all gallery images before initializing Swiper
    function preloadGalleryImages(callback) {
      const galleryContainer = document.querySelector('[data-gallery-swiper]');
      if (!galleryContainer) {
        callback();
        return;
      }

      const images = galleryContainer.querySelectorAll('.gallery-image');
      let loadedCount = 0;
      const totalImages = images.length;

      if (totalImages === 0) {
        callback();
        return;
      }

      images.forEach((img) => {
        if (img.complete) {
          loadedCount++;
          if (loadedCount === totalImages) {
            callback();
          }
        } else {
          img.addEventListener('load', () => {
            loadedCount++;
            if (loadedCount === totalImages) {
              callback();
            }
          });
          img.addEventListener('error', () => {
            loadedCount++;
            if (loadedCount === totalImages) {
              callback();
            }
          });
        }
      });
    }

    // Function to initialize gallery swiper
    function initGallerySwiper() {
      const gallerySwiper = document.querySelector('[data-gallery-swiper]');

      if (gallerySwiper && window.Swiper) {
        new window.Swiper('[data-gallery-swiper]', {
          slidesPerView: 'auto',
          spaceBetween: 20,
          loop: false,
          centeredSlides: false,
          preloadImages: false,
          lazy: false,
          watchSlidesProgress: true,
          observer: true,
          observeParents: true,
          navigation: {
            nextEl: '.swiper-button-next',
            prevEl: '.swiper-button-prev',
          },
          pagination: {
            el: '.gallery-pagination',
            clickable: true,
          },
          breakpoints: {
            320: {
              spaceBetween: 16,
              centeredSlides: true,
            },
            768: {
              spaceBetween: 20,
              centeredSlides: false,
            },
          },
          on: {
            init: function() {
              // 强制加载所有图片
              const images = this.el.querySelectorAll('img');
              images.forEach(img => {
                if (img.loading === 'lazy') {
                  img.loading = 'eager';
                }
              });
            },
          },
        });
      }
    }

    // Load Swiper CSS and JS
    if (!document.querySelector('link[href*="swiper"]')) {
      const swiperCSS = document.createElement('link');
      swiperCSS.rel = 'stylesheet';
      swiperCSS.href = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css';
      document.head.appendChild(swiperCSS);
    }

    if (!window.Swiper) {
      const swiperScript = document.createElement('script');
      swiperScript.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
      swiperScript.onload = () => {
        preloadGalleryImages(() => {
          initGallerySwiper();
        });
      };
      document.body.appendChild(swiperScript);
    } else {
      preloadGalleryImages(() => {
        initGallerySwiper();
      });
    }

    // Gallery lightbox functionality
    const galleryItems = document.querySelectorAll('[data-lightbox-trigger]');
    const lightboxModal = document.getElementById('lightboxModal');
    const lightboxImage = document.getElementById('lightboxImage') as HTMLImageElement;
    const lightboxCurrent = document.getElementById('lightboxCurrent');
    const lightboxClose = lightboxModal?.querySelector('.lightbox-close');
    const lightboxPrev = lightboxModal?.querySelector('.lightbox-prev');
    const lightboxNext = lightboxModal?.querySelector('.lightbox-next');
    const lightboxOverlay = lightboxModal?.querySelector('.lightbox-overlay');

    let currentImageIndex = 0;
    const galleryImagesArray: string[] = [];

    // Collect all gallery image URLs
    galleryItems.forEach((item) => {
      const img = item.querySelector('.gallery-image') as HTMLImageElement;
      if (img && img.src) {
        galleryImagesArray.push(img.src);
      }
    });

    function showLightboxImage(index: number) {
      if (index < 0) index = galleryImagesArray.length - 1;
      if (index >= galleryImagesArray.length) index = 0;

      currentImageIndex = index;

      if (lightboxImage) {
        lightboxImage.src = galleryImagesArray[index];
        lightboxImage.alt = `Gallery Image ${index + 1}`;
      }

      if (lightboxCurrent) {
        lightboxCurrent.textContent = String(index + 1);
      }
    }

    function openLightbox(index: number) {
      if (lightboxModal) {
        lightboxModal.classList.add('active');
        document.body.style.overflow = 'hidden';
        showLightboxImage(index);
      }
    }

    function closeLightbox() {
      if (lightboxModal) {
        lightboxModal.classList.remove('active');
        document.body.style.overflow = '';
      }
    }

    // Open lightbox on gallery item click
    galleryItems.forEach((item) => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        const index = parseInt(item.getAttribute('data-lightbox-trigger') || '0');
        openLightbox(index);
      });
    });

    // Close lightbox
    lightboxClose?.addEventListener('click', closeLightbox);
    lightboxOverlay?.addEventListener('click', closeLightbox);

    // Previous image
    lightboxPrev?.addEventListener('click', () => {
      showLightboxImage(currentImageIndex - 1);
    });

    // Next image
    lightboxNext?.addEventListener('click', () => {
      showLightboxImage(currentImageIndex + 1);
    });

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (!lightboxModal?.classList.contains('active')) return;

      if (e.key === 'Escape') {
        closeLightbox();
      } else if (e.key === 'ArrowLeft') {
        showLightboxImage(currentImageIndex - 1);
      } else if (e.key === 'ArrowRight') {
        showLightboxImage(currentImageIndex + 1);
      }
    });
  }

  // ==================== Review System ====================
  const reviewModal = document.querySelector('[data-review-modal]');
  const openReviewBtn = document.querySelector('[data-open-review-form]');
  const closeReviewBtns = document.querySelectorAll('[data-close-review-modal]');
  const reviewForm = document.querySelector('[data-review-form]') as HTMLFormElement;
  const ratingInput = document.querySelector('[data-rating-input]');
  const ratingValueInput = document.querySelector('[data-rating-value-input]') as HTMLInputElement;
  const formMessage = document.querySelector('[data-form-message]') as HTMLElement;

  // Open review modal
  if (openReviewBtn && reviewModal) {
    openReviewBtn.addEventListener('click', async () => {
      // Show loading state
      const originalText = openReviewBtn.textContent;
      openReviewBtn.textContent = 'Loading...';
      openReviewBtn.disabled = true;

      try {
        // Check if user is logged in
        const authCheck = await fetch('/api/auth/session');
        const authData = await authCheck.json();

        if (!authData.authenticated) {
          showWarning('Please log in to write a review.', 'Login Required');
          // Trigger auth modal
          document.querySelector('[data-open-auth]')?.dispatchEvent(new Event('click'));
          return;
        }

        // User is logged in, show modal
        reviewModal.classList.add('active');
        document.body.style.overflow = 'hidden';
      } catch (error) {
        console.error('Error checking auth status:', error);
        showError('Unable to open review form. Please try again.');
      } finally {
        // Restore button state
        openReviewBtn.textContent = originalText;
        openReviewBtn.disabled = false;
      }
    });
  }

  // Close review modal
  closeReviewBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      if (reviewModal) {
        reviewModal.classList.remove('active');
        document.body.style.overflow = '';
      }
    });
  });

  // Rating stars interaction
  if (ratingInput) {
    const stars = ratingInput.querySelectorAll('.rating-star');
    let selectedRating = 0;

    stars.forEach((star, index) => {
      star.addEventListener('click', () => {
        selectedRating = index + 1;
        if (ratingValueInput) {
          ratingValueInput.value = selectedRating.toString();
        }
        updateStars(selectedRating);
      });

      star.addEventListener('mouseenter', () => {
        updateStars(index + 1);
      });
    });

    ratingInput.addEventListener('mouseleave', () => {
      updateStars(selectedRating);
    });

    function updateStars(rating: number) {
      stars.forEach((star, index) => {
        if (index < rating) {
          star.classList.add('active');
        } else {
          star.classList.remove('active');
        }
      });
    }
  }

  // Submit review form
  if (reviewForm) {
    // Media preview handling
    const mediaInput = reviewForm.querySelector('[data-media-input]') as HTMLInputElement;
    const mediaPreview = reviewForm.querySelector('[data-media-preview]') as HTMLElement;

    if (mediaInput && mediaPreview) {
      mediaInput.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        const files = target.files;

        if (!files) return;

        // Clear previous preview
        mediaPreview.innerHTML = '';

        // Validate file count and size
        if (files.length > 5) {
          showMessage('You can upload maximum 5 files', 'error');
          mediaInput.value = '';
          return;
        }

        Array.from(files).forEach((file, index) => {
          // Check file size - images: 10MB, videos: 50MB
          const isVideo = file.type.startsWith('video/');
          const maxSize = isVideo ? 50 * 1024 * 1024 : 10 * 1024 * 1024;
          const maxSizeLabel = isVideo ? '50MB' : '10MB';

          if (file.size > maxSize) {
            showMessage(`File ${file.name} is too large (max ${maxSizeLabel})`, 'error');
            return;
          }

          // Create preview
          const reader = new FileReader();
          reader.onload = (e) => {
            const preview = document.createElement('div');
            preview.className = 'media-preview-item';

            if (file.type.startsWith('image/')) {
              preview.innerHTML = `
                <img src="${e.target?.result}" alt="Preview ${index + 1}" />
                <button type="button" class="remove-media" data-index="${index}">×</button>
              `;
            } else if (file.type.startsWith('video/')) {
              preview.innerHTML = `
                <video src="${e.target?.result}" controls></video>
                <button type="button" class="remove-media" data-index="${index}">×</button>
              `;
            }

            mediaPreview.appendChild(preview);
          };

          reader.readAsDataURL(file);
        });
      });

      // Remove media on click
      mediaPreview.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.classList.contains('remove-media')) {
          const index = parseInt(target.getAttribute('data-index') || '0');
          target.closest('.media-preview-item')?.remove();

          // Update file input (not perfect, but workable)
          // In production, consider using a library for better file management
        }
      });
    }

    reviewForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(reviewForm);
      const rating = formData.get('rating');
      const review = formData.get('review');

      // Validate rating
      if (!rating || rating === '0') {
        showMessage('Please select a rating', 'error');
        return;
      }

      try {
        const submitBtn = reviewForm.querySelector('button[type="submit"]') as HTMLButtonElement;
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Submitting...';
        }

        // Handle media files
        const mediaFiles = Array.from(formData.getAll('media') as File[]).filter(f => f && f.size > 0);
        const mediaUrls: string[] = [];

        console.log('Media files to upload:', mediaFiles.length);

        // Convert images to base64 for demo purposes
        // In production, upload to server/cloud storage first
        if (mediaFiles.length > 0) {
          const promises = mediaFiles.map((file) => {
            return new Promise<string>((resolve, reject) => {
              const reader = new FileReader();
              reader.onload = (e) => resolve(e.target?.result as string);
              reader.onerror = reject;
              reader.readAsDataURL(file);
            });
          });

          const results = await Promise.all(promises);
          mediaUrls.push(...results);
          console.log('Images converted to base64:', mediaUrls.length);
        }

        const data = {
          product_id: formData.get('product_id'),
          rating: rating,
          review: review,
          images: mediaUrls,
        };

        console.log('Submitting review data with', data.images.length, 'images');

        const response = await fetch('/api/reviews', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        const result = await response.json();

        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit Review';
        }

        if (response.ok) {
          showMessage('Thank you! Your review has been submitted and is pending approval.', 'success');

          // Log the result for debugging
          console.log('Review submission result:', result);

          reviewForm.reset();
          if (ratingValueInput) ratingValueInput.value = '';
          if (mediaPreview) mediaPreview.innerHTML = '';

          // Reset star ratings
          const stars = ratingInput?.querySelectorAll('.rating-star');
          stars?.forEach(star => star.classList.remove('active'));

          // Close modal after 3 seconds (removed auto-reload for debugging)
          setTimeout(() => {
            if (reviewModal) {
              reviewModal.classList.remove('active');
              document.body.style.overflow = '';
            }
          }, 3000);
        } else {
          showMessage(result.error || 'Failed to submit review. Please try again.', 'error');
        }
      } catch (error) {
        console.error('Error submitting review:', error);
        showMessage('An error occurred. Please try again later.', 'error');

        const submitBtn = reviewForm.querySelector('button[type="submit"]') as HTMLButtonElement;
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit Review';
        }
      }
    });
  }

  function showMessage(message: string, type: 'success' | 'error') {
    if (formMessage) {
      formMessage.textContent = message;
      formMessage.className = `form-message ${type}`;
      formMessage.style.display = 'block';

      setTimeout(() => {
        formMessage.style.display = 'none';
      }, 5000);
    }
  }

  // ==================== Sticky Add to Cart Bar ====================
  const stickyCartBar = document.querySelector('[data-sticky-cart]');
  const productActions = document.querySelector('.product-actions');
  const stickyQtyInput = document.querySelector('[data-sticky-qty-input]');
  const stickyQtyDecrease = document.querySelector('[data-sticky-qty="decrease"]');
  const stickyQtyIncrease = document.querySelector('[data-sticky-qty="increase"]');
  const stickyAddToCartBtn = document.querySelector('[data-sticky-add-cart]');
  const stickyPrice = document.querySelector('[data-sticky-price]');
  const mainQtyInput = document.querySelector('[data-qty-input]');
  const mainPrice = document.querySelector('[data-product="price"]');

  console.log('Sticky cart bar found:', !!stickyCartBar);
  console.log('Product actions found:', !!productActions);

  if (stickyCartBar && productActions) {
    // 获取颜色映射的辅助函数
    function getStickyColorMapping() {
      try {
        const metaElement = document.querySelector('[data-color-mapping]');
        if (metaElement) {
          return JSON.parse(metaElement.getAttribute('data-color-mapping'));
        }
      } catch (e) {
        console.error('Failed to parse color mapping:', e);
      }
      return null;
    }

    // 应用颜色映射到粘性栏颜色选项
    const stickyColorOptions = document.querySelectorAll('.sticky-variation-color');
    const colorMapping = getStickyColorMapping();

    stickyColorOptions.forEach(option => {
      const colorName = option.getAttribute('data-sticky-color-name');

      if (colorMapping && colorMapping[colorName]) {
        const value = colorMapping[colorName];

        if (value.startsWith('#') || value.startsWith('rgb')) {
          option.style.backgroundColor = value;
        } else if (value.startsWith('http') || value.startsWith('/')) {
          option.style.backgroundImage = `url(${value})`;
          option.style.backgroundSize = 'cover';
          option.style.backgroundPosition = 'center';
          option.style.backgroundColor = 'transparent';
        }
      } else {
        option.style.backgroundColor = '#CCCCCC';
      }
    });

    // 粘性栏变体选择
    const stickyVariationOptions = document.querySelectorAll('[data-sticky-attribute]');
    const mainVariationOptions = document.querySelectorAll('[data-attribute]');

    if (stickyVariationOptions.length > 0 && mainVariationOptions.length > 0) {
      // 粘性栏变体点击 -> 触发主变体选择
      stickyVariationOptions.forEach(stickyOption => {
        stickyOption.addEventListener('click', () => {
          const attributeName = stickyOption.getAttribute('data-sticky-attribute');
          const attributeValue = stickyOption.getAttribute('data-sticky-value');

          // 找到对应的主变体选项并触发点击
          const mainOption = Array.from(mainVariationOptions).find(opt =>
            opt.getAttribute('data-attribute') === attributeName &&
            opt.getAttribute('data-value') === attributeValue
          );

          if (mainOption) {
            // 触发主选项点击
            mainOption.click();

            // 如果是颜色属性，更新sticky bar的颜色名称显示
            const isColorAttr = attributeName.toLowerCase().includes('color') || attributeName.toLowerCase().includes('colour');
            if (isColorAttr) {
              const stickyColorDisplay = document.querySelector('[data-sticky-color-name]');
              if (stickyColorDisplay) {
                const colorValueSpan = stickyColorDisplay.querySelector('.color-value');
                if (colorValueSpan) {
                  colorValueSpan.textContent = attributeValue;
                  stickyColorDisplay.style.display = 'block';
                }
              }
            }

            // 强制同步状态（确保图片更新）
            setTimeout(() => {
              // 重新查找匹配的变体并更新
              const matchingVariation = findMatchingVariation(variations, selectedAttributes);
              if (matchingVariation && matchingVariation.image && matchingVariation.image.src) {
                const mainImage = document.querySelector('[data-main-image]');
                const zoomImage = document.querySelector('[data-zoom-image]');
                const stickyImage = document.querySelector('.sticky-cart-image img');

                if (mainImage) {
                  mainImage.src = matchingVariation.image.src;

                  if (zoomImage) {
                    zoomImage.src = matchingVariation.image.src;
                  }

                  if (stickyImage) {
                    stickyImage.src = matchingVariation.image.src;
                  }

                  // 添加视觉反馈
                  mainImage.style.transition = 'opacity 0.2s';
                  mainImage.style.opacity = '0.7';
                  setTimeout(() => {
                    mainImage.style.opacity = '1';
                  }, 100);
                }
              }
            }, 50);
          }
        });
      });

      // 主变体选择变化 -> 同步粘性栏状态
      const syncStickyVariations = () => {
        mainVariationOptions.forEach(mainOption => {
          const attributeName = mainOption.getAttribute('data-attribute');
          const attributeValue = mainOption.getAttribute('data-value');
          const isSelected = mainOption.classList.contains('selected');

          // 找到对应的粘性栏选项
          const stickyOption = Array.from(stickyVariationOptions).find(opt =>
            opt.getAttribute('data-sticky-attribute') === attributeName &&
            opt.getAttribute('data-sticky-value') === attributeValue
          );

          if (stickyOption) {
            if (isSelected) {
              stickyOption.classList.add('selected');
            } else {
              stickyOption.classList.remove('selected');
            }

            // 同步禁用状态
            if (mainOption.disabled) {
              stickyOption.disabled = true;
            } else {
              stickyOption.disabled = false;
            }
          }
        });
      };

      // 监听主变体选择的变化
      mainVariationOptions.forEach(option => {
        option.addEventListener('click', () => {
          setTimeout(syncStickyVariations, 50);
        });
      });

      // 初始同步
      syncStickyVariations();
    }

    // 滚动监听：当原始 Add to Cart 按钮滚出视口时显示粘性栏
    let scrollTimeout;
    window.addEventListener('scroll', () => {
      if (scrollTimeout) {
        clearTimeout(scrollTimeout);
      }

      scrollTimeout = setTimeout(() => {
        const productActionsRect = productActions.getBoundingClientRect();
        const isOutOfView = productActionsRect.bottom < 0 || productActionsRect.top > window.innerHeight;

        if (isOutOfView) {
          stickyCartBar.classList.add('visible');
        } else {
          stickyCartBar.classList.remove('visible');
        }
      }, 10);
    });

    // 同步数量选择器
    if (stickyQtyInput && mainQtyInput) {
      // 主数量变化时更新粘性栏
      const syncStickyQty = () => {
        stickyQtyInput.value = mainQtyInput.value;
      };

      mainQtyInput.addEventListener('input', syncStickyQty);
      mainQtyInput.addEventListener('change', syncStickyQty);

      // 粘性栏数量变化时更新主输入框
      const syncMainQty = () => {
        mainQtyInput.value = stickyQtyInput.value;
      };

      stickyQtyInput.addEventListener('input', syncMainQty);
      stickyQtyInput.addEventListener('change', syncMainQty);

      // 粘性栏数量按钮
      if (stickyQtyDecrease) {
        stickyQtyDecrease.addEventListener('click', () => {
          const currentValue = parseInt(stickyQtyInput.value) || 1;
          if (currentValue > 1) {
            stickyQtyInput.value = (currentValue - 1).toString();
            mainQtyInput.value = stickyQtyInput.value;
            gsap.from(stickyQtyInput, { scale: 1.2, duration: 0.2, ease: 'back.out(2)' });
          }
        });
      }

      if (stickyQtyIncrease) {
        stickyQtyIncrease.addEventListener('click', () => {
          const currentValue = parseInt(stickyQtyInput.value) || 1;
          const maxValue = parseInt(stickyQtyInput.max) || 99;
          if (currentValue < maxValue) {
            stickyQtyInput.value = (currentValue + 1).toString();
            mainQtyInput.value = stickyQtyInput.value;
            gsap.from(stickyQtyInput, { scale: 1.2, duration: 0.2, ease: 'back.out(2)' });
          }
        });
      }
    }

    // 粘性栏 Add to Cart 按钮
    if (stickyAddToCartBtn) {
      stickyAddToCartBtn.addEventListener('click', () => {
        // 如果按钮被禁用，不执行
        if (stickyAddToCartBtn.disabled) {
          return;
        }

        const productId = parseInt(stickyAddToCartBtn.getAttribute('data-product-id') || '0');
        const quantity = stickyQtyInput ? parseInt(stickyQtyInput.value) : 1;

        // Disable button temporarily
        stickyAddToCartBtn.disabled = true;
        const originalText = stickyAddToCartBtn.textContent;
        stickyAddToCartBtn.textContent = 'Adding...';

        try {
          // 获取当前产品信息
          const productName = document.querySelector('.product-title')?.textContent || '';

          // 获取图片：优先使用变体的原始图片URL
          let productImage = '';
          if (selectedVariation && selectedVariation.image && selectedVariation.image.src) {
            productImage = selectedVariation.image.src;
          } else {
            productImage = document.querySelector('[data-main-image]')?.src || '';
          }

          // 获取价格
          let productPrice = 0;
          if (selectedVariation) {
            productPrice = parseFloat(selectedVariation.price);
          } else {
            const priceText = document.querySelector('[data-product="price"]')?.textContent || '0';
            productPrice = parseFloat(priceText.replace(/[^0-9.]/g, ''));
          }

          // 准备属性数据（转换为简单格式）
          let attributes = undefined;
          if (selectedVariation && selectedVariation.attributes) {
            attributes = selectedVariation.attributes.map(attr => ({
              name: attr.name,
              value: attr.option
            }));
          }

          // 准备购物车商品数据
          const cartItem = {
            product_id: productId,
            variation_id: selectedVariation ? productId : undefined,
            quantity: quantity,
            name: productName,
            price: productPrice,
            image: productImage,
            permalink: window.location.href,
            attributes: attributes,
          };

          console.log('Adding to cart (sticky):', cartItem);

          // 添加到localStorage购物车
          CartManager.addItem(cartItem);

          // 埋点：追踪加购事件
          analytics.trackAddToCart(
            cartItem.product_id,
            cartItem.name,
            cartItem.price,
            cartItem.quantity,
            cartItem.variation_id
          );

          // 视觉反馈
          gsap.to(stickyAddToCartBtn, {
            scale: 0.95,
            duration: 0.1,
            yoyo: true,
            repeat: 1,
            ease: 'power2.inOut'
          });

          // Success feedback
          stickyAddToCartBtn.textContent = 'Added!';
          setTimeout(() => {
            stickyAddToCartBtn.textContent = originalText;
            stickyAddToCartBtn.disabled = false;
          }, 1500);

          // 打开购物车抽屉
          setTimeout(() => {
            window.dispatchEvent(new CustomEvent('open-cart'));
          }, 300);

        } catch (error) {
          console.error('Failed to add to cart:', error);
          showError('Failed to add item to cart. Please try again.');
          stickyAddToCartBtn.textContent = originalText;
          stickyAddToCartBtn.disabled = false;
        }
      });
    }

    // 同步价格（如果变体改变价格）
    if (stickyPrice && mainPrice) {
      const observer = new MutationObserver(() => {
        stickyPrice.textContent = mainPrice.textContent;
      });

      observer.observe(mainPrice, {
        childList: true,
        characterData: true,
        subtree: true
      });
    }

    // 同步变体选择时更新粘性栏按钮的 product-id
    const mainAddToCartBtn = document.querySelector('.add-to-cart-btn');
    if (mainAddToCartBtn) {
      const syncProductId = new MutationObserver(() => {
        const newProductId = mainAddToCartBtn.getAttribute('data-product-id');
        if (newProductId && stickyAddToCartBtn) {
          stickyAddToCartBtn.setAttribute('data-product-id', newProductId);
        }
      });

      syncProductId.observe(mainAddToCartBtn, {
        attributes: true,
        attributeFilter: ['data-product-id']
      });
    }
  }

  // ==================== 产品浏览埋点 ====================
  // 追踪产品浏览
  const productName = document.querySelector('.product-title')?.textContent || '';
  const productPriceText = document.querySelector('[data-product="price"]')?.textContent || '0';
  const productPrice = parseFloat(productPriceText.replace(/[^0-9.]/g, ''));
  const productIdElement = document.querySelector('.add-to-cart-btn');
  const productId = parseInt(productIdElement?.getAttribute('data-product-id') || '0');

  if (productId && productName) {
    analytics.trackProductView(productId, productName, productPrice);
  }
</script>

<!-- 3D Model Viewer Script - Simple Configuration -->
<script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.5.0/model-viewer.min.js"></script>

<!-- Model Loading Progress -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const modelViewer = document.querySelector('model-viewer');
    const loadingText = document.getElementById('loading-text');
    const loadingProgress = document.getElementById('loading-progress');

    if (modelViewer && loadingProgress) {
      console.log('Model viewer found, src:', modelViewer.getAttribute('src'));

      // 显示加载进度
      modelViewer.addEventListener('progress', (event) => {
        const progress = event.detail.totalProgress;
        const percent = (progress * 100).toFixed(0);
        loadingProgress.textContent = `${percent}% loaded`;
        console.log('Loading progress:', percent + '%');
      });

      // 加载完成
      modelViewer.addEventListener('load', () => {
        console.log('3D model loaded successfully!');
        loadingText.textContent = 'Model loaded!';
      });

      // 加载错误
      modelViewer.addEventListener('error', (event) => {
        console.error('Model loading error:', event);
        console.error('Error detail:', event.detail);
        console.error('Model source:', modelViewer.src);
        loadingText.textContent = 'Failed to load model';
        loadingProgress.textContent = event.detail?.message || 'Please check console for details';
      });
    } else {
      console.log('Model viewer not found or no loading progress element');
    }

    // 3D查看器提示框自动消失
    const viewerControlsHint = document.getElementById('viewer-controls-hint');
    if (viewerControlsHint) {
      // 3秒后淡出提示框
      setTimeout(() => {
        viewerControlsHint.classList.add('fade-out');
      }, 3000);

      // 如果用户与模型交互，立即隐藏提示框
      if (modelViewer) {
        const hideHint = () => {
          viewerControlsHint.classList.add('fade-out');
        };

        modelViewer.addEventListener('camera-change', hideHint, { once: true });
      }
    }

    // 3D 模型切换按钮功能
    const switchButtons = document.querySelectorAll('.model-switch-btn');
    if (switchButtons.length > 0 && modelViewer) {
      const modelUrl1 = modelViewer.getAttribute('data-model-url-1');
      const modelUrl2 = modelViewer.getAttribute('data-model-url-2');
      const loadingOverlay = document.getElementById('model-loading-overlay');
      const switchingText = document.getElementById('switching-text');

      switchButtons.forEach(button => {
        button.addEventListener('click', () => {
          const modelIndex = button.getAttribute('data-model-index');

          // 如果点击的是当前激活的按钮，不做任何操作
          if (button.classList.contains('active')) {
            return;
          }

          // 更新按钮状态
          switchButtons.forEach(btn => btn.classList.remove('active'));
          button.classList.add('active');

          // 显示加载覆盖层
          if (loadingOverlay) {
            loadingOverlay.style.display = 'flex';
            if (switchingText) switchingText.textContent = `Loading Model ${modelIndex}...`;
          }

          // 切换模型
          if (modelIndex === '1' && modelUrl1) {
            modelViewer.src = modelUrl1;
            console.log('Switched to Model 1');
          } else if (modelIndex === '2' && modelUrl2) {
            modelViewer.src = modelUrl2;
            console.log('Switched to Model 2');
          }

          // 显示原始 poster（如果存在）
          const poster = document.getElementById('model-poster');
          if (poster) poster.style.display = 'flex';
          if (loadingText) loadingText.textContent = 'Loading 3D Model...';
          if (loadingProgress) loadingProgress.textContent = '';
        });
      });

      // 监听模型加载完成，隐藏加载覆盖层
      modelViewer.addEventListener('load', () => {
        if (loadingOverlay) {
          setTimeout(() => {
            loadingOverlay.style.display = 'none';
          }, 500); // 延迟500ms以确保用户看到加载完成
        }
      });
    }
  });

  // ==================== Load More Reviews ====================
  const loadMoreBtn = document.querySelector('[data-load-more-reviews]');
  const remainingCountEl = document.querySelector('[data-remaining-count]');

  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', () => {
      const hiddenReviews = document.querySelectorAll('.review-item.review-hidden');
      const batchSize = 6; // 每次加载6条

      // 显示接下来的6条评论
      for (let i = 0; i < Math.min(batchSize, hiddenReviews.length); i++) {
        hiddenReviews[i].classList.remove('review-hidden');
      }

      // 更新剩余数量
      const remainingCount = document.querySelectorAll('.review-item.review-hidden').length;

      if (remainingCountEl) {
        remainingCountEl.textContent = remainingCount.toString();
      }

      // 如果没有更多评论了，隐藏按钮
      if (remainingCount === 0) {
        loadMoreBtn.parentElement?.remove();
      }
    });
  }

  // ==================== Features Toggle ====================
  const featuresToggle = document.querySelector('[data-features-toggle]');
  const featuresGrid = document.querySelector('[data-features-grid]');
  const toggleText = document.querySelector('[data-toggle-text]');

  if (featuresToggle && featuresGrid && toggleText) {
    featuresToggle.addEventListener('click', () => {
      const isCollapsed = featuresGrid.classList.contains('collapsed');

      if (isCollapsed) {
        featuresGrid.classList.remove('collapsed');
        toggleText.textContent = 'Show Less';
      } else {
        featuresGrid.classList.add('collapsed');
        toggleText.textContent = 'Show All';
      }
    });
  }

  // ==================== 3D Badge Smooth Scroll ====================
  const badge3d = document.querySelector('.feature-3d-badge');
  if (badge3d) {
    badge3d.addEventListener('click', (e) => {
      e.preventDefault();

      // 检测是否为移动端
      const isMobile = window.innerWidth <= 768;

      // 移动端跳转到3D viewer，桌面端跳转到specification section
      const targetId = isMobile ? '#model-viewer-3d' : '#specification';
      const target = document.querySelector(targetId);

      if (target) {
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  }

  // ==================== 图片加载占位符处理 ====================
  function initImageLoading() {
    // 选择需要添加加载效果的图片容器（排除 3D viewer）
    const imageContainers = [
      ...document.querySelectorAll('.feature-card-image, .gallery-slide-link, .product-image-wrapper'),
      // 单独处理 specification-image，确保不是 3D viewer
      ...Array.from(document.querySelectorAll('.specification-image')).filter(el =>
        !el.closest('.specification-3d-viewer')
      )
    ];

    imageContainers.forEach(container => {
      // 添加加载类
      container.classList.add('image-loading');

      const img = container.querySelector('img');
      if (img) {
        // 如果图片已经加载完成
        if (img.complete && img.naturalHeight !== 0) {
          container.classList.add('loaded');
        } else {
          // 监听图片加载完成
          img.addEventListener('load', () => {
            container.classList.add('loaded');
          });

          // 监听图片加载失败
          img.addEventListener('error', () => {
            container.classList.add('loaded');
            console.warn('Image failed to load:', img.src);
          });
        }
      }
    });
  }

  // 初始化图片加载
  initImageLoading();

  // 观察动态添加的图片（比如 lightbox）
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      mutation.addedNodes.forEach((node) => {
        if (node.nodeType === 1) {
          const images = node.querySelectorAll?.('.feature-card-image, .gallery-slide-link');
          if (images && images.length > 0) {
            initImageLoading();
          }
        }
      });
    });
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true
  });
</script>

