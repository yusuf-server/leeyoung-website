  }

  .review-modal-content::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
  }

  .review-modal-content::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
  }

  .review-modal-content::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .review-modal-close {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    font-size: 1.5rem;
    line-height: 1;
    color: #fff;
    cursor: pointer;
    transition: all 0.3s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .review-modal-close:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .review-modal-title {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 2rem 0;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .review-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .form-group label {
    font-size: 0.95rem;
    font-weight: 600;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.85rem;
  }

  .form-group input,
  .form-group textarea {
    padding: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 0;
    font-size: 0.95rem;
    font-family: inherit;
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    transition: all 0.3s;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.08);
  }

  .form-group textarea {
    min-height: 120px;
    resize: vertical;
  }

  .rating-input {
    display: flex;
    gap: 0.5rem;
  }

  .rating-star {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: rgba(255, 255, 255, 0.2);
    transition: color 0.2s;
  }

  .rating-star:hover,
  .rating-star.active {
    color: #ffa500;
  }

  .form-hint {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    margin: 0.5rem 0 0 0;
  }

  .media-preview {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .media-preview-item {
    position: relative;
    aspect-ratio: 1;
    border-radius: 0;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .media-preview-item img,
  .media-preview-item video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .remove-media {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 28px;
    height: 28px;
    background: rgba(0, 0, 0, 0.8);
    color: #fff;
    border: none;
    border-radius: 50%;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.3s;
  }

  .remove-media:hover {
    background: rgba(0, 0, 0, 0.95);
  }

  .form-actions {
    display: flex;
    gap: 1rem;
    justify-content: flex-end;
    margin-top: 1rem;
  }

  .btn-cancel,
  .btn-submit {
    padding: 1rem 2rem;
    border: none;
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.3s;
    border-radius: 0;
  }

  .btn-cancel {
    background: transparent;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.3);
  }

  .btn-cancel:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .btn-submit {
    background: #fff;
    color: #000;
  }

  .btn-submit:hover {
    background: rgba(255, 255, 255, 0.9);
  }

  .btn-submit:disabled {
    background: #999;
    cursor: not-allowed;
  }

  .form-message {
    padding: 1rem;
    border-radius: 4px;
    font-size: 0.9rem;
    text-align: center;
  }

  .form-message.success {
    background: #e8f5e9;
    color: #2e7d32;
  }

  .form-message.error {
    background: #ffebee;
    color: #c62828;
  }

  /* ==================== Description Tabs ==================== */
  .product-description-section {
    background: #f4f4f4;
    padding: 4rem 0;
  }

  .product-description-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .description-tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid #e5e5e5;
    margin-bottom: 3rem;
  }

  .tab-button {
    padding: 1rem 2rem;
    background: none;
    border: none;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #666;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: all 0.3s;
  }

  .tab-button:hover {
    color: #000;
  }

  .tab-button.active {
    color: #000;
    border-bottom-color: #000;
  }

  .tab-content {
    display: none;
  }

  .tab-content.active {
    display: block;
  }

  .description-content {
    line-height: 1.8;
    color: #333;
  }

  .info-table {
    width: 100%;
    border-collapse: collapse;
  }

  .info-table tr {
    border-bottom: 1px solid #e5e5e5;
  }

  .info-table th,
  .info-table td {
    padding: 1rem;
    text-align: left;
  }

  .info-table th {
    font-weight: 600;
    color: #333;
    width: 200px;
  }

  .info-table td {
    color: #666;
  }

  /* ==================== Responsive ==================== */
  @media (max-width: 1024px) {
    .product-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .product-gallery {
      position: static;
    }

    .gallery-thumbnails {
      width: 60px;
    }
  }

  @media (max-width: 768px) {
    /* 面包屑导航 - 手机端优化，防止滚动条 */
    .breadcrumbs {
      padding: 0.5rem 1rem;
    }

    .breadcrumbs-container {
      overflow: hidden;
    }

    .breadcrumbs-list {
      font-size: 11px !important;
      gap: 0.25rem;
      flex-wrap: nowrap;
      overflow: hidden;
      display: flex;
      align-items: center;
    }

    .breadcrumbs-list li {
      flex-shrink: 0;
      max-width: none;
    }

    /* 最后一项（产品名称）允许截断 */
    .breadcrumbs-list li:last-child {
      flex-shrink: 1;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      min-width: 0;
    }

    /* 如果有分类，隐藏分类链接显示省略号 */
    .breadcrumbs-list li:nth-child(3) a {
      display: none;
    }

    .breadcrumbs-list li:nth-child(3)::before {
      content: '...';
      color: #666;
    }

    .breadcrumbs-list li:not(:last-child)::after {
      margin-left: 0.25rem;
      margin-right: 0.25rem;
    }

    /* 产品容器 */
    .product-container {
      padding: 0;
      gap: 0;
      grid-template-columns: 1fr;
    }

    /* 画廊 - 主图区域 */
    .product-gallery {
      position: relative !important;
      top: auto !important;
      height: auto !important;
      flex-direction: column;
      gap: 0;
      order: 1;
      margin-bottom: 1.5rem;
      margin-left: 0;
      padding-left: 0;
    }

    .gallery-main {
      position: relative;
      width: 100%;
      aspect-ratio: 1;
      touch-action: pan-y pinch-zoom;
      cursor: grab;
      display: block;
      margin-left: 0;
    }

    .gallery-main:active {
      cursor: grabbing;
    }

    /* 显示图片指示器 */
    .gallery-indicator {
      display: block;
    }

    /* 显示手机端放大图标 */
    .zoom-icon-mobile {
      display: flex !important;
    }

    /* 隐藏桌面端放大预览 */
    .zoom-preview {
      display: none !important;
    }

    /* 隐藏桌面端箭头按钮 */
    .gallery-arrow {
      display: none !important;
    }

    /* 缩略图 - 完全隐藏在手机端 */
    .gallery-thumbnails {
      display: none !important;
    }

    /* 产品信息 */
    .product-info {
      padding: 1.5rem 1rem;
      order: 2;
    }

    .product-title {
      font-size: 1.5rem;
      margin-bottom: 1rem;
    }

    .product-features {
      margin-bottom: 1rem;
    }

    .features-grid {
      gap: 0.4rem;
    }

    .feature-3d-badge {
      padding: 0.45rem 1rem;
      width: auto;
      margin: 0 auto 0.4rem auto;
    }

    .badge-text {
      font-size: 0.7rem;
    }

    .badge-icon,
    .badge-arrow {
      width: 14px;
      height: 14px;
    }

    .feature-item {
      padding: 0.45rem 0.875rem;
    }

    .feature-check {
      width: 12px;
      height: 12px;
    }

    .feature-text {
      font-size: 0.7rem;
    }

    .features-toggle {
      font-size: 0.65rem;
      padding: 0.45rem 0.875rem;
    }

    .price-sale,
    .price-current {
      font-size: 1.5rem;
    }

    .product-actions {
      flex-direction: row;
      gap: 0.75rem;
      align-items: stretch;
    }

    .quantity-selector {
      flex-shrink: 0;
    }

    .add-to-cart-btn {
      flex: 1;
      min-width: 0;
      padding: 0.75rem 1rem;
      font-size: 0.75rem;
    }

    .add-to-cart-btn svg {
      width: 18px;
      height: 18px;
    }

    .description-tabs {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .description-tabs::-webkit-scrollbar {
      display: none;
    }

    .tab-button {
      padding: 1rem 1.5rem;
      white-space: nowrap;
      font-size: 0.875rem;
    }

    /* 产品徽章 - 缩小 */
    .product-badge-sale,
    .product-badge-featured {
      padding: 0.4rem 0.8rem;
      font-size: 0.65rem;
      top: 1rem;
    }

    .product-badge-sale {
      right: 1rem;
    }

    .product-badge-featured {
      left: 1rem;
    }

    /* Product Description Custom */
    .product-description-custom {
      padding: 3rem 0;
    }

    .description-wrapper {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 0 1rem;
    }

    .description-heading {
      position: static;
    }

    .description-title {
      font-size: 1.75rem;
    }

    .description-text {
      font-size: 0.95rem;
    }

    .usage-types {
      gap: 1rem;
      margin-top: 2rem;
    }

    .usage-type-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding: 1rem;
    }

    .usage-type-icon {
      width: 60px;
      height: 60px;
      align-self: flex-end;
    }

    .usage-scale-block {
      width: 30px;
      height: 10px;
    }

    /* Feature Cards Carousel */
    .feature-cards-section {
      padding: 3rem 0;
    }

    .feature-cards-container {
      padding: 0 1rem;
    }

    .feature-cards-header {
      margin-bottom: 2rem;
    }

    .feature-cards-title {
      font-size: 1.75rem;
    }

    .feature-card {
      flex: 0 0 85%;
    }

    .feature-card-content {
      padding: 1.5rem 0;
    }

    .feature-card-title {
      font-size: 1.25rem;
      margin-bottom: 0.75rem;
    }

    .feature-card-description {
      font-size: 0.9rem;
    }

    .carousel-arrow {
      display: none;
    }

    .carousel-scrollbar {
      margin-top: 1.5rem;
    }

    /* Gallery Section */
    .gallery-section {
      padding: 3rem 0;
    }

    .gallery-container {
      width: 100%;
      padding: 0;
    }

    .gallery-header {
      margin-bottom: 2rem;
      padding: 0 1rem;
    }

    .gallery-title {
      font-size: 1.75rem;
    }

    /* 移动端淡出效果已移除 */
    /* .gallery-slider::before,
    .gallery-slider::after {
      width: 80px;
    } */

    .gallery-slide-link {
      width: calc(100vw - 3rem);
      height: auto;
      aspect-ratio: 16 / 11;
    }

    .gallery-swiper .swiper-button-prev,
    .gallery-swiper .swiper-button-next {
      width: 40px;
      height: 40px;
    }

    .gallery-swiper .swiper-button-prev {
      left: 1.5rem;
    }

    .gallery-swiper .swiper-button-next {
      right: 1.5rem;
    }

    .gallery-swiper .swiper-button-prev::after,
    .gallery-swiper .swiper-button-next::after {
      font-size: 16px;
    }

    /* Lightbox 移动端样式 */
    .lightbox-close,
    .lightbox-prev,
    .lightbox-next {
      width: 40px;
      height: 40px;
    }

    .lightbox-close {
      top: 1rem;
      right: 1rem;
    }

    .lightbox-prev {
      left: 1rem;
    }

    .lightbox-next {
      right: 1rem;
    }

    .lightbox-content {
      max-width: 95vw;
      max-height: 95vh;
    }

    .lightbox-content img {
      max-height: 80vh;
    }

    .lightbox-counter {
      font-size: 0.75rem;
    }

    /* Specification Section */
    .specification-section {
      padding: 3rem 0;
    }

    .specification-container {
      padding: 0 1rem;
    }

    .specification-header {
      margin-bottom: 2rem;
    }

    .specification-title {
      font-size: 1.75rem;
    }

    .specification-content {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .specification-image {
      order: 2;
    }

    .specification-3d-viewer {
      height: 400px;
      order: 1;
    }

    .model-switch-buttons {
      top: 10px;
      right: 10px;
      gap: 0.25rem;
    }

    .model-switch-btn {
      padding: 0.4rem 0.75rem;
      font-size: 0.65rem;
    }

    .viewer-controls {
      bottom: 10px;
      padding: 0.5rem 0.875rem;
      font-size: 0.75rem;
    }

    .control-btn {
      width: 32px;
      height: 32px;
    }

    .specification-table {
      order: 2;
    }

    .table-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      padding: 1rem 1rem;
    }

    .table-cell-title {
      font-size: 0.85rem;
      padding-left: 0;
    }

    .table-cell {
      font-size: 0.9rem;
      padding-left: 0;
    }

    /* Reviews Section */
    .reviews-section {
      padding: 3rem 0;
    }

    .reviews-container {
      padding: 0 1rem;
    }

    .reviews-header {
      margin-bottom: 2rem;
    }

    .reviews-title {
      font-size: 1.75rem;
    }

    .reviews-summary {
      flex-direction: column;
      gap: 1.5rem;
      padding: 1.5rem;
    }

    .rating-score {
      font-size: 2.5rem;
    }

    .btn-write-review {
      width: 100%;
    }

    .review-item {
      padding: 1.5rem;
    }

    .review-header {
      flex-direction: column;
      gap: 1rem;
    }

    .review-modal-content {
      padding: 1.25rem;
      margin: 0.5rem;
      max-height: 85vh;
    }

    .review-modal-close {
      top: 1rem;
      right: 1rem;
      width: 32px;
      height: 32px;
      font-size: 1.25rem;
    }

    .review-modal-title {
      font-size: 1.5rem;
      margin: 0 0 1.25rem 0;
    }

    .review-form {
      gap: 1rem;
    }

    .form-group {
      gap: 0.5rem;
    }

    .form-group label {
      font-size: 0.8rem;
    }

    .form-group input,
    .form-group textarea {
      padding: 0.75rem;
      font-size: 0.9rem;
    }

