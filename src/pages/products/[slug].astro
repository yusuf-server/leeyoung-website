---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import AdvantagesBar from '../../components/AdvantagesBar.astro';
import ProductFAQ from '../../components/ProductFAQ.astro';
import { getProducts, getProductReviews, getProductVariations, type WooProduct, type WooVariation, type UsageRating, type FeatureCard, type WooReview } from '../../lib/woocommerce';
import { getEnv } from '../../lib/env';

// 图片优化函数 - 直接返回原始 URL，不做修改
function optimizeImageUrl(url: string, size: 'thumbnail' | 'medium' | 'large' = 'large'): string {
  return url || '';
}

// 启用服务器端渲染
export const prerender = false;

// 获取环境变量（兼容 Cloudflare Pages）
const env = getEnv(Astro.locals);

// 获取动态路由参数
const { slug } = Astro.params;

// 获取产品数据
let product: WooProduct | null = null;
let error: string | null = null;
let reviews: WooReview[] = [];
let variations: WooVariation[] = [];

try {
  // 从 WooCommerce 获取所有产品
  const products = await getProducts({ per_page: 100, env });

  // 根据 slug 查找产品
  product = products.find((p: WooProduct) => p.slug === slug) || null;

  if (!product) {
    error = 'Product not found';
  } else {
    // 如果是可变产品，获取变体
    if (product.type === 'variable' && product.variations && product.variations.length > 0) {
      try {
        variations = await getProductVariations(product.id, env);
        console.log('Fetched variations:', variations.length);
      } catch (e) {
        console.error('Failed to fetch variations:', e);
      }
    }

    // 获取产品评论
    try {
      reviews = await getProductReviews(product.id, {
        per_page: 50,
        orderby: 'date',
        order: 'desc',
        env,
      });

      console.log('Fetched reviews:', reviews.length);

      // Extract images from review content (embedded as HTML comment)
      reviews = reviews.map(review => {
        const match = review.review.match(/<!-- REVIEW_IMAGES:(.*?) -->/);
        if (match) {
          try {
            review.images = JSON.parse(match[1]);
            // Remove the image marker from review text
            review.review = review.review.replace(/\n?<!-- REVIEW_IMAGES:.*? -->/, '').trim();
            console.log(`Review ${review.id} has ${review.images.length} images`);
          } catch (e) {
            console.error('Failed to parse review images:', e);
          }
        }
        return review;
      });
    } catch (e) {
      console.error('Failed to fetch reviews:', e);
    }
  }
} catch (e) {
  console.error('Failed to fetch product:', e);
  error = 'Failed to load product';
}

// 如果没有找到产品，返回 404
if (!product) {
  return Astro.redirect('/404');
}

// 计算价格相关数据
const price = parseFloat(product.price) || 0;
const regularPrice = parseFloat(product.regular_price) || 0;
const salePrice = parseFloat(product.sale_price) || 0;
const onSale = product.on_sale && salePrice > 0;
const discount = onSale && regularPrice > 0
  ? Math.round((1 - price / regularPrice) * 100)
  : 0;

// 获取产品图片
const images = product.images || [];
const mainImage = images.length > 0 ? images[0].src : 'https://via.placeholder.com/800x800';

// 获取产品分类
const category = product.categories && product.categories.length > 0
  ? product.categories[0]
  : null;

// 获取评分
const rating = parseFloat(product.average_rating) || 0;
const ratingCount = product.rating_count || 0;

// 从自定义字段中获取使用场景评级
const getMetaValue = (key: string) => {
  const meta = product?.meta_data?.find((m) => m.key === key);
  return meta?.value;
};

// 获取使用场景评级数据（JSON格式）
let usageRatings: UsageRating[] = [];
try {
  const ratingsJson = getMetaValue('usage_ratings');
  if (ratingsJson) {
    usageRatings = typeof ratingsJson === 'string' ? JSON.parse(ratingsJson) : ratingsJson;
  }
} catch (e) {
  console.error('Failed to parse usage_ratings:', e);
}

// 获取产品特点列表（可选）
let productFeatures: string[] = [];
try {
  const featuresJson = getMetaValue('product_features');
  if (featuresJson) {
    productFeatures = typeof featuresJson === 'string' ? JSON.parse(featuresJson) : featuresJson;
  }
} catch (e) {
  console.error('Failed to parse product_features:', e);
}

// 如果没有自定义特点，使用默认的假数据
if (productFeatures.length === 0) {
  productFeatures = [
    'Premium Quality',
    'Fast Shipping',
    'Eco-Friendly',
    '30-Day Return',
    'Made in USA',
    'Handcrafted',
    'Limited Edition'
  ];
}

// 获取描述区块标题（可选，默认为"Purpose & Design"）
const descriptionTitle = getMetaValue('description_title') || 'Purpose & Design';

// 获取特性卡片数据
let featureCards: FeatureCard[] = [];
try {
  const cardsJson = getMetaValue('feature_cards');
  if (cardsJson) {
    featureCards = typeof cardsJson === 'string' ? JSON.parse(cardsJson) : cardsJson;
  }
} catch (e) {
  console.error('Failed to parse feature_cards:', e);
}

// 如果没有自定义卡片，使用默认的示例数据
if (featureCards.length === 0) {
  featureCards = [
    {
      title: 'Wide Application',
      description: 'Road-OFF creates its own path – between asphalt and gravel. Designed for fast riding where classic road ends. Grip and confidence on sections that are out of reach for typical road wheels.',
      image: 'https://images.unsplash.com/photo-1511994298241-608e28f14fde?w=1200&h=675&fit=crop'
    },
    {
      title: '32-55mm Tires',
      description: 'Road tire or wide gravel tire? Road-OFF works both as dynamic allroad wheels on asphalt and light gravel, as well as solid set for demanding routes. The combination of key advantages of road and gravel wheels.',
      image: 'https://images.unsplash.com/photo-1485965120184-e220f721d03e?w=1200&h=675&fit=crop'
    },
    {
      title: 'Handmade for Years',
      description: 'All our wheels are made in Poland – by hand, by an experienced team that has been building wheels for years. The best rims, hubs and spokes will not make a difference if the wheel is not built with attention to every nuance.',
      image: 'https://images.unsplash.com/photo-1486308510493-aa64833637bc?w=1200&h=675&fit=crop'
    }
  ];
}

// 获取特性区块的标题
const featuresSubheading = getMetaValue('features_subheading') || 'Discover the benefits';
const featuresTitle = getMetaValue('features_title') || 'Key Features';

// 获取Gallery图片集数据
let galleryImages: string[] = [];
try {
  const galleryJson = getMetaValue('gallery_images');
  if (galleryJson) {
    galleryImages = typeof galleryJson === 'string' ? JSON.parse(galleryJson) : galleryJson;
  }
} catch (e) {
  console.error('Failed to parse gallery_images:', e);
}

// 如果没有自定义图集，使用默认的假数据
if (galleryImages.length === 0) {
  galleryImages = [
    'https://images.unsplash.com/photo-1485965120184-e220f721d03e?w=1200&h=800&fit=crop',
    'https://images.unsplash.com/photo-1511994298241-608e28f14fde?w=1200&h=800&fit=crop',
    'https://images.unsplash.com/photo-1486308510493-aa64833637bc?w=1200&h=800&fit=crop',
    'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=1200&h=800&fit=crop',
    'https://images.unsplash.com/photo-1571068316344-75bc76f77890?w=1200&h=800&fit=crop',
    'https://images.unsplash.com/photo-1532298229144-0ec0c57515c7?w=1200&h=800&fit=crop',
    'https://images.unsplash.com/photo-1475666675596-cca2035b3d79?w=1200&h=800&fit=crop',
    'https://images.unsplash.com/photo-1505705694340-019e1e335916?w=1200&h=800&fit=crop'
  ];
}

// 获取产品规格数据
interface SpecificationRow {
  label: string;
  value: string | string[];
}

let specifications: SpecificationRow[] = [];
let specificationImage = '';
let model3dUrl = '';
let proxyModelUrl = '';
let model3dUrl2 = '';
let proxyModelUrl2 = '';
let faqs: Array<{ question: string; answer: string }> = [];
let faqImage = '';

try {
  const specsJson = getMetaValue('specifications');
  if (specsJson) {
    specifications = typeof specsJson === 'string' ? JSON.parse(specsJson) : specsJson;
  }

  specificationImage = getMetaValue('specification_image') || '';
  model3dUrl = getMetaValue('model_3d_url') || '';

  // 读取第二个 3D 模型 URL
  model3dUrl2 = getMetaValue('model_3d_url_2') || '';

  // 读取 FAQ 数据
  const faqsJson = getMetaValue('faqs');
  if (faqsJson) {
    faqs = typeof faqsJson === 'string' ? JSON.parse(faqsJson) : faqsJson;
  }

  faqImage = getMetaValue('faq_image') || '';

  // 如果有 3D 模型 URL，通过代理使用（解决 CORS 问题）
  if (model3dUrl) {
    proxyModelUrl = `/api/proxy-model?url=${encodeURIComponent(model3dUrl)}`;
  }
  if (model3dUrl2) {
    proxyModelUrl2 = `/api/proxy-model?url=${encodeURIComponent(model3dUrl2)}`;
  }
} catch (e) {
  console.error('Failed to parse specifications or faqs:', e);
}

// 如果没有自定义 FAQ，使用默认数据
if (faqs.length === 0) {
  faqs = [
    {
      question: "How easy is it to fold and store? What are the folded dimensions?",
      answer: "It folds flat in just a few seconds with a simple one-touch mechanism. Once folded, it becomes super compact and can easily slide under a bed, fit into a car trunk, or slip into tight closet spaces."
    },
    {
      question: "Does this product require assembly upon opening the box?",
      answer: "No complicated installation required! It comes ready to use right out of the box—just unfold the nose plate and extend the handle to start moving immediately."
    },
    {
      question: "Will the wheels scratch indoor wooden floors or make loud noise outdoors?",
      answer: "No. Equipped with premium, wear-resistant TPR/PU quiet wheels, it ensures smooth and whisper-quiet rolling on both indoor hardwood floors and rough outdoor surfaces like concrete or asphalt without leaving marks."
    },
    {
      question: "Do these products come with bungee cords or elastic straps?",
      answer: "Yes! Most of our folding hand trucks come equipped with strong elastic bungee straps to securely anchor your boxes or cargo during transport, preventing tipping or slipping."
    },
    {
      question: "How long does shipping take?",
      answer: "Orders are processed within 24 hours. Fast nationwide delivery typically arrives within 3-7 business days directly from our local US warehouse."
    },
    {
      question: "What is your warranty policy if a part breaks or if I'm not satisfied?",
      answer: "We stand behind our quality with a 30-day risk-free return policy and structural warranty. If you encounter any performance or quality issues, contact our support team for a hassle-free replacement or assistance."
    }
  ];
}

// 如果没有 FAQ 图片，使用产品主图
if (!faqImage && product.images && product.images.length > 0) {
  faqImage = product.images[0].src;
}

// 如果没有自定义规格，使用默认的假数据
if (specifications.length === 0) {
  specifications = [
    { label: 'Brand', value: 'LEEYOUNG' },
    { label: 'Material', value: 'Premium Steel' },
    { label: 'Load Capacity', value: '500 kg' },
    { label: 'Wheel Size', value: '8 inches' },
    { label: 'Dimensions', value: '100 x 60 x 90 cm' },
    { label: 'Weight', value: '25 kg' },
    { label: 'Color Options', value: 'Black, Gray, Blue' },
    { label: 'Assembly Required', value: 'Yes' },
    { label: 'Warranty', value: '2 years manufacturer warranty' },
    { label: 'Certification', value: 'ISO 9001' }
  ];
  specificationImage = 'https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=800&h=600&fit=crop';
}
---

<BaseLayout
  title={`${product.name} - LEEYOUNG`}
  description={product.short_description || product.description}
>
  <!-- Preload gallery images -->
  <link slot="head" rel="preconnect" href={new URL(galleryImages[0] || '').origin} />
  {galleryImages.slice(0, 4).map((imageUrl) => (
    <link slot="head" rel="preload" as="image" href={optimizeImageUrl(imageUrl, 'medium')} />
  ))}

  <Header />

  <!-- Breadcrumbs -->
  <section class="breadcrumbs-section" data-product="breadcrumbs">
    <div class="breadcrumbs-container">
      <ul class="breadcrumbs-list">
        <li><a href="/">Home</a></li>
        <li><a href="/shop">Shop</a></li>
        {category && <li><a href={`/shop?category=${category.id}`}>{category.name}</a></li>}
        <li>{product.name}</li>
      </ul>
    </div>
  </section>

  <!-- Product Section -->
  <section class="product-section">
    <div class="product-container">

      <!-- Product Gallery (Left Column) -->
      <div class="product-gallery" data-product="gallery">

        <!-- Thumbnail Gallery (Left Side) -->
        {images.length > 1 && (
          <div class="gallery-thumbnails">
            {images.map((image, index) => (
              <div
                class={`thumbnail-item ${index === 0 ? 'active' : ''}`}
                data-thumbnail={index}
              >
                <img
                  src={optimizeImageUrl(image.src, 'thumbnail')}
                  alt={product.name}
                  loading={index < 4 ? 'eager' : 'lazy'}
                />
              </div>
            ))}
          </div>
        )}

        <!-- Main Image (Right Side) -->
        <div class="gallery-main">
          <img
            src={optimizeImageUrl(mainImage, 'large')}
            alt={product.name}
            class="gallery-main-image"
            data-main-image
            loading="eager"
            fetchpriority="high"
          />

          <!-- 桌面端左右切换箭头 -->
          {images.length > 1 && (
            <>
              <button class="gallery-arrow gallery-arrow-prev" data-gallery-prev aria-label="上一张">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M15 18l-6-6 6-6"></path>
                </svg>
              </button>
              <button class="gallery-arrow gallery-arrow-next" data-gallery-next aria-label="下一张">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M9 18l6-6-6-6"></path>
                </svg>
              </button>
            </>
          )}

          <!-- 放大预览窗口 (桌面端) -->
          <div class="zoom-preview" data-zoom-preview>
            <img src={mainImage} alt={product.name} data-zoom-image />
          </div>

          <!-- 手机端放大图标 -->
          <button class="zoom-icon-mobile" data-lightbox-trigger aria-label="放大图片">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </button>

          {onSale && (
            <span class="product-badge-sale">-{discount}%</span>
          )}

          {product.featured && !onSale && (
            <span class="product-badge-featured">FEATURED</span>
          )}

          <!-- 图片计数器和进度条 (仅手机端显示) -->
          {images.length > 1 && (
            <div class="gallery-indicator">
              <div class="gallery-counter">
                <span class="current-index">1</span>/<span class="total-images">{images.length}</span>
              </div>
              <div class="gallery-progress-bar">
                <div class="gallery-progress-fill" style="width: 100%"></div>
              </div>
            </div>
          )}
        </div>

      </div>

      <!-- Product Info (Right Column) -->
      <div class="product-info" data-product="info">

        <!-- Product Badges -->
        {(product.featured || onSale) && (
          <div class="product-badges">
            {onSale && (
              <span class="badge badge-sale">SALE -{discount}%</span>
            )}
            {product.featured && !onSale && (
              <span class="badge badge-featured">FEATURED</span>
            )}
          </div>
        )}

        <!-- Product Title -->
        <h1 class="product-title" data-product="title">
          {product.name}
          <span class="brand-badge">
            <span class="badge-text">LEEYOUNG</span>
            <span class="badge-shine"></span>
          </span>
        </h1>

        <!-- Price -->
        <div class="product-price-section" data-product="price">
          {onSale ? (
            <div class="price-wrapper">
              <span class="price-sale">${price.toFixed(2)}</span>
              <span class="price-regular">${regularPrice.toFixed(2)}</span>
            </div>
          ) : (
            <span class="price-current">${price.toFixed(2)}</span>
          )}
        </div>

        <!-- Rating -->
        {ratingCount > 0 && (
          <div class="product-rating">
            <div class="rating-stars">
              {Array.from({ length: 5 }).map((_, i) => (
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill={i < Math.floor(rating) ? 'currentColor' : 'none'}
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              ))}
            </div>
            <span class="rating-count">({ratingCount} reviews)</span>
          </div>
        )}

        <!-- Key Features -->
        <div class="product-features">
          <div class="features-grid collapsed" data-features-grid>
            <!-- 3D Model Badge - Only show if model exists -->
            {proxyModelUrl && (
              <a href="#specification" class="feature-3d-badge">
                <svg class="badge-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                  <line x1="12" y1="22.08" x2="12" y2="12"></line>
                </svg>
                <span class="badge-text">View 3D</span>
                <svg class="badge-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="7 13 12 18 17 13"></polyline>
                  <line x1="12" y1="18" x2="12" y2="6"></line>
                </svg>
              </a>
            )}

            {productFeatures.map((feature, index) => (
              <div class="feature-item" data-feature-index={index}>
                <svg class="feature-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span class="feature-text">{feature}</span>
              </div>
            ))}
            {productFeatures.length > 5 && (
              <button class="features-toggle" data-features-toggle>
                <span data-toggle-text>Show All</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
            )}
          </div>
        </div>

        <hr class="product-separator" />

        <!-- Stock Status - Removed -->

        <!-- Product Variations (for variable products) -->
        {product.type === 'variable' && product.attributes && product.attributes.length > 0 && (
          <>
            {/* 隐藏的 div 存储颜色映射数据 */}
            <div
              style="display: none;"
              data-color-mapping={getMetaValue('color_mapping') || '{}'}
            ></div>

            <div class="product-variations" data-variations={JSON.stringify(variations)}>
              {product.attributes
                .filter(attr => attr.variation)
                .map((attribute) => {
                  const isColorAttribute = attribute.name.toLowerCase().includes('color') || attribute.name.toLowerCase().includes('colour');

                  return (
                    <div class="variation-group">
                      <label class="variation-label">
                        {attribute.name}: <span class="selected-value" data-attribute-label={attribute.name}></span>
                      </label>
                      <div class={`variation-options ${isColorAttribute ? 'variation-colors' : ''}`}>
                        {attribute.options.map((option) => (
                          isColorAttribute ? (
                            <button
                              class="variation-color"
                              data-attribute={attribute.name}
                              data-value={option}
                              data-color-name={option}
                              type="button"
                              title={option}
                            >
                              <span class="color-name">{option}</span>
                            </button>
                          ) : (
                            <button
                              class="variation-option"
                              data-attribute={attribute.name}
                              data-value={option}
                              type="button"
                            >
                              {option}
                            </button>
                          )
                        ))}
                      </div>
                    </div>
                  );
                })}
            </div>
          </>
        )}

        <!-- Quantity & Add to Cart -->
        <div class="product-actions">
          <div class="quantity-selector">
            <button class="qty-btn qty-decrease" data-qty="decrease">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </button>
            <input
              type="number"
              class="qty-input"
              value="1"
              min="1"
              max="99"
              data-qty-input
            />
            <button class="qty-btn qty-increase" data-qty="increase">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
            </button>
          </div>

          <button class="add-to-cart-btn" data-product-id={product.id}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="9" cy="21" r="1"/>
              <circle cx="20" cy="21" r="1"/>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
            </svg>
            <span>ADD TO CART</span>
          </button>
        </div>

        <hr class="product-separator" />

        <!-- Info Icons -->
        <div class="product-info-icons">
          <div class="info-icon-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
            <div class="info-icon-text">
              <strong>Fast Shipping</strong>
              <span>2-3 business days</span>
            </div>
          </div>

          <div class="info-icon-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
