    }

    .rating-input {
      gap: 0.35rem;
    }

    .rating-star svg {
      width: 28px;
      height: 28px;
    }

    .form-hint {
      font-size: 0.75rem;
      margin: 0.25rem 0 0 0;
    }

    .media-preview {
      grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
      gap: 0.5rem;
      margin-top: 0.5rem;
    }

    .form-actions {
      flex-direction: column;
      margin-top: 0.5rem;
      gap: 0.75rem;
    }

    .btn-cancel,
    .btn-submit {
      width: 100%;
      padding: 0.875rem 1.5rem;
      font-size: 0.85rem;
    }
