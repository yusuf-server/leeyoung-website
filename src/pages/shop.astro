---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getProducts, getProductCategories, getProductTags, getProductVariations, type WooProduct, type WooCategory, type WooTag } from '../lib/woocommerce';
import { getEnv } from '../lib/env';

// 获取环境变量（兼容 Cloudflare Pages）
const env = getEnv(Astro.locals);

// 从 URL 获取分类参数
const categorySlug = Astro.url.searchParams.get('category');

// 获取初始产品数据（第一页）
let products: WooProduct[] = [];
let categories: WooCategory[] = [];
let tags: WooTag[] = [];
let error: string | null = null;
let totalProducts = 0;
let totalPages = 0;
let allProductsCount = 0; // 所有产品的总数
const perPage = 12;
let maxPrice = 500; // 默认值

// 存储每个产品的变体信息
const productVariations: Record<number, any[]> = {};

try {
  // 获取所有分类
  categories = await getProductCategories({
    per_page: 100,
    parent: 0, // 只获取顶级分类
    env,
  });

  // 获取所有产品标签（用于 Material 过滤）
  tags = await getProductTags({
    per_page: 100,
    env,
  });

  // 根据分类 slug 查找分类 ID
  let categoryId: string | undefined = undefined;
  if (categorySlug) {
    const matchedCategory = categories.find(cat => cat.slug === categorySlug);
    if (matchedCategory) {
      categoryId = matchedCategory.id.toString();
    }
  }

  // 构建产品查询参数
  const productParams: any = {
    per_page: perPage,
    page: 1,
    orderby: 'date',
    order: 'desc',
    env,
  };

  // 如果有分类 ID，添加到查询参数
  if (categoryId) {
    productParams.category = categoryId;
  }

  // 获取产品（第一页，12个产品）
  products = await getProducts(productParams);

  // 获取每个可变产品的变体
  for (const product of products) {
    if (product.type === 'variable') {
      try {
        const variations = await getProductVariations(product.id, env);
        productVariations[product.id] = variations;
      } catch (e) {
        console.error(`Failed to fetch variations for product ${product.id}:`, e);
        productVariations[product.id] = [];
      }
    }
  }

  // 获取所有产品以计算总数（不应用分类过滤，获取全部产品数量）
  const allProductsForCount = await getProducts({ per_page: 100, env });
  allProductsCount = allProductsForCount.length;

  // 获取当前分类的产品以计算最高价格和分页
  const allProductsParams: any = { per_page: 100, env };
  if (categoryId) {
    allProductsParams.category = categoryId;
  }
  const allProducts = await getProducts(allProductsParams);
  totalProducts = allProducts.length;
  totalPages = Math.ceil(totalProducts / perPage);

  // 计算最高价格
  if (allProducts.length > 0) {
    const prices = allProducts.map((p: WooProduct) => parseFloat(p.price) || 0);
    maxPrice = Math.ceil(Math.max(...prices)); // 向上取整
  }

} catch (e) {
  console.error('Failed to fetch WooCommerce data:', e);
  error = 'Failed to load products. Please try again later.';
}
---

<BaseLayout title="Shop - LEEYOUNG Hand Trucks" description="Browse our complete collection of premium hand trucks and material handling equipment">
  <Header />

  <!-- Hero Banner -->
  <section class="shop-hero" data-shop="hero">
    <!-- Floating Product Images Background -->
    <div class="floating-images">
      {products && products.length > 0 ? (
        products.slice(0, 4).map((product, index) => {
          const imageSrc = product.images && product.images.length > 0 ? product.images[0].src : null;
          if (!imageSrc) return null;

          const positions = [
            { left: '10%', top: '25%' },    // 左上
            { left: '80%', top: '20%' },   // 右上
            { left: '10%', top: '70%' },   // 左下
            { left: '75%', top: '75%' }    // 右下
          ];

          return (
            <div
              class="floating-image"
              data-floating-image={index}
              style={`left: ${positions[index].left}; top: ${positions[index].top};`}
            >
              <img
                src={imageSrc}
                alt={product.name}
                loading="eager"
                decoding="async"
              />
            </div>
          );
        })
      ) : (
        <div style="display:none;">No products available for floating images</div>
      )}
    </div>

    <div class="hero-content">
      <nav class="breadcrumb" data-shop="breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <span>Shop</span>
      </nav>
      <h1 class="hero-title" data-shop="title">SHOP ALL PRODUCTS</h1>
      <p class="hero-subtitle" data-shop="subtitle">Premium hand trucks and material handling equipment</p>
    </div>
  </section>

  {error ? (
    <section class="shop-error">
      <div class="error-content">
        <p>{error}</p>
      </div>
    </section>
  ) : (
  <!-- Main Shop Section -->
  <section class="shop-main">
    <div class="shop-container">

      <!-- Sidebar Filters -->
      <aside class="shop-sidebar" data-shop="sidebar">
        <!-- Mobile Drawer Header -->
        <div class="drawer-header">
          <h3>Filters</h3>
          <button class="drawer-close" data-mobile="close-btn">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="18" y1="6" x2="6" y2="18"/>
              <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>

        <div class="filter-section" data-filter="section">
          <h3 class="filter-title">CATEGORIES</h3>
          <ul class="filter-list">
            <li class="filter-item">
              <button class="filter-button active" data-category="all">
                <span>All Products</span>
                <span class="filter-count">({allProductsCount})</span>
              </button>
            </li>
            {categories.map((category) => (
              <li class="filter-item">
                <button class="filter-button" data-category={category.slug} data-category-id={category.id}>
                  <span>{category.name}</span>
                  <span class="filter-count">({category.count})</span>
                </button>
              </li>
            ))}
          </ul>
        </div>

        <div class="filter-section" data-filter="section">
          <h3 class="filter-title">PRICE RANGE</h3>
          <div class="price-range-slider">
            <div class="price-values">
              <span class="price-value" data-price="min">$0</span>
              <span class="price-value" data-price="max">${maxPrice}</span>
            </div>
            <div class="slider-container">
              <div class="slider-track"></div>
              <div class="slider-range" data-slider-range></div>
              <input
                type="range"
                min="0"
                max={maxPrice}
                value="0"
                class="price-slider"
                data-slider="min"
              />
              <input
                type="range"
                min="0"
                max={maxPrice}
                value={maxPrice}
                class="price-slider"
                data-slider="max"
              />
            </div>
          </div>
        </div>

        <div class="filter-section" data-filter="section">
          <h3 class="filter-title">MATERIAL</h3>
          <ul class="filter-list">
            {tags && tags.length > 0 ? (
              tags.map(tag => (
                <li class="filter-item">
                  <label class="filter-checkbox">
                    <input type="checkbox" data-tag-id={tag.id} data-tag-slug={tag.slug} value={tag.slug} />
                    <span>{tag.name}</span>
                  </label>
                </li>
              ))
            ) : (
              <li class="filter-item">
                <span style="color: #999;">No materials available</span>
              </li>
            )}
          </ul>
        </div>

        <button class="reset-filters" data-filter="reset">Reset All Filters</button>

        <!-- Mobile Apply Button -->
        <button class="apply-filters-btn" data-mobile="apply-btn">Apply Filters</button>
      </aside>

      <!-- Product Grid -->
      <div class="shop-content">

        <!-- Toolbar -->
        <div class="shop-toolbar" data-shop="toolbar">
          <!-- Mobile Filter Button -->
          <button class="mobile-filter-btn" data-mobile="filter-btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="4" y1="6" x2="20" y2="6"/>
              <line x1="4" y1="12" x2="20" y2="12"/>
              <line x1="4" y1="18" x2="20" y2="18"/>
            </svg>
            <span>Filters</span>
            <span class="filter-badge">0</span>
          </button>

          <div class="toolbar-left">
            <span class="result-count">Showing {products.length} products</span>
          </div>
          <div class="toolbar-right">
            <label class="sort-label">Sort by:</label>
            <select class="sort-select">
              <option value="featured">Featured</option>
              <option value="price-low">Price: Low to High</option>
              <option value="price-high">Price: High to Low</option>
              <option value="name">Name: A to Z</option>
              <option value="newest">Newest</option>
            </select>
          </div>
        </div>

        <!-- Product Grid -->
        <div class="product-grid">
          {products.map((product) => {
            const image = product.images && product.images.length > 0
              ? product.images[0].src
              : 'https://via.placeholder.com/800x800?text=No+Image';

            const hoverImage = product.images && product.images.length > 1
              ? product.images[1].src
              : image; // 如果没有第二张图，使用第一张

            const badge = product.featured ? 'FEATURED' : (product.on_sale ? 'SALE' : null);
            const rating = parseFloat(product.average_rating) || 0;
            const price = parseFloat(product.price) || 0;
            const regularPrice = parseFloat(product.regular_price) || 0;

            // 检查是否有颜色属性
            const variations = productVariations[product.id] || [];
            const colorAttribute = variations.length > 0
              ? variations[0].attributes?.find(attr => attr.name.toLowerCase().includes('color') || attr.name === 'pa_color')
              : null;

            // 提取所有可用颜色及其图片
            const availableColors = colorAttribute
              ? [...new Map(variations.map(v => {
                  const attr = v.attributes.find(a => a.name === colorAttribute.name);
                  return [attr?.option, {
                    color: attr?.option,
                    image: v.image?.src || image,
                    variationId: v.id
                  }];
                }).filter(([color]) => color)).values()]
              : [];

            return (
              <div class="product-card" data-product={product.id} data-product-type={product.type}>
                <a href={`/products/${product.slug}`} class="product-link">

                  {/* Product Image */}
                  <div class="product-image-wrapper">
                    <img src={image} alt={product.name} class="product-image product-image-main" loading="lazy" />
                    <img src={hoverImage} alt={product.name} class="product-image product-image-hover" loading="lazy" />
                    {badge && (
                      <span class="product-badge">{badge}</span>
                    )}
                    {product.on_sale && product.sale_price && (
                      <span class="product-sale-badge">-{Math.round((1 - price / regularPrice) * 100)}%</span>
                    )}
                    <div class="product-overlay">
                      <button class="quick-view-btn">QUICK VIEW</button>
                    </div>
                  </div>

                  {/* Product Info */}
                  <div class="product-info">
                    <h3 class="product-name">{product.name}</h3>

                    {/* Rating */}
                    {product.rating_count > 0 && (
                      <div class="product-rating">
                        {Array.from({ length: 5 }).map((_, i) => (
                          <svg
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill={i < Math.floor(rating) ? 'currentColor' : 'none'}
                            stroke="currentColor"
                            stroke-width="2"
                          >
                            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                          </svg>
                        ))}
                        <span class="rating-text">({rating.toFixed(1)})</span>
                      </div>
                    )}

                    {/* Color Swatches - 如果有颜色属性 */}
                    {availableColors.length > 0 && (
                      <div class="product-colors" data-variations={JSON.stringify(variations)}>
                        {availableColors.map((colorData) => (
                          <button
                            class="color-swatch"
                            data-color={colorData.color}
                            data-variation-id={colorData.variationId}
                            data-image={colorData.image}
                            title={colorData.color}
                            aria-label={`Select ${colorData.color}`}
                          >
                            <img src={colorData.image} alt={colorData.color} class="color-image" />
                          </button>
                        ))}
                      </div>
                    )}

                    <div class="product-price-wrapper">
                      {product.on_sale && product.sale_price ? (
                        <>
                          <p class="product-price product-sale-price">${price.toFixed(2)}</p>
                          <p class="product-regular-price">${regularPrice.toFixed(2)}</p>
                        </>
                      ) : (
                        <p class="product-price">${price.toFixed(2)}</p>
                      )}
                    </div>
                  </div>
                </a>

                {/* Add to Cart Button */}
                <button
                  class="add-to-cart-btn"
                  data-product-id={product.id}
                  data-has-colors={availableColors.length > 0 ? 'true' : 'false'}
                  disabled={availableColors.length > 0}
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="9" cy="21" r="1"/>
                    <circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                  </svg>
                  <span>{availableColors.length > 0 ? 'SELECT COLOR' : 'ADD TO CART'}</span>
                </button>
              </div>
            );
          })}
        </div>

        {/* Pagination */}
        {/* Pagination - 只在有多页时显示 */}
        {totalPages > 1 && (
        <div class="pagination" data-shop="pagination">
          <button class="page-btn page-prev" disabled>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M15 18l-6-6 6-6"/>
            </svg>
          </button>
          {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => (
            <button class={`page-btn page-number ${pageNum === 1 ? 'active' : ''}`} data-page={pageNum}>
              {pageNum}
            </button>
          ))}
          <button class="page-btn page-next" disabled={totalPages <= 1}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </button>
        </div>
        )}

      </div>
    </div>
  </section>
  )}

  <!-- Mobile Drawer Overlay -->
  <div class="drawer-overlay" data-mobile="overlay"></div>

  <Footer />
</BaseLayout>

<script define:vars={{ maxPrice }}>
  // 将 maxPrice 传递到全局作用域
  window.__SHOP_MAX_PRICE__ = maxPrice;
</script>

<script>
  import { gsap } from '../lib/gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';

  // ==================== 全局状态 ====================
  // 从服务端获取最大价格
  const maxPrice = window.__SHOP_MAX_PRICE__ || 500;

  // 从 URL 参数中读取初始分类 slug
  const urlParams = new URLSearchParams(window.location.search);
  const initialCategorySlug = urlParams.get('category') || 'all';

  let currentFilters = {
    category: 'all',
    categorySlug: initialCategorySlug,
    tags: [] as string[], // 添加 tags 数组用于存储选中的标签
    minPrice: 0,
    maxPrice: maxPrice,
    page: 1,
    perPage: 12,
    orderby: 'featured',
  };

  let allProducts: any[] = [];
  let currentPage = 1;
  let totalPages = 3;

  // ==================== Hero 入场动画 ====================
  const heroTL = gsap.timeline({
    defaults: { ease: 'power3.out' }
  });

  // Breadcrumb 动画
  heroTL.from('[data-shop="breadcrumb"]', {
    y: -30,
    opacity: 0,
    duration: 0.6,
  });

  // Title SplitText 字符动画
  const titleSplit = SplitText.create('[data-shop="title"]', {
    type: 'chars',
    charsClass: 'shop-title-char'
  });

  heroTL.from(titleSplit.chars, {
    y: 100,
    opacity: 0,
    rotationX: -90,
    stagger: 0.02,
    duration: 0.8,
    ease: 'back.out(1.7)',
  }, '-=0.3');

  // Subtitle 动画
  heroTL.from('[data-shop="subtitle"]', {
    y: 30,
    opacity: 0,
    duration: 0.6,
  }, '-=0.4');

  // Sidebar 过滤器 stagger 动画（仅桌面端）
  if (window.innerWidth > 768) {
    gsap.from('[data-filter="section"]', {
      scrollTrigger: {
        trigger: '[data-shop="sidebar"]',
        start: 'top 80%',
        toggleActions: 'play none none reverse',
      },
      x: -50,
      opacity: 0,
      stagger: 0.15,
      duration: 0.8,
      ease: 'power2.out',
    });

    // Reset button 动画（仅桌面端）
    gsap.from('[data-filter="reset"]', {
      scrollTrigger: {
        trigger: '[data-shop="sidebar"]',
        start: 'top 80%',
        toggleActions: 'play none none reverse',
      },
      y: 30,
      opacity: 0,
      duration: 0.6,
      delay: 0.6,
      ease: 'power2.out',
    });
  } else {
    // 移动端：初始隐藏 filter sections，等待 drawer 打开时显示
    gsap.set('[data-filter="section"]', { opacity: 0, y: 20 });
    gsap.set('[data-filter="reset"]', { opacity: 0, y: 10 });
  }

  // Toolbar 动画
  // ==================== Hero 浮动图片动画 ====================
  const floatingImages = document.querySelectorAll('[data-floating-image]');

  console.log('Found floating images:', floatingImages.length);

  floatingImages.forEach((image, index) => {
    // 每个图片有不同的浮动参数
    const duration = 3 + (index * 0.5); // 3s, 3.5s, 4s, 4.5s
    const yOffset = 30 + (index * 10); // 30px, 40px, 50px, 60px
    const rotation = index % 2 === 0 ? 5 : -5; // 交替旋转方向

    // 立即设置初始可见性（更高透明度）
    gsap.set(image, { opacity: 0.8, scale: 1 });

    // 上下浮动动画
    gsap.to(image, {
      y: `+=${yOffset}`,
      rotation: rotation,
      duration: duration,
      ease: 'power1.inOut',
      yoyo: true,
      repeat: -1,
      delay: index * 0.3,
    });

    // 入场动画（从 0.8 缩放开始，更平滑）
    gsap.from(image, {
      scale: 0.8,
      opacity: 0,
      duration: 1,
      delay: 0.3 + (index * 0.15),
      ease: 'power2.out',
    });
  });

  // Hero 文字动画
  gsap.from('[data-shop="breadcrumb"]', {
    y: -20,
    opacity: 0,
    duration: 0.8,
    ease: 'power2.out',
  });

  gsap.from('[data-shop="title"]', {
    y: 30,
    opacity: 0,
    duration: 1,
    delay: 0.2,
    ease: 'power2.out',
  });

  gsap.from('[data-shop="subtitle"]', {
    y: 20,
    opacity: 0,
    duration: 0.8,
    delay: 0.4,
    ease: 'power2.out',
  });

  // ==================== 其他动画 ====================

  gsap.from('[data-shop="toolbar"]', {
    scrollTrigger: {
      trigger: '[data-shop="toolbar"]',
      start: 'top 85%',
      toggleActions: 'play none none reverse',
    },
    y: 30,
    opacity: 0,
    duration: 0.6,
    ease: 'power2.out',
  });

  // 产品卡片入场动画（直接显示，不需要滚动触发）
  gsap.from('[data-product]', {
    y: 30,
    opacity: 0,
    stagger: 0.05,
    duration: 0.6,
    delay: 0.8,
    ease: 'power2.out',
    clearProps: 'all', // 动画完成后清除所有属性
  });

  // 产品卡片悬停效果 - GSAP Timeline
  const productCards = document.querySelectorAll('[data-product]');

  productCards.forEach((card) => {
    const image = card.querySelector('.product-image');
    const badge = card.querySelector('.product-badge');
    const overlay = card.querySelector('.product-overlay');
    const quickViewBtn = card.querySelector('.quick-view-btn');
    const addToCartBtn = card.querySelector('.add-to-cart-btn');
    const productName = card.querySelector('.product-name');

    // 悬停进入动画（移除了图片 scale 动画）
    const hoverTL = gsap.timeline({ paused: true });

    hoverTL
      .to(overlay, {
        opacity: 1,
        duration: 0.4,
      }, 0)
      .from(quickViewBtn, {
        scale: 0.8,
        opacity: 0,
        duration: 0.4,
        ease: 'back.out(2)',
      }, 0.2);

    if (badge) {
      hoverTL.to(badge, {
        rotation: 5,
        scale: 1.1,
        duration: 0.3,
        ease: 'back.out(2)',
      }, 0);
    }

    // Add to cart 按钮悬停动画
    const btnHoverTL = gsap.timeline({ paused: true });
    btnHoverTL.to(addToCartBtn, {
      scale: 1.05,
      duration: 0.3,
      ease: 'back.out(2)',
    });

    card.addEventListener('mouseenter', () => hoverTL.play());
    card.addEventListener('mouseleave', () => hoverTL.reverse());

    addToCartBtn.addEventListener('mouseenter', () => btnHoverTL.play());
    addToCartBtn.addEventListener('mouseleave', () => btnHoverTL.reverse());
  });

  // Pagination 动画
  gsap.from('[data-shop="pagination"]', {
    scrollTrigger: {
      trigger: '[data-shop="pagination"]',
      start: 'top 90%',
      toggleActions: 'play none none reverse',
    },
    y: 30,
    opacity: 0,
    duration: 0.6,
    ease: 'power2.out',
  });

  // 分页按钮悬停效果
  const pageButtons = document.querySelectorAll('.page-btn:not(:disabled)');

  pageButtons.forEach((btn) => {
    const btnTL = gsap.timeline({ paused: true });
    btnTL.to(btn, {
      y: -3,
      duration: 0.3,
      ease: 'power2.out',
    });

    btn.addEventListener('mouseenter', () => btnTL.play());
    btn.addEventListener('mouseleave', () => btnTL.reverse());
  });

  // Filter button 点击动画
  const filterButtons = document.querySelectorAll('.filter-button');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      // 移除其他按钮的 active 类
      filterButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      // 点击动画
      gsap.fromTo(btn,
        { scale: 0.95 },
        { scale: 1, duration: 0.3, ease: 'back.out(2)' }
      );
    });
  });

  // Reset filters 按钮点击动画
  const resetBtn = document.querySelector('[data-filter="reset"]');
  if (resetBtn) {
    resetBtn.addEventListener('click', () => {
      gsap.fromTo(resetBtn,
        { scale: 0.95 },
        { scale: 1, duration: 0.3, ease: 'back.out(2)' }
      );

      // 重置所有过滤器复选框
      document.querySelectorAll('.filter-checkbox input').forEach(cb => {
        cb.checked = false;
      });

      // 重置分类按钮 - 激活 "All Products"
      filterButtons.forEach(b => b.classList.remove('active'));
      const allProductsBtn = document.querySelector('[data-category="all"]');
      if (allProductsBtn) {
        allProductsBtn.classList.add('active');
      }

      // 重置 currentFilters 对象
      currentFilters.category = 'all';
      currentFilters.categorySlug = 'all';
      currentFilters.tags = [];
      currentFilters.minPrice = 0;
      currentFilters.maxPrice = parseInt(maxSlider?.max || '500');
      currentFilters.page = 1;

      // 重置价格滑动条
      if (minSlider && maxSlider && minPriceDisplay && maxPriceDisplay && sliderRange) {
        minSlider.value = '0';
        maxSlider.value = maxSlider.max;
        minPriceDisplay.textContent = `$0`;
        maxPriceDisplay.textContent = `$${maxSlider.max}`;

        // 更新滑动范围可视化
        sliderRange.style.left = '0%';
        sliderRange.style.width = '100%';
      }

      // 更新 URL - 移除 category 参数
      const url = new URL(window.location.href);
      url.searchParams.delete('category');
      window.history.pushState({}, '', url);

      console.log('重置所有筛选条件');

      // 更新 badge 计数
      updateFilterBadge();

      // 重新加载产品
      loadProducts();

      // 检查是否在移动端 drawer 中
      const sidebar = document.querySelector('[data-shop="sidebar"]');
      const isMobileDrawerOpen = sidebar?.classList.contains('drawer-open');

      if (isMobileDrawerOpen) {
        // 移动端：关闭 drawer
        closeDrawer();
      } else {
        // 桌面端：重新触发产品卡片动画
        gsap.fromTo('[data-product]',
          { scale: 0.9, opacity: 0 },
          { scale: 1, opacity: 1, stagger: 0.05, duration: 0.5, ease: 'power2.out' }
        );
      }
    });
  }

  // ==================== Mobile Drawer 功能 ====================
  const filterBtn = document.querySelector('[data-mobile="filter-btn"]');
  const closeBtn = document.querySelector('[data-mobile="close-btn"]');
  const applyBtn = document.querySelector('[data-mobile="apply-btn"]');
  const overlay = document.querySelector('[data-mobile="overlay"]');
  const sidebar = document.querySelector('[data-shop="sidebar"]');
  const filterBadge = document.querySelector('.filter-badge');

  // 打开 Drawer
  function openDrawer() {
    // 显示 overlay 和 sidebar
    overlay.style.display = 'block';
    sidebar.classList.add('drawer-open');
    document.body.style.overflow = 'hidden';

    // 获取所有 filter sections
    const filterSections = sidebar.querySelectorAll('[data-filter="section"]');
    const resetBtn = sidebar.querySelector('[data-filter="reset"]');

    // GSAP 动画
    const drawerTL = gsap.timeline();

    drawerTL
      .to(overlay, {
        opacity: 1,
        duration: 0.3,
      })
      .to(sidebar, {
        y: 0,
        duration: 0.4,
        ease: 'power2.out',
      }, '-=0.2')
      // 在 drawer 打开后，立即显示 filter sections
      .fromTo(filterSections,
        { opacity: 0, y: 20 },
        {
          opacity: 1,
          y: 0,
          stagger: 0.1,
          duration: 0.3,
          ease: 'power2.out'
        },
        '-=0.1'
      )
      .fromTo(resetBtn,
        { opacity: 0, y: 10 },
        {
          opacity: 1,
          y: 0,
          duration: 0.3,
          ease: 'power2.out'
        },
        '-=0.2'
      );
  }

  // 关闭 Drawer
  function closeDrawer() {
    const drawerTL = gsap.timeline({
      onComplete: () => {
        overlay.style.display = 'none';
        sidebar.classList.remove('drawer-open');
        document.body.style.overflow = '';
      }
    });

    drawerTL
      .to(sidebar, {
        y: '100%',
        duration: 0.3,
        ease: 'power2.in',
      })
      .to(overlay, {
        opacity: 0,
        duration: 0.2,
      }, '-=0.1');
  }

  // 更新 filter badge 计数
  function updateFilterBadge() {
    const activeFilters = document.querySelectorAll('.filter-button.active');
    const checkedBoxes = document.querySelectorAll('.filter-checkbox input:checked');
    const count = activeFilters.length + checkedBoxes.length;

    if (filterBadge) {
      filterBadge.textContent = count;
      filterBadge.style.display = count > 0 ? 'flex' : 'none';
    }
  }

  // 事件监听
  if (filterBtn) {
    filterBtn.addEventListener('click', openDrawer);
  }

  if (closeBtn) {
    closeBtn.addEventListener('click', closeDrawer);
  }

  if (applyBtn) {
    applyBtn.addEventListener('click', () => {
      console.log('应用筛选条件，当前标签:', currentFilters.tags);

      updateFilterBadge();

      // 应用筛选 - 重新加载产品
      loadProducts();

      closeDrawer();

      // 重新触发产品卡片动画
      gsap.fromTo('[data-product]',
        { scale: 0.9, opacity: 0 },
        { scale: 1, opacity: 1, stagger: 0.05, duration: 0.5, ease: 'power2.out' }
      );
    });
  }

  if (overlay) {
    overlay.addEventListener('click', closeDrawer);
  }

  // 监听 checkbox 和 filter button 变化
  document.querySelectorAll('.filter-checkbox input').forEach(checkbox => {
    checkbox.addEventListener('change', updateFilterBadge);
  });

  // 初始化 badge
  updateFilterBadge();

  // ==================== 产品加载和筛选 ====================

  // 加载产品
  async function loadProducts() {
    try {
      const params = new URLSearchParams();

      params.append('per_page', currentFilters.perPage.toString());
      params.append('page', currentFilters.page.toString());

      if (currentFilters.category && currentFilters.category !== 'all') {
        params.append('category', currentFilters.category);
      }

      // 添加标签筛选
      if (currentFilters.tags && currentFilters.tags.length > 0) {
        params.append('tag', currentFilters.tags.join(','));
      }

      if (currentFilters.minPrice > 0) {
        params.append('min_price', currentFilters.minPrice.toString());
      }

      if (currentFilters.maxPrice < maxPrice) {
        params.append('max_price', currentFilters.maxPrice.toString());
      }

      params.append('orderby', currentFilters.orderby);

      console.log('API 请求参数:', params.toString());

      const response = await fetch(`/api/products?${params.toString()}`);

      if (!response.ok) {
        throw new Error('Failed to fetch products');
      }

      const products = await response.json();

      console.log('获取到的产品数量:', products.length);

      renderProducts(products);

      // 更新产品计数
      const resultCount = document.querySelector('.result-count');
      if (resultCount) {
        resultCount.textContent = `Showing ${products.length} products`;
      }

    } catch (error) {
      console.error('Error loading products:', error);
    }
  }

  // 渲染产品
  async function renderProducts(products: any[]) {
    const productGrid = document.querySelector('.product-grid');
    if (!productGrid) return;

    console.log('开始渲染产品，产品列表:', products.map(p => ({ id: p.id, name: p.name })));

    productGrid.innerHTML = '';

    // 为每个产品获取变体数据
    for (const product of products) {
      const image = product.images && product.images.length > 0
        ? product.images[0].src
        : 'https://via.placeholder.com/800x800?text=No+Image';

      const hoverImage = product.images && product.images.length > 1
        ? product.images[1].src
        : image;

      const badge = product.featured ? 'FEATURED' : (product.on_sale ? 'SALE' : '');
      const rating = parseFloat(product.average_rating) || 0;
      const price = parseFloat(product.price) || 0;
      const regularPrice = parseFloat(product.regular_price) || 0;
      const discount = product.on_sale && regularPrice > 0
        ? Math.round((1 - price / regularPrice) * 100)
        : 0;

      // 获取变体数据（如果是可变产品）
      let variations = [];
      let availableColors = [];
      if (product.type === 'variable') {
        try {
          const varResponse = await fetch(`/api/products/${product.id}/variations`);
          if (varResponse.ok) {
            variations = await varResponse.json();

            // 提取颜色变体
            const colorAttribute = variations.length > 0
              ? variations[0].attributes?.find(attr =>
                  attr.name.toLowerCase().includes('color') || attr.name === 'pa_color'
                )
              : null;

            if (colorAttribute) {
              const colorMap = new Map();
              variations.forEach(v => {
                const attr = v.attributes.find(a => a.name === colorAttribute.name);
                if (attr && attr.option) {
                  colorMap.set(attr.option, {
                    color: attr.option,
                    image: v.image?.src || image,
                    variationId: v.id
                  });
                }
              });
              availableColors = Array.from(colorMap.values());
            }
          }
        } catch (e) {
          console.error('Failed to fetch variations:', e);
        }
      }

      const productCard = document.createElement('div');
      productCard.className = 'product-card';
      productCard.setAttribute('data-product', product.id.toString());
      productCard.setAttribute('data-product-type', product.type);

      // 构建颜色选择器 HTML
      let colorsHTML = '';
      if (availableColors.length > 0) {
        colorsHTML = `<div class="product-colors" data-variations='${JSON.stringify(variations)}'>${availableColors.map(colorData => `<button class="color-swatch" data-color="${colorData.color}" data-variation-id="${colorData.variationId}" data-image="${colorData.image}" title="${colorData.color}" aria-label="Select ${colorData.color}"><img src="${colorData.image}" alt="${colorData.color}" class="color-image" /></button>`).join('')}</div>`;
      }

      productCard.innerHTML = `<a href="/products/${product.slug}" class="product-link"><div class="product-image-wrapper"><img src="${image}" alt="${product.name}" class="product-image product-image-main" loading="lazy" /><img src="${hoverImage}" alt="${product.name}" class="product-image product-image-hover" loading="lazy" />${badge ? `<span class="product-badge">${badge}</span>` : ''}${discount > 0 ? `<span class="product-sale-badge">-${discount}%</span>` : ''}<div class="product-overlay"><button class="quick-view-btn">QUICK VIEW</button></div></div><div class="product-info"><h3 class="product-name">${product.name}</h3>${product.rating_count > 0 ? `<div class="product-rating">${Array.from({ length: 5 }).map((_, i) => `<svg width="14" height="14" viewBox="0 0 24 24" fill="${i < Math.floor(rating) ? 'currentColor' : 'none'}" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>`).join('')}<span class="rating-text">(${rating.toFixed(1)})</span></div>` : ''}${colorsHTML}<div class="product-price-wrapper">${product.on_sale && product.sale_price ? `<p class="product-price product-sale-price">$${price.toFixed(2)}</p><p class="product-regular-price">$${regularPrice.toFixed(2)}</p>` : `<p class="product-price">$${price.toFixed(2)}</p>`}</div></div></a><button class="add-to-cart-btn" data-product-id="${product.id}" data-has-colors="${availableColors.length > 0 ? 'true' : 'false'}" ${availableColors.length > 0 ? 'disabled' : ''}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg><span>${availableColors.length > 0 ? 'SELECT COLOR' : 'ADD TO CART'}</span></button>`;

      productGrid.appendChild(productCard);
    }

    // 重新应用 GSAP 动画和悬停效果
    applyProductAnimations();
  }

  // 应用产品动画
  function applyProductAnimations() {
    // 产品卡片简单淡入动画
    gsap.from('[data-product]', {
      opacity: 0,
      duration: 0.4,
      stagger: 0.03,
      ease: 'power2.out',
      clearProps: 'all',
    });

    // 重新绑定 Add to Cart 事件
    attachAddToCartListeners();
    attachColorSelectionListeners();

    // 产品卡片悬停效果
    const productCards = document.querySelectorAll('[data-product]');

    productCards.forEach((card) => {
      const image = card.querySelector('.product-image');
      const badge = card.querySelector('.product-badge');
      const overlay = card.querySelector('.product-overlay');
      const quickViewBtn = card.querySelector('.quick-view-btn');
      const addToCartBtn = card.querySelector('.add-to-cart-btn');

      // 悬停进入动画（移除了图片 scale 动画）
      const hoverTL = gsap.timeline({ paused: true });

      hoverTL
        .to(overlay, {
          opacity: 1,
          duration: 0.4,
        }, 0)
        .from(quickViewBtn, {
          scale: 0.8,
          opacity: 0,
          duration: 0.4,
          ease: 'back.out(2)',
        }, 0.2);

      if (badge) {
        hoverTL.to(badge, {
          rotation: 5,
          scale: 1.1,
          duration: 0.3,
          ease: 'back.out(2)',
        }, 0);
      }

      // Add to cart 按钮悬停动画
      const btnHoverTL = gsap.timeline({ paused: true });
      btnHoverTL.to(addToCartBtn, {
        scale: 1.05,
        duration: 0.3,
        ease: 'back.out(2)',
      });

      card.addEventListener('mouseenter', () => hoverTL.play());
      card.addEventListener('mouseleave', () => hoverTL.reverse());

      if (addToCartBtn) {
        addToCartBtn.addEventListener('mouseenter', () => btnHoverTL.play());
        addToCartBtn.addEventListener('mouseleave', () => btnHoverTL.reverse());
      }
    });
  }

  // ==================== 事件监听器 ====================

  // Import CartManager
  import { CartManager } from '../lib/cart';

  // Add to Cart 按钮
  // ==================== 颜色选择逻辑 ====================
  function attachColorSelectionListeners() {
    document.querySelectorAll('.product-card').forEach(card => {
      const colorSwatches = card.querySelectorAll('.color-swatch');
      const addToCartBtn = card.querySelector('.add-to-cart-btn');
      const colorContainer = card.querySelector('.product-colors');
      const mainImage = card.querySelector('.product-image-main') as HTMLImageElement;

      if (colorSwatches.length === 0) return;

      colorSwatches.forEach(swatch => {
        swatch.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();

          // 移除其他选中状态
          colorSwatches.forEach(s => s.classList.remove('selected'));

          // 选中当前颜色
          swatch.classList.add('selected');

          const selectedColor = swatch.getAttribute('data-color');
          const variationId = swatch.getAttribute('data-variation-id');
          const variationImage = swatch.getAttribute('data-image');

          // 切换主图到变体图片
          if (mainImage && variationImage) {
            mainImage.src = variationImage;
          }

          // 获取变体数据
          const variationsData = colorContainer?.getAttribute('data-variations');
          if (!variationsData) return;

          const variations = JSON.parse(variationsData);

          // 找到匹配的变体
          const matchingVariation = variations.find(v => v.id === parseInt(variationId || '0'));

          if (matchingVariation && addToCartBtn) {
            // 启用按钮并更新数据
            addToCartBtn.disabled = false;
            addToCartBtn.setAttribute('data-variation-id', matchingVariation.id);
            addToCartBtn.setAttribute('data-selected-color', selectedColor || '');
            addToCartBtn.querySelector('span').textContent = 'ADD TO CART';
          }
        });
      });
    });
  }

  function attachAddToCartListeners() {
    const addToCartButtons = document.querySelectorAll('.add-to-cart-btn');
    addToCartButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation(); // 防止触发父元素的链接

        if (btn.disabled) return;

        const productId = btn.getAttribute('data-product-id');
        const variationId = btn.getAttribute('data-variation-id');
        const selectedColor = btn.getAttribute('data-selected-color');
        const hasColors = btn.getAttribute('data-has-colors') === 'true';
        const productCard = btn.closest('.product-card');

        if (!productCard || !productId) return;

        // 如果需要颜色但没有选择，提示用户
        if (hasColors && !variationId) {
          alert('Please select a color first');
          return;
        }

        // 获取产品信息
        const productLink = productCard.querySelector('.product-link') as HTMLAnchorElement;
        const productName = productCard.querySelector('.product-name')?.textContent || '';
        const priceElement = productCard.querySelector('.product-price');
        const priceText = priceElement?.textContent || '0';
        const price = parseFloat(priceText.replace(/[^0-9.]/g, ''));
        const image = (productCard.querySelector('.product-image-main') as HTMLImageElement)?.src || '';
        const slug = productLink?.href.split('/').pop() || '';

        // 准备购物车商品数据
        const cartItem: any = {
          product_id: parseInt(productId),
          name: productName.trim(),
          slug: slug,
          price: price,
          quantity: 1,
          image: image,
          stock_status: 'instock',
        };

        // 如果有变体，添加变体信息
        if (variationId && selectedColor) {
          cartItem.variation_id = parseInt(variationId);
          cartItem.attributes = [{
            name: 'Color',
            value: selectedColor
          }];
        }

        // 添加到购物车
        CartManager.addItem(cartItem);

        // 按钮动画和状态更新
        const originalText = btn.querySelector('span')?.textContent;

        gsap.to(btn, {
          scale: 0.95,
          duration: 0.1,
          yoyo: true,
          repeat: 1,
          ease: 'power2.inOut',
          onComplete: () => {
            // 更新按钮文字
            if (btn.querySelector('span')) {
              btn.querySelector('span').textContent = '✓ ADDED';
            }

            // 打开购物车drawer
            setTimeout(() => {
              window.dispatchEvent(new CustomEvent('open-cart'));
            }, 300);

            // 2秒后恢复按钮文字
            setTimeout(() => {
              if (btn.querySelector('span')) {
                btn.querySelector('span').textContent = originalText;
              }
            }, 2000);
          }
        });
      });
    });
  }

  // 初始加载时绑定事件
  attachAddToCartListeners();
  attachColorSelectionListeners();

  // 分类筛选
  const categoryButtons = document.querySelectorAll('[data-category]');
  categoryButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const categorySlug = btn.getAttribute('data-category');
      const categoryId = btn.getAttribute('data-category-id') || categorySlug;

      currentFilters.category = categoryId || 'all';
      currentFilters.categorySlug = categorySlug || 'all';
      currentFilters.page = 1;

      // 更新按钮状态
      categoryButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      // 更新 URL
      const url = new URL(window.location.href);
      if (categorySlug && categorySlug !== 'all') {
        url.searchParams.set('category', categorySlug);
      } else {
        url.searchParams.delete('category');
      }
      window.history.pushState({}, '', url);

      // 桌面端立即加载，移动端等待 Apply 按钮
      const sidebar = document.querySelector('[data-shop="sidebar"]');
      const isMobileDrawerOpen = sidebar?.classList.contains('drawer-open');

      if (!isMobileDrawerOpen) {
        // 桌面端：立即加载产品
        loadProducts();
      }
      // 移动端：等待用户点击 Apply Filters 按钮
    });
  });

  // 材质标签筛选
  const tagCheckboxes = document.querySelectorAll('[data-tag-slug]');
  tagCheckboxes.forEach(checkbox => {
    checkbox.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      const tagSlug = target.getAttribute('data-tag-slug');
      const tagId = target.getAttribute('data-tag-id');

      if (target.checked) {
        // 添加标签到筛选条件
        if (tagId && !currentFilters.tags.includes(tagId)) {
          currentFilters.tags.push(tagId);
        }
      } else {
        // 从筛选条件中移除标签
        currentFilters.tags = currentFilters.tags.filter(id => id !== tagId);
      }

      console.log('当前选中的标签:', currentFilters.tags);

      // 重置到第一页
      currentFilters.page = 1;

      // 桌面端立即加载，移动端等待 Apply 按钮
      // 检测是否为移动端（drawer 是否打开）
      const sidebar = document.querySelector('[data-shop="sidebar"]');
      const isMobileDrawerOpen = sidebar?.classList.contains('drawer-open');

      if (!isMobileDrawerOpen) {
        // 桌面端：立即加载产品
        loadProducts();
      }
      // 移动端：等待用户点击 Apply Filters 按钮
    });
  });

  // 初始化：根据 URL 参数激活对应的分类按钮
  categoryButtons.forEach(btn => {
    const btnCategorySlug = btn.getAttribute('data-category');
    if (btnCategorySlug === initialCategorySlug) {
      categoryButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      // 获取分类 ID 用于 API 请求
      const categoryId = btn.getAttribute('data-category-id') || btnCategorySlug;
      currentFilters.category = categoryId;
    }
  });

  // 不需要在初始化时调用 loadProducts()，因为服务端已经渲染了正确的产品

  // 排序选择
  const sortSelect = document.querySelector('.sort-select') as HTMLSelectElement;
  if (sortSelect) {
    sortSelect.addEventListener('change', () => {
      currentFilters.orderby = sortSelect.value;
      currentFilters.page = 1;
      loadProducts();
    });
  }

  // 价格滑动条筛选
  const minSlider = document.querySelector('[data-slider="min"]') as HTMLInputElement;
  const maxSlider = document.querySelector('[data-slider="max"]') as HTMLInputElement;
  const minPriceDisplay = document.querySelector('[data-price="min"]');
  const maxPriceDisplay = document.querySelector('[data-price="max"]');
  const sliderRange = document.querySelector('[data-slider-range]') as HTMLElement;

  console.log('价格滑动条元素:', { minSlider, maxSlider, minPriceDisplay, maxPriceDisplay, sliderRange });

  if (minSlider && maxSlider && minPriceDisplay && maxPriceDisplay && sliderRange) {
    console.log('初始化价格滑动条，最大价格:', maxSlider.max);

    // 更新滑动范围的可视化
    function updateSliderRange() {
      const minValue = parseInt(minSlider.value);
      const maxValue = parseInt(maxSlider.value);
      const maxRange = parseInt(minSlider.max);

      const minPercent = (minValue / maxRange) * 100;
      const maxPercent = (maxValue / maxRange) * 100;

      sliderRange.style.left = `${minPercent}%`;
      sliderRange.style.width = `${maxPercent - minPercent}%`;

      console.log('更新滑动范围:', { minPercent, maxPercent, minValue, maxValue, maxRange });
    }

    // 更新显示的价格值
    function updatePriceDisplay() {
      const minValue = parseInt(minSlider.value);
      const maxValue = parseInt(maxSlider.value);

      // 确保 min 不超过 max
      if (minValue > maxValue) {
        minSlider.value = maxValue.toString();
      }

      // 确保 max 不小于 min
      if (maxValue < minValue) {
        maxSlider.value = minValue.toString();
      }

      minPriceDisplay.textContent = `$${minSlider.value}`;
      maxPriceDisplay.textContent = `$${maxSlider.value}`;

      updateSliderRange();
    }

    // 初始化滑动范围
    updateSliderRange();

    // 监听滑动条变化
    let priceTimeout: number;

    minSlider.addEventListener('input', () => {
      updatePriceDisplay();

      // 防抖：等待用户停止拖动后再加载产品
      clearTimeout(priceTimeout);
      priceTimeout = setTimeout(() => {
        currentFilters.minPrice = parseInt(minSlider.value);
        currentFilters.page = 1;

        console.log('价格筛选 - Min:', currentFilters.minPrice, 'Max:', currentFilters.maxPrice);

        // 桌面端立即加载，移动端等待 Apply
        const sidebar = document.querySelector('[data-shop="sidebar"]');
        const isMobileDrawerOpen = sidebar?.classList.contains('drawer-open');

        if (!isMobileDrawerOpen) {
          loadProducts();
        }
      }, 500);
    });

    maxSlider.addEventListener('input', () => {
      updatePriceDisplay();

      // 防抖：等待用户停止拖动后再加载产品
      clearTimeout(priceTimeout);
      priceTimeout = setTimeout(() => {
        currentFilters.maxPrice = parseInt(maxSlider.value);
        currentFilters.page = 1;

        console.log('价格筛选 - Min:', currentFilters.minPrice, 'Max:', currentFilters.maxPrice);

        // 桌面端立即加载，移动端等待 Apply
        const sidebar = document.querySelector('[data-shop="sidebar"]');
        const isMobileDrawerOpen = sidebar?.classList.contains('drawer-open');

        if (!isMobileDrawerOpen) {
          loadProducts();
        }
      }, 500);
    });
  } else {
    console.error('价格滑动条初始化失败，缺少元素');
  }
</script>

