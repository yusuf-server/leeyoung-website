---
export const prerender = false;
---

<html>
<head>
  <meta charset="UTF-8">
  <title>WordPress Avatar Test</title>
  <style>
    body {
      font-family: monospace;
      padding: 40px;
      max-width: 1000px;
      margin: 0 auto;
      background: #f5f5f5;
    }
    .result {
      background: white;
      padding: 20px;
      border-radius: 8px;
      margin: 20px 0;
      border-left: 4px solid #d4af37;
    }
    button {
      background: #d4af37;
      color: white;
      border: none;
      padding: 12px 24px;
      border-radius: 6px;
      cursor: pointer;
      font-weight: bold;
    }
    pre {
      background: #1e1e1e;
      color: #d4d4d4;
      padding: 15px;
      border-radius: 4px;
      overflow-x: auto;
    }
    .avatar {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      border: 3px solid #d4af37;
    }
  </style>
</head>
<body>
  <h1>WordPress Avatar Endpoint Test</h1>

  <div class="result">
    <h2>当前登录用户信息</h2>
    <button id="check-session">检查 Session</button>
    <pre id="session-output">点击按钮...</pre>
  </div>

  <div class="result">
    <h2>WordPress 头像端点返回</h2>
    <button id="check-wp-avatar">检查 WordPress 头像</button>
    <pre id="wp-output">点击按钮...</pre>
    <div id="avatar-preview"></div>
  </div>

  <div class="result">
    <h2>检查是否保存到 User Meta</h2>
    <p>需要在 WordPress 数据库中运行以下 SQL：</p>
    <pre>SELECT user_id, meta_key, meta_value
FROM wp_usermeta
WHERE meta_key IN ('custom_avatar', 'custom_avatar_id')
  AND user_id IN (1, 2)
ORDER BY user_id, meta_key;</pre>
    <p>查看每个用户是否有自己的 custom_avatar 记录</p>
  </div>

  <script is:inline>
    document.getElementById('check-session').addEventListener('click', async () => {
      const output = document.getElementById('session-output');
      output.textContent = '加载中...';

      try {
        const response = await fetch('/api/auth/session');
        const data = await response.json();
        output.textContent = JSON.stringify(data, null, 2);
      } catch (e) {
        output.textContent = '错误: ' + e.message;
      }
    });

    document.getElementById('check-wp-avatar').addEventListener('click', async () => {
      const output = document.getElementById('wp-output');
      const preview = document.getElementById('avatar-preview');
      output.textContent = '加载中...';
      preview.innerHTML = '';

      try {
        // First get session to get the token
        const sessionResponse = await fetch('/api/auth/session');
        const sessionData = await sessionResponse.json();

        if (!sessionData.authenticated) {
          output.textContent = '未登录';
          return;
        }

        // Call our API that wraps WordPress call
        const response = await fetch('/api/account/get-avatar');
        const data = await response.json();

        output.textContent = JSON.stringify(data, null, 2);

        if (data.avatar_url) {
          preview.innerHTML = '<h3>头像预览：</h3><img src="' + data.avatar_url + '?t=' + Date.now() + '" class="avatar" />';
        }
      } catch (e) {
        output.textContent = '错误: ' + e.message;
      }
    });
  </script>
</body>
</html>
