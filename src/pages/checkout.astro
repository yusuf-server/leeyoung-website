---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getEnabledPaymentMethods } from '../config/payment';

export const prerender = false;

// Get enabled payment methods
const enabledPaymentMethods = getEnabledPaymentMethods();
const hasStripe = enabledPaymentMethods.some(m => m.id === 'stripe');
const hasPayPal = enabledPaymentMethods.some(m => m.id === 'paypal');
---

<BaseLayout title="Checkout - LEEYOUNG" description="Complete your purchase">
  <Header />

  <!-- Checkout Page -->
  <section class="checkout-page">
    <div class="checkout-container">

      <!-- Checkout Grid -->
      <div class="checkout-grid">

        <!-- Left Column - Forms -->
        <div class="checkout-forms">

          <!-- Contact Information -->
          <div class="checkout-section">
            <div class="section-header">
              <h2 class="section-title">Contact</h2>
              <a href="#" class="section-link" data-auth="login">Log in</a>
            </div>
            <div class="form-group">
              <input
                type="email"
                id="email"
                placeholder="Email"
                class="form-input"
                required
              />
            </div>
            <label class="checkbox-label">
              <input type="checkbox" id="subscribe" />
              <span>Email me with news and offers</span>
            </label>
          </div>

          <!-- Shipping Address -->
          <div class="checkout-section">
            <h2 class="section-title">Delivery</h2>

            <div class="form-row">
              <div class="form-group">
                <select id="country" class="form-input" required>
                  <option value="">Country/Region</option>
                  <option value="US">United States</option>
                  <option value="CA">Canada</option>
                  <option value="GB">United Kingdom</option>
                  <option value="AU">Australia</option>
                </select>
              </div>
            </div>

            <div class="form-row form-row-2">
              <div class="form-group">
                <input
                  type="text"
                  id="firstName"
                  placeholder="First name"
                  class="form-input"
                  required
                />
              </div>
              <div class="form-group">
                <input
                  type="text"
                  id="lastName"
                  placeholder="Last name"
                  class="form-input"
                  required
                />
              </div>
            </div>

            <div class="form-group">
              <input
                type="text"
                id="address"
                placeholder="Address"
                class="form-input"
                required
              />
            </div>

            <div class="form-group">
              <input
                type="text"
                id="apartment"
                placeholder="Apartment, suite, etc. (optional)"
                class="form-input"
              />
            </div>

            <div class="form-row form-row-3">
              <div class="form-group">
                <input
                  type="text"
                  id="city"
                  placeholder="City"
                  class="form-input"
                  required
                />
              </div>
              <div class="form-group">
                <select id="state" class="form-input" required>
                  <option value="">State</option>
                  <option value="AL">Alabama</option>
                  <option value="AK">Alaska</option>
                  <option value="AZ">Arizona</option>
                  <option value="AR">Arkansas</option>
                  <option value="CA">California</option>
                  <option value="CO">Colorado</option>
                  <option value="CT">Connecticut</option>
                  <option value="DE">Delaware</option>
                  <option value="FL">Florida</option>
                  <option value="GA">Georgia</option>
                  <option value="HI">Hawaii</option>
                  <option value="ID">Idaho</option>
                  <option value="IL">Illinois</option>
                  <option value="IN">Indiana</option>
                  <option value="IA">Iowa</option>
                  <option value="KS">Kansas</option>
                  <option value="KY">Kentucky</option>
                  <option value="LA">Louisiana</option>
                  <option value="ME">Maine</option>
                  <option value="MD">Maryland</option>
                  <option value="MA">Massachusetts</option>
                  <option value="MI">Michigan</option>
                  <option value="MN">Minnesota</option>
                  <option value="MS">Mississippi</option>
                  <option value="MO">Missouri</option>
                  <option value="MT">Montana</option>
                  <option value="NE">Nebraska</option>
                  <option value="NV">Nevada</option>
                  <option value="NH">New Hampshire</option>
                  <option value="NJ">New Jersey</option>
                  <option value="NM">New Mexico</option>
                  <option value="NY">New York</option>
                  <option value="NC">North Carolina</option>
                  <option value="ND">North Dakota</option>
                  <option value="OH">Ohio</option>
                  <option value="OK">Oklahoma</option>
                  <option value="OR">Oregon</option>
                  <option value="PA">Pennsylvania</option>
                  <option value="RI">Rhode Island</option>
                  <option value="SC">South Carolina</option>
                  <option value="SD">South Dakota</option>
                  <option value="TN">Tennessee</option>
                  <option value="TX">Texas</option>
                  <option value="UT">Utah</option>
                  <option value="VT">Vermont</option>
                  <option value="VA">Virginia</option>
                  <option value="WA">Washington</option>
                  <option value="WV">West Virginia</option>
                  <option value="WI">Wisconsin</option>
                  <option value="WY">Wyoming</option>
                </select>
              </div>
              <div class="form-group">
                <input
                  type="text"
                  id="postalCode"
                  placeholder="ZIP code"
                  class="form-input"
                  required
                />
              </div>
            </div>

            <div class="form-group">
              <input
                type="tel"
                id="phone"
                placeholder="Phone"
                class="form-input"
                required
              />
            </div>
          </div>

          <!-- Shipping Method -->
          <div class="checkout-section">
            <h2 class="section-title">Shipping method</h2>
            <div class="shipping-options" data-shipping-options>
              <div class="shipping-option">
                <label class="shipping-label">
                  <input type="radio" name="shipping" value="standard" checked />
                  <span class="shipping-info">
                    <span class="shipping-name">Standard Shipping</span>
                    <span class="shipping-time">5-7 business days</span>
                  </span>
                  <span class="shipping-price">Free</span>
                </label>
              </div>
              <div class="shipping-option">
                <label class="shipping-label">
                  <input type="radio" name="shipping" value="express" />
                  <span class="shipping-info">
                    <span class="shipping-name">Express Shipping</span>
                    <span class="shipping-time">2-3 business days</span>
                  </span>
                  <span class="shipping-price">$15.00</span>
                </label>
              </div>
            </div>
          </div>

          <!-- Payment Method -->
          <div class="checkout-section">
            <h2 class="section-title">Payment</h2>
            <div class="payment-notice">
              All transactions are secure and encrypted.
            </div>

            <div class="payment-methods">
              {hasStripe && (
                <!-- Stripe Card Element -->
                <div class="payment-method stripe-payment" data-payment-method="stripe">
                  <label class="payment-label">
                    <input type="radio" name="payment" value="stripe" checked={hasStripe} />
                    <span class="payment-info">
                      <span class="payment-name">💳 Credit Card</span>
                      <span class="payment-description">Pay securely with your credit card</span>
                    </span>
                  </label>

                  <!-- Stripe Elements Container -->
                  <div id="stripe-card-element" class="stripe-card-element">
                    <!-- Stripe.js will inject card input here -->
                  </div>
                  <div id="stripe-card-errors" class="stripe-card-errors"></div>
                </div>
              )}

              {hasPayPal && (
                <!-- PayPal Payment -->
                <div class="payment-method paypal-payment" data-payment-method="paypal">
                  <label class="payment-label">
                    <input type="radio" name="payment" value="paypal" checked={!hasStripe && hasPayPal} />
                    <span class="payment-info">
                      <span class="payment-name">🅿️ PayPal</span>
                      <span class="payment-description">Pay securely with your PayPal account</span>
                    </span>
                  </label>

                  <!-- PayPal Button Container -->
                  <div id="paypal-button-container" class="paypal-button-container">
                    <!-- PayPal button will be rendered here -->
                  </div>
                </div>
              )}
            </div>
          </div>

          <!-- Submit Button (for Stripe, PayPal uses its own button) -->
          <button type="button" class="checkout-submit-btn" id="completeOrderBtn">
            Complete order
          </button>

        </div>

        <!-- Right Column - Order Summary -->
        <div class="checkout-summary">
          <div class="summary-sticky">

            <!-- Cart Items -->
            <div class="summary-items" data-summary-items>
              <!-- Items will be rendered here -->
            </div>

            <!-- Promo Code -->
            <div class="promo-section">
              <input
                type="text"
                id="promoCode"
                placeholder="Discount code or gift card"
                class="promo-input"
              />
              <button type="button" class="promo-btn">Apply</button>
            </div>

            <!-- Totals -->
            <div class="summary-totals">
              <div class="summary-row">
                <span>Subtotal</span>
                <span data-summary="subtotal">$0.00</span>
              </div>
              <div class="summary-row">
                <span>Shipping</span>
                <span data-summary="shipping">Free Shipping</span>
              </div>
              <div class="summary-row summary-total">
                <span>Total</span>
                <span data-summary="total">
                  <span class="currency">USD</span>
                  <span class="amount">$0.00</span>
                </span>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  import { loadStripe } from '@stripe/stripe-js';
  import { CartManager, type Cart } from '../lib/cart-manager';
  import { gsap } from '../lib/gsap';
  import analytics from '../lib/analytics';

  // Payment method detection
  const hasStripe = document.querySelector('[data-payment-method="stripe"]') !== null;
  const hasPayPal = document.querySelector('[data-payment-method="paypal"]') !== null;

  // Stripe setup
  const STRIPE_PUBLIC_KEY = import.meta.env.PUBLIC_STRIPE_PUBLISHABLE_KEY || '';
  let stripe: any = null;
  let cardElement: any = null;

  // PayPal setup
  const PAYPAL_CLIENT_ID = import.meta.env.PUBLIC_PAYPAL_CLIENT_ID || '';

  // Get cart data from localStorage
  let cart: Cart | null = null;
  let isLoading = true;
  let selectedPaymentMethod: string = hasStripe ? 'stripe' : 'paypal';

  // Initialize Stripe
  async function initStripe() {
    if (!hasStripe) return;

    try {
      stripe = await loadStripe(STRIPE_PUBLIC_KEY);

      if (!stripe) {
        throw new Error('Failed to load Stripe');
      }

      const elements = stripe.elements();
      cardElement = elements.create('card', {
        style: {
          base: {
            fontSize: '16px',
            color: '#000',
            fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif',
            '::placeholder': {
              color: '#9ca3af',
            },
          },
          invalid: {
            color: '#e74c3c',
          },
        },
      });

      cardElement.mount('#stripe-card-element');

      // Handle real-time validation errors
      cardElement.on('change', (event: any) => {
        const displayError = document.getElementById('stripe-card-errors');
        if (displayError) {
          displayError.textContent = event.error ? event.error.message : '';
        }
      });
    } catch (error) {
      console.error('Failed to initialize Stripe:', error);
      alert('Failed to load payment system. Please refresh the page.');
    }
  }

  // Initialize PayPal
  function initPayPal() {
    if (!hasPayPal || !PAYPAL_CLIENT_ID) return;

    // Load PayPal SDK
    const script = document.createElement('script');
    script.src = `https://www.paypal.com/sdk/js?client-id=${PAYPAL_CLIENT_ID}&currency=USD`;
    script.onload = () => {
      renderPayPalButton();
    };
    document.head.appendChild(script);
  }

  // Render PayPal button
  function renderPayPalButton() {
    const paypalContainer = document.getElementById('paypal-button-container');
    if (!paypalContainer || !(window as any).paypal) return;

    // Store order info globally for onApprove callback
    let currentOrderId: number;
    let currentOrderKey: string;
    let autoCreatedAccount: boolean = false;

    (window as any).paypal.Buttons({
      createOrder: async () => {
        if (!validateForm()) {
          throw new Error('Please fill in all required fields');
        }

        // Prepare order data
        const billing = getBillingData();
        const shipping = { ...billing };
        const shippingMethod = (document.querySelector('input[name="shipping"]:checked') as HTMLInputElement)?.value || 'standard';
        const lineItems = cart!.items.map(item => ({
          product_id: item.product_id,
          variation_id: item.variation_id || 0,
          quantity: item.quantity,
        }));

        // Create order via API
        const response = await fetch('/api/paypal/create-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ billing, shipping, shippingMethod, line_items: lineItems }),
        });

        if (!response.ok) {
          const errorData = await response.json();
          throw new Error(errorData.error || 'Failed to create order');
        }

        const data = await response.json();

        // Store order info for later use
        currentOrderId = data.orderId;
        currentOrderKey = data.orderKey;
        autoCreatedAccount = data.autoCreatedAccount || false;

        console.log('✅ PayPal 订单创建成功:', {
          paypalOrderId: data.paypalOrderId,
          wcOrderId: currentOrderId,
          orderKey: currentOrderKey
        });

        return data.paypalOrderId;
      },
      onApprove: async (data: any) => {
        console.log('💳 用户已批准支付，开始捕获订单...', data.orderID);

        try {
          // Capture the order
          const response = await fetch('/api/paypal/capture-order', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              paypalOrderId: data.orderID,
              orderId: currentOrderId,
            }),
          });

          if (!response.ok) {
            const errorData = await response.json();
            throw new Error(errorData.error || 'Failed to capture payment');
          }

          const result = await response.json();
          console.log('✅ 支付捕获成功:', result);

          // Track purchase
          if (cart) {
            analytics.trackPurchase(currentOrderId, cart.total, cart.items);
          }

          // Clear cart
          CartManager.clearCart();
          document.cookie = 'wc_cart_hash=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';

          // Redirect to success page
          const successUrl = `/checkout/success?order_id=${currentOrderId}&order_key=${currentOrderKey}${autoCreatedAccount ? '&auto_created=1' : ''}`;
          console.log('🎉 跳转到成功页面:', successUrl);
          window.location.href = successUrl;
        } catch (error: any) {
          console.error('❌ 支付捕获失败:', error);
          alert(`Payment capture failed: ${error.message}`);

          // Redirect to failed page
          window.location.href = `/checkout/failed?order_id=${currentOrderId}&order_key=${currentOrderKey}&reason=${encodeURIComponent(error.message)}`;
        }
      },
      onError: (err: any) => {
        console.error('❌ PayPal 错误:', err);
        alert('Payment failed. Please try again.');
      },
      onCancel: () => {
        console.log('⚠️ 用户取消了支付');
        alert('Payment was cancelled. You can try again when ready.');
      },
    }).render('#paypal-button-container');
  }

  // Helper function to get billing data
  function getBillingData() {
    return {
      first_name: (document.getElementById('firstName') as HTMLInputElement).value,
      last_name: (document.getElementById('lastName') as HTMLInputElement).value,
      address_1: (document.getElementById('address') as HTMLInputElement).value,
      address_2: (document.getElementById('apartment') as HTMLInputElement).value,
      city: (document.getElementById('city') as HTMLInputElement).value,
      state: (document.getElementById('state') as HTMLSelectElement).value,
      postcode: (document.getElementById('postalCode') as HTMLInputElement).value,
      country: (document.getElementById('country') as HTMLSelectElement).value,
      email: (document.getElementById('email') as HTMLInputElement).value,
      phone: (document.getElementById('phone') as HTMLInputElement).value,
    };
  }

  // Load cart on page load
  function loadCart() {
    cart = CartManager.getCart();

    // Redirect if cart is empty
    if (!cart || cart.items.length === 0) {
      window.location.href = '/cart';
      return;
    }

    isLoading = false;
    renderOrderSummary();

    // 埋点：追踪开始结账
    analytics.trackBeginCheckout(cart.items, cart.total);
  }

  // Render order summary
  function renderOrderSummary() {
    if (!cart) return;

    const summaryItems = document.querySelector('[data-summary-items]');

    if (summaryItems) {
      summaryItems.innerHTML = cart.items.map(item => `
        <div class="summary-item">
          <div class="summary-item-image">
            <img src="${item.image || '/placeholder.jpg'}" alt="${item.name}" />
            <span class="summary-item-qty">${item.quantity}</span>
          </div>
          <div class="summary-item-details">
            <div class="summary-item-info">
              <div class="summary-item-name">${item.name}</div>
              ${item.attributes && item.attributes.length > 0 ? `
                <div class="summary-item-attributes">
                  ${item.attributes.map(attr => `${attr.name}: ${attr.value}`).join(' | ')}
                </div>
              ` : ''}
            </div>
            <div class="summary-item-price">${CartManager.formatPrice(item.price * item.quantity)}</div>
          </div>
        </div>
      `).join('');
    }

    // Update totals using localStorage cart data
    document.querySelector('[data-summary="subtotal"]')!.textContent = CartManager.formatPrice(cart.subtotal);
    document.querySelector('[data-summary="total"] .amount')!.textContent = CartManager.formatPrice(cart.total);
  }

  // Validate form
  function validateForm(): boolean {
    const requiredFields = [
      'email', 'firstName', 'lastName', 'address',
      'city', 'state', 'postalCode', 'country', 'phone'
    ];

    for (const fieldId of requiredFields) {
      const input = document.getElementById(fieldId) as HTMLInputElement | HTMLSelectElement;
      if (!input || !input.value.trim()) {
        alert(`Please fill in the ${fieldId} field`);
        input?.focus();
        return false;
      }
    }

    return true;
  }

  // Handle order submission with Stripe
  async function submitOrder() {
    if (!validateForm()) {
      return;
    }

    if (!stripe || !cardElement) {
      alert('Payment system not ready. Please refresh the page.');
      return;
    }

    const btn = document.getElementById('completeOrderBtn') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Processing payment...';

    try {
      // Prepare billing and shipping data
      const billing = getBillingData();
      const shipping = { ...billing };

      // Get selected shipping method
      const shippingMethod = (document.querySelector('input[name="shipping"]:checked') as HTMLInputElement)?.value || 'standard';

      // 准备购物车商品数据（从localStorage）
      const lineItems = cart!.items.map(item => ({
        product_id: item.product_id,
        variation_id: item.variation_id || 0,
        quantity: item.quantity,
      }));

      // Step 1: Create Order and Payment Intent (新的安全 API)
      btn.textContent = 'Creating order...';
      const intentResponse = await fetch('/api/stripe/create-order-and-intent', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ billing, shipping, shippingMethod, line_items: lineItems }),
      });

      if (!intentResponse.ok) {
        const errorData = await intentResponse.json();
        throw new Error(errorData.error || 'Failed to create order and payment intent');
      }

      const { clientSecret, orderId, orderKey, autoCreatedAccount } = await intentResponse.json();

      // Step 2: Confirm payment with Stripe
      btn.textContent = 'Processing payment...';
      const { error, paymentIntent } = await stripe.confirmCardPayment(clientSecret, {
        payment_method: {
          card: cardElement,
          billing_details: {
            name: `${billing.first_name} ${billing.last_name}`,
            email: billing.email,
            phone: billing.phone,
            address: {
              line1: billing.address_1,
              line2: billing.address_2 || undefined,
              city: billing.city,
              state: billing.state,
              postal_code: billing.postcode,
              country: billing.country,
            },
          },
        },
      });

      // Step 3: 根据支付状态跳转到不同页面
      let redirectUrl = '';

      if (error) {
        // 支付失败
        btn.textContent = 'Payment failed';
        console.error('Payment error:', error);

        // 清空购物车
        document.cookie = 'wc_cart_hash=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';

        // 跳转到失败页面（仍然显示账户创建提示）
        redirectUrl = `/checkout/failed?order_id=${orderId}&order_key=${orderKey}${autoCreatedAccount ? '&auto_created=1' : ''}&reason=${encodeURIComponent(error.message || 'Payment failed')}`;
        window.location.href = redirectUrl;
        return;
      }

      // 根据 PaymentIntent 状态决定跳转页面
      switch (paymentIntent.status) {
        case 'succeeded':
          // 支付成功
          btn.textContent = 'Payment successful!';

          // 埋点：追踪购买完成
          if (cart) {
            analytics.trackPurchase(orderId, cart.total, cart.items);
          }

          // 清空购物车
          document.cookie = 'wc_cart_hash=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';

          redirectUrl = `/checkout/success?order_id=${orderId}&order_key=${orderKey}${autoCreatedAccount ? '&auto_created=1' : ''}`;
          break;

        case 'processing':
          // 支付处理中（例如银行转账）
          btn.textContent = 'Payment processing...';

          // 清空购物车
          document.cookie = 'wc_cart_hash=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';

          redirectUrl = `/checkout/processing?order_id=${orderId}&order_key=${orderKey}${autoCreatedAccount ? '&auto_created=1' : ''}`;
          break;

        case 'requires_action':
        case 'requires_payment_method':
          // 需要额外操作（3D Secure）或需要重新选择支付方式
          btn.textContent = 'Action required';
          redirectUrl = `/checkout/processing?order_id=${orderId}&order_key=${orderKey}${autoCreatedAccount ? '&auto_created=1' : ''}&status=${paymentIntent.status}`;
          break;

        case 'canceled':
          // 支付已取消
          btn.textContent = 'Payment canceled';

          // 清空购物车
          document.cookie = 'wc_cart_hash=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';

          redirectUrl = `/checkout/failed?order_id=${orderId}&order_key=${orderKey}${autoCreatedAccount ? '&auto_created=1' : ''}&reason=Payment was canceled`;
          break;

        default:
          // 其他状态（失败）
          btn.textContent = 'Payment failed';

          // 清空购物车
          document.cookie = 'wc_cart_hash=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';

          redirectUrl = `/checkout/failed?order_id=${orderId}&order_key=${orderKey}${autoCreatedAccount ? '&auto_created=1' : ''}&reason=Payment status: ${paymentIntent.status}`;
          break;
      }

      // 跳转
      window.location.href = redirectUrl;

    } catch (error: any) {
      console.error('Order submission failed:', error);
      alert(error.message || 'Payment failed. Please try again.');
      btn.disabled = false;
      btn.textContent = 'Complete order';
    }
  }

  // Handle payment method switching
  function handlePaymentMethodChange() {
    const selectedMethod = document.querySelector('input[name="payment"]:checked') as HTMLInputElement;
    selectedPaymentMethod = selectedMethod?.value || (hasStripe ? 'stripe' : 'paypal');

    const completeOrderBtn = document.getElementById('completeOrderBtn');

    if (selectedPaymentMethod === 'stripe') {
      // Show complete order button for Stripe
      if (completeOrderBtn) {
        completeOrderBtn.style.display = 'block';
        completeOrderBtn.textContent = 'Complete order';
      }
    } else if (selectedPaymentMethod === 'paypal') {
      // Hide complete order button for PayPal (PayPal has its own button)
      if (completeOrderBtn) {
        completeOrderBtn.style.display = 'none';
      }
    }
  }

  // Event listeners
  document.getElementById('completeOrderBtn')?.addEventListener('click', submitOrder);

  // Payment method radio button listeners
  document.querySelectorAll('input[name="payment"]').forEach(radio => {
    radio.addEventListener('change', handlePaymentMethodChange);
  });

  // Initialize
  if (hasStripe) {
    initStripe();
  }
  if (hasPayPal) {
    initPayPal();
  }
  loadCart();
  handlePaymentMethodChange(); // Set initial state

  // Entrance animations
