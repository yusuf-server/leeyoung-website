---
import CartDrawer from '../components/CartDrawer.astro';
import SearchDrawer from '../components/SearchDrawer.astro';
import PixelScripts from '../components/PixelScripts.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Website built with Astro and WordPress' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Michroma&family=Saira+Stencil:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

    <!-- Pixel Tracking Scripts -->
    <PixelScripts />

    <!-- Umami Analytics -->
    <script defer src="https://cloud.umami.is/script.js" data-website-id="e7447987-a5cc-4716-89b4-93f7c3d3ceef"></script>

    <slot name="head" />
  </head>
  <body>
    <slot />

    <!-- Cart Drawer -->
    <CartDrawer />

    <!-- Search Drawer -->
    <SearchDrawer />

    <!-- GSAP 动画脚本 -->
    <script>
      import { gsap } from '../lib/gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      // 等待 DOM 加载完成
      document.addEventListener('DOMContentLoaded', () => {
        // fade-up 动画
        gsap.utils.toArray('[data-animate="fade-up"]').forEach((element: any) => {
          gsap.from(element, {
            scrollTrigger: {
              trigger: element,
              start: 'top 85%',
              end: 'bottom 15%',
              toggleActions: 'play none none reverse',
            },
            y: 50,
            opacity: 0,
            duration: 0.8,
            ease: 'power2.out',
          });
        });

        // fade-down 动画
        gsap.utils.toArray('[data-animate="fade-down"]').forEach((element: any) => {
          gsap.from(element, {
            scrollTrigger: {
              trigger: element,
              start: 'top 85%',
              end: 'bottom 15%',
              toggleActions: 'play none none reverse',
            },
            y: -50,
            opacity: 0,
            duration: 0.8,
            ease: 'power2.out',
          });
        });

        // fade-left 动画
        gsap.utils.toArray('[data-animate="fade-left"]').forEach((element: any) => {
          gsap.from(element, {
            scrollTrigger: {
              trigger: element,
              start: 'top 85%',
              end: 'bottom 15%',
              toggleActions: 'play none none reverse',
            },
            x: 50,
            opacity: 0,
            duration: 0.8,
            ease: 'power2.out',
          });
        });

        // fade-right 动画
        gsap.utils.toArray('[data-animate="fade-right"]').forEach((element: any) => {
          gsap.from(element, {
            scrollTrigger: {
              trigger: element,
              start: 'top 85%',
              end: 'bottom 15%',
              toggleActions: 'play none none reverse',
            },
            x: -50,
            opacity: 0,
            duration: 0.8,
            ease: 'power2.out',
          });
        });

        // fade 动画
        gsap.utils.toArray('[data-animate="fade"]').forEach((element: any) => {
          gsap.from(element, {
            scrollTrigger: {
              trigger: element,
              start: 'top 85%',
              end: 'bottom 15%',
              toggleActions: 'play none none reverse',
            },
            opacity: 0,
            duration: 1,
            ease: 'power2.out',
          });
        });

        // scale 动画
        gsap.utils.toArray('[data-animate="scale"]').forEach((element: any) => {
          gsap.from(element, {
            scrollTrigger: {
              trigger: element,
              start: 'top 85%',
              end: 'bottom 15%',
              toggleActions: 'play none none reverse',
            },
            scale: 0.9,
            opacity: 0,
            duration: 0.8,
            ease: 'power2.out',
          });
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --color-primary: #000000;
    --color-secondary: #ffffff;
    --color-accent: #d4af37;
    --color-text: #333333;
    --color-text-light: #666666;
    --color-bg: #ffffff;
    --color-bg-dark: #0a0a0a;
    --spacing-xs: 0.5rem;
    --spacing-sm: 1rem;
    --spacing-md: 2rem;
    --spacing-lg: 4rem;
    --spacing-xl: 2rem;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: 'Saira Stencil', sans-serif;
    background: var(--color-bg);
    scroll-behavior: smooth;
    overflow-x: hidden;
    width: 100%;
  }

  body {
    margin: 0;
    padding: 0;
    color: var(--color-text);
    line-height: 1.6;
    overflow-x: hidden;
    width: 100%;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  button {
    cursor: pointer;
    border: none;
    background: none;
    font-family: inherit;
  }

</style>
