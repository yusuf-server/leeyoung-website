---
import { getProducts, getProductVariations, type WooProduct } from '../lib/woocommerce';

interface Product {
  id: string;
  name: string;
  badge?: string;
  image: string;
  features: string[];
  price: string;
  colors?: number;
  link: string;
}

// 从 WooCommerce 获取产品数据
let wooProducts: WooProduct[] = [];
try {
  wooProducts = await getProducts({
    per_page: 8,
    orderby: 'popularity',
    order: 'desc',
    stock_status: 'instock',
  });
} catch (error) {
  console.error('Failed to fetch products:', error);
}

// 转换 WooCommerce 产品数据为组件需要的格式
const products: Product[] = await Promise.all(
  wooProducts.map(async (wooProduct) => {
    // 提取特性（优先从 short_description，其次使用默认值）
    let features: string[] = [];

    // 尝试从 short_description 提取特性
    if (wooProduct.short_description) {
      // 移除 HTML 标签
      const descText = wooProduct.short_description
        .replace(/<[^>]*>/g, '')
        .trim();

      // 尝试按行或按列表项分割
      let lines = descText.split(/\n|<br>|<\/li>/).filter(line => line.trim());

      // 如果没有换行，尝试按句号分割
      if (lines.length === 1) {
        lines = descText.split(/\.|•/).filter(line => line.trim());
      }

      // 清理并提取特性
      features = lines
        .map(line => line.trim().replace(/^[-•*]\s*/, '')) // 移除列表符号
        .filter(line => line.length > 0 && line.length < 100) // 过滤太长或太短的
        .slice(0, 4);
    }

    // 如果从 short_description 提取的特性不足 3 条，使用默认特性
    if (features.length < 3) {
      features = [
        'High quality construction',
        'Durable materials',
        'Professional grade',
        'Reliable performance',
      ];
    }

    // 确保最多显示 4 个特性
    features = features.slice(0, 4);

    // 获取颜色数量（从 variations）
    let colorsCount: number | undefined = undefined;
    if (wooProduct.type === 'variable' && wooProduct.variations.length > 0) {
      try {
        const variations = await getProductVariations(wooProduct.id);
        // 查找颜色属性
        const colorAttribute = variations
          .map(v => v.attributes.find(attr =>
            attr.name.toLowerCase().includes('color') ||
            attr.name.toLowerCase().includes('colour')
          ))
          .filter(Boolean);

        if (colorAttribute.length > 0) {
          // 统计唯一颜色数量
          const uniqueColors = new Set(colorAttribute.map(attr => attr?.option).filter(Boolean));
          if (uniqueColors.size > 0) {
            colorsCount = uniqueColors.size;
          }
        }
      } catch (error) {
        console.error(`Failed to fetch variations for product ${wooProduct.id}:`, error);
      }
    }

    // 确定 badge
    let badge: string | undefined = undefined;
    if (wooProduct.featured) {
      badge = 'BESTSELLER';
    } else if (wooProduct.on_sale) {
      badge = 'ON SALE';
    } else if (wooProduct.total_sales > 50) {
      badge = 'TOP RATED';
    }

    return {
      id: wooProduct.id.toString(),
      name: wooProduct.name.toUpperCase(),
      badge,
      image: wooProduct.images[0]?.src || 'https://via.placeholder.com/800',
      features,
      price: wooProduct.price,
      colors: colorsCount,
      link: `/products/${wooProduct.slug}`,
    };
  })
);
---

<section class="popular-products">
  <div class="products-container">
    <!-- 标题区域 -->
    <div class="section-header" data-popular="header">
      <div class="header-content">
        <span class="section-badge" data-popular="badge">ALL-ROUND PERFORMANCE</span>
        <h2 class="section-title" data-popular="title">POPULAR PRODUCTS</h2>
      </div>
      <div class="nav-arrows" data-popular="nav">
        <button class="arrow-btn arrow-prev" id="productPrev" aria-label="Previous">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 18l-6-6 6-6"/>
          </svg>
        </button>
        <button class="arrow-btn arrow-next" id="productNext" aria-label="Next">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- 产品滚动区域 -->
    <div class="products-wrapper">
      <div class="products-slider" id="productsSlider">
        {products.map((product, index) => (
          <div class="product-card" data-product-card={index}>
            <a href={product.link} class="product-link">
              {/* 产品图片 */}
              <div class="product-image">
                <img src={product.image} alt={product.name} loading="lazy" />
                {product.badge && (
                  <span class="product-badge">{product.badge}</span>
                )}
                {product.colors && product.colors > 0 && (
                  <span class="product-colors desktop-only">AVAILABLE IN {product.colors} COLORS</span>
                )}
              </div>

              {/* 产品信息 */}
              <div class="product-info">
                <h3 class="product-name">{product.name}</h3>

                <ul class="product-features">
                  {product.features.map((feature) => (
                    <li>{feature}</li>
                  ))}
                </ul>

                <div class="product-footer">
                  <div class="product-price">
                    <span class="price-label">from</span>
                    <span class="price-value">${product.price}</span>
                  </div>
                  <button class="add-to-cart">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="9" cy="21" r="1"/>
                      <circle cx="20" cy="21" r="1"/>
                      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                    </svg>
                  </button>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>

      <!-- 分页指示器 Dots -->
      <div class="pagination-dots" id="paginationDots">
        {Array.from({ length: 3 }).map((_, index) => (
          <button
            class="dot"
            data-dot-index={index}
            aria-label={`Go to page ${index + 1}`}
          />
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from '../lib/gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  // 标题动画
  gsap.from('[data-popular="badge"]', {
    scrollTrigger: {
      trigger: '.popular-products',
      start: 'top 80%',
      toggleActions: 'play none none reverse',
    },
    y: 20,
    opacity: 0,
    duration: 0.6,
  });

  gsap.from('[data-popular="title"]', {
    scrollTrigger: {
      trigger: '.popular-products',
      start: 'top 80%',
      toggleActions: 'play none none reverse',
    },
    y: 30,
    opacity: 0,
    duration: 0.8,
    delay: 0.1,
  });

  gsap.from('[data-popular="nav"]', {
    scrollTrigger: {
      trigger: '.popular-products',
      start: 'top 80%',
      toggleActions: 'play none none reverse',
    },
    x: 20,
    opacity: 0,
    duration: 0.6,
    delay: 0.2,
  });

  // 产品卡片交错动画
  gsap.utils.toArray('[data-product-card]').forEach((card: any, index) => {
    gsap.from(card, {
      scrollTrigger: {
        trigger: card,
        start: 'top 90%',
        toggleActions: 'play none none reverse',
      },
      y: 60,
      opacity: 0,
      duration: 0.8,
      delay: index * 0.1,
      ease: 'power2.out',
    });

    // 卡片悬停动画
    const cardHoverTL = gsap.timeline({ paused: true });
    const img = card.querySelector('img');
    const addToCartBtn = card.querySelector('.add-to-cart');
    const productName = card.querySelector('.product-name');

    cardHoverTL
      .to(img, {
        scale: 1.05,
        duration: 0.6,
        ease: 'power2.out',
      }, 0)
      .to(addToCartBtn, {
        scale: 1.1,
        rotate: 5,
        duration: 0.3,
        ease: 'back.out(1.7)',
      }, 0)
      .to(productName, {
        x: 5,
        duration: 0.3,
        ease: 'power2.out',
      }, 0);

    card.addEventListener('mouseenter', () => cardHoverTL.play());
    card.addEventListener('mouseleave', () => cardHoverTL.reverse());

    // 徽章动画（如果存在）
    const badge = card.querySelector('.product-badge');
    if (badge) {
      gsap.from(badge, {
        scrollTrigger: {
          trigger: card,
          start: 'top 85%',
          toggleActions: 'play none none reverse',
        },
        scale: 0,
        rotation: -180,
        opacity: 0,
        duration: 0.5,
        delay: index * 0.1 + 0.3,
        ease: 'back.out(1.7)',
      });
    }

    // 价格数字递增动画
    const priceValue = card.querySelector('.price-value');
    if (priceValue) {
      const priceText = priceValue.textContent || '';
      const priceNumber = parseFloat(priceText.replace(/[$,]/g, ''));

      if (!isNaN(priceNumber)) {
        const priceObj = { value: 0 };

        gsap.to(priceObj, {
          value: priceNumber,
          duration: 1.5,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: card,
            start: 'top 85%',
            toggleActions: 'play none none reverse',
          },
          onUpdate() {
            priceValue.textContent = `$${priceObj.value.toFixed(2)}`;
          },
        });
      }
    }

    // 特性列表逐条动画
    const features = card.querySelectorAll('.product-features li');
    features.forEach((feature: any, i: number) => {
      gsap.from(feature, {
        scrollTrigger: {
          trigger: card,
          start: 'top 85%',
          toggleActions: 'play none none reverse',
        },
        x: -20,
        opacity: 0,
        duration: 0.5,
        delay: index * 0.1 + i * 0.05,
        ease: 'power2.out',
      });
    });
  });

  // 滚动导航
  const slider = document.getElementById('productsSlider');
  const prevBtn = document.getElementById('productPrev');
  const nextBtn = document.getElementById('productNext');
  const dots = document.querySelectorAll('.dot');

  if (slider && prevBtn && nextBtn && dots.length > 0) {
    let autoScrollTween: gsap.core.Tween | null = null;
    let isHovering = false;
    let isManualScrolling = false;
    let manualScrollTimer: number | null = null;

    const cardWidth = 340 + 32; // 卡片宽度 + gap

    // 更新活动 dot
    function updateActiveDot() {
      const scrollLeft = slider.scrollLeft;
      const maxScroll = slider.scrollWidth - slider.clientWidth;

      // 根据滚动位置计算当前页
      let currentPage = 0;
      if (scrollLeft <= 10) {
        currentPage = 0;
      } else if (scrollLeft >= maxScroll - 10) {
        currentPage = dots.length - 1;
      } else {
        currentPage = Math.round(scrollLeft / (maxScroll / (dots.length - 1)));
      }

      dots.forEach((dot, index) => {
        if (index === currentPage) {
          dot.classList.add('active');
          gsap.to(dot, {
            scale: 1,
            opacity: 1,
            duration: 0.3,
          });
        } else {
          dot.classList.remove('active');
          gsap.to(dot, {
            scale: 0.7,
            opacity: 0.4,
            duration: 0.3,
          });
        }
      });
    }

    // Dot 点击事件
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        if (autoScrollTween) autoScrollTween.kill();
        isManualScrolling = true;

        const maxScroll = slider.scrollWidth - slider.clientWidth;
        const targetScroll = (maxScroll / (dots.length - 1)) * index;

        gsap.to(slider, {
          scrollLeft: targetScroll,
          duration: 0.8,
          ease: 'power2.out',
          onComplete: updateActiveDot,
        });

        if (manualScrollTimer) clearTimeout(manualScrollTimer);
        manualScrollTimer = window.setTimeout(() => {
          isManualScrolling = false;
          if (!isHovering) startAutoScroll();
        }, 3000);
      });
    });

    // 自动滚动
    function startAutoScroll() {
      if (isHovering || isManualScrolling) return;

      const maxScroll = slider.scrollWidth - slider.clientWidth;
      const currentScroll = slider.scrollLeft;

      if (currentScroll >= maxScroll - 5) {
        gsap.to(slider, {
          scrollLeft: 0,
          duration: 1,
          ease: 'power2.inOut',
          onComplete: () => {
            updateActiveDot();
            setTimeout(() => startAutoScroll(), 2500);
          },
        });
      } else {
        autoScrollTween = gsap.to(slider, {
          scrollLeft: '+=400',
          duration: 1.2,
          ease: 'power2.inOut',
          onComplete: () => {
            updateActiveDot();
            setTimeout(() => startAutoScroll(), 2500);
          },
        });
      }
    }

    // 当组件进入视口时，重置到第一个产品
    ScrollTrigger.create({
      trigger: '.popular-products',
      start: 'top 80%',
      once: true,
      onEnter: () => {
        // 确保滚动位置在开头
        slider.scrollLeft = 0;
        updateActiveDot();
        // 3秒后开始自动滚动
        setTimeout(() => {
          if (!isHovering && !isManualScrolling) {
            startAutoScroll();
          }
        }, 3000);
      },
    });

    // 初始化 dot 状态
    updateActiveDot();

    slider.addEventListener('mouseenter', () => {
      isHovering = true;
      if (autoScrollTween) autoScrollTween.kill();
    });

    slider.addEventListener('mouseleave', () => {
      isHovering = false;
      if (!isManualScrolling) {
        setTimeout(() => startAutoScroll(), 2000);
      }
    });

    // 手动滚动检测
    let scrollTimer: number | null = null;
    slider.addEventListener('scroll', () => {
      updateActiveDot();

      // 检测是否是用户手动滚动（非GSAP动画滚动）
      if (!autoScrollTween || !autoScrollTween.isActive()) {
        isManualScrolling = true;
        if (autoScrollTween) autoScrollTween.kill();

        if (scrollTimer) clearTimeout(scrollTimer);
        scrollTimer = window.setTimeout(() => {
          isManualScrolling = false;
          if (!isHovering) {
            setTimeout(() => startAutoScroll(), 2000);
          }
        }, 3000);
      }
    });

    // 手动导航按钮
    prevBtn.addEventListener('click', () => {
      if (autoScrollTween) autoScrollTween.kill();
      isManualScrolling = true;

      gsap.to(slider, {
        scrollLeft: slider.scrollLeft - 400,
        duration: 0.6,
        ease: 'power2.out',
        onComplete: updateActiveDot,
      });

      if (manualScrollTimer) clearTimeout(manualScrollTimer);
      manualScrollTimer = window.setTimeout(() => {
        isManualScrolling = false;
        if (!isHovering) startAutoScroll();
      }, 3000);
    });

    nextBtn.addEventListener('click', () => {
      if (autoScrollTween) autoScrollTween.kill();
      isManualScrolling = true;

      gsap.to(slider, {
        scrollLeft: slider.scrollLeft + 400,
        duration: 0.6,
        ease: 'power2.out',
        onComplete: updateActiveDot,
      });

      if (manualScrollTimer) clearTimeout(manualScrollTimer);
      manualScrollTimer = window.setTimeout(() => {
        isManualScrolling = false;
        if (!isHovering) startAutoScroll();
      }, 3000);
    });

    // 更新按钮状态
    function updateButtons() {
      const scrollLeft = slider.scrollLeft;
      const maxScroll = slider.scrollWidth - slider.clientWidth;

      gsap.to(prevBtn, {
        opacity: scrollLeft <= 0 ? 0.3 : 1,
        duration: 0.3,
      });

      gsap.to(nextBtn, {
        opacity: scrollLeft >= maxScroll - 5 ? 0.3 : 1,
        duration: 0.3,
      });
    }

    slider.addEventListener('scroll', updateButtons);
    updateButtons();
    updateActiveDot();
  }
</script>

<style>
  .popular-products {
    background: #fff;
    padding: 6rem 0;
  }

  .products-container {
    max-width: 1800px;
    margin: 0 auto;
    padding: 0 var(--spacing-xl);
  }

  /* 标题区域 */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3rem;
  }

  .header-content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .section-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #000;
    background: #f5f5f5;
    padding: 0.5rem 1rem;
    border-radius: 2px;
    width: fit-content;
  }

  .section-title {
    font-size: clamp(1.75rem, 4vw, 3.5rem);
    font-weight: 800;
    color: #000;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  /* 导航箭头 */
  .nav-arrows {
    display: flex;
    gap: 0.5rem;
  }

  .arrow-btn {
    width: 48px;
    height: 48px;
    border: 2px solid #000;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s;
  }

  .arrow-btn:hover {
    background: #000;
    color: #fff;
  }

  .arrow-btn svg {
    transition: stroke 0.3s;
  }

  .arrow-btn:hover svg {
    stroke: #fff;
  }

  /* 产品滚动区域 */
  .products-wrapper {
    position: relative;
  }

  .products-slider {
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    padding-bottom: 1rem;
    scrollbar-width: none;
  }

  .products-slider::-webkit-scrollbar {
    display: none;
  }

  /* 分页指示器 Dots */
  .pagination-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #d0d0d0;
    border: none;
    cursor: pointer;
    transition: all 0.3s;
    opacity: 0.4;
    transform: scale(0.7);
  }

  .dot:hover {
    background: #999;
    transform: scale(0.85);
  }

  .dot.active {
    background: #000;
    opacity: 1;
    transform: scale(1);
  }

  /* 产品卡片 */
  .product-card {
    flex: 0 0 340px;
    background: #fff;
    border: 1px solid #e5e5e5;
    transition: all 0.3s;
  }

  .product-card:hover {
    border-color: #000;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  .product-link {
    display: block;
    height: 100%;
  }

  /* 产品图片 */
  .product-image {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: #f9f9f9;
  }

  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }

  .product-card:hover .product-image img {
    transform: scale(1.05);
  }

  .product-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: #000;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.4rem 0.8rem;
  }

  .product-colors {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: #fff;
    color: #000;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.4rem 0.8rem;
    border: 1px solid #e5e5e5;
  }

  .desktop-only {
    display: block;
  }

  /* 产品信息 */
  .product-info {
    padding: 1.5rem;
  }

  .product-name {
    font-size: 1.1rem;
    font-weight: 700;
    color: #000;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin-bottom: 1rem;
  }

  .product-features {
    list-style: none;
    margin-bottom: 1.5rem;
  }

  .product-features li {
    font-size: 0.85rem;
    color: #666;
    line-height: 1.8;
    padding-left: 1rem;
    position: relative;
  }

  .product-features li::before {
    content: '•';
    position: absolute;
    left: 0;
    color: #000;
    font-weight: 700;
  }

  /* 产品底部 */
  .product-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid #e5e5e5;
  }

  .product-price {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .price-label {
    font-size: 0.7rem;
    font-weight: 600;
    color: #999;
    text-transform: lowercase;
  }

  .price-value {
    font-size: 1.5rem;
    font-weight: 800;
    color: #000;
    letter-spacing: -0.02em;
  }

  .add-to-cart {
    width: 44px;
    height: 44px;
    background: #000;
    color: #fff;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s;
  }

  .add-to-cart:hover {
    background: #333;
    transform: scale(1.1);
  }

  /* 响应式 */
  @media (max-width: 768px) {
    .popular-products {
      padding: 3.5rem 0;
    }

    .products-container {
      padding: 0 1rem;
    }

    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      margin-bottom: 2rem;
    }

    .section-badge {
      font-size: 0.65rem;
      padding: 0.4rem 0.85rem;
    }

    .section-title {
      font-size: clamp(1.5rem, 6vw, 1.75rem);
    }

    .desktop-only {
      display: none;
    }

    .product-card {
      flex: 0 0 240px;
    }

    .product-image {
      aspect-ratio: 1;
    }

    .product-badge {
      font-size: 0.6rem;
      padding: 0.35rem 0.7rem;
      top: 0.75rem;
      left: 0.75rem;
    }

    .product-info {
      padding: 1rem;
    }

    .product-name {
      font-size: 0.9rem;
      margin-bottom: 0.75rem;
    }

    .product-features {
      margin-bottom: 1rem;
    }

    .product-features li {
      font-size: 0.75rem;
      line-height: 1.5;
      padding-left: 0.85rem;
    }

    .product-footer {
      padding-top: 0.875rem;
    }

    .price-label {
      font-size: 0.65rem;
    }

    .price-value {
      font-size: 1.25rem;
    }

    .add-to-cart {
      width: 38px;
