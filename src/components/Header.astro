<script>
  // Auth modal tabs
  document.addEventListener('DOMContentLoaded', () => {
    // Password toggle functionality
    const passwordToggles = document.querySelectorAll('[data-password-toggle]');
    passwordToggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        const input = toggle.parentElement?.querySelector('[data-password-input]');
        if (input) {
          const type = input.getAttribute('type') === 'password' ? 'text' : 'password';
          input.setAttribute('type', type);
        }
      });
    });

    // Switch between login and register
    const switchToRegister = document.querySelectorAll('[data-switch-to-register]');
    const switchToLogin = document.querySelectorAll('[data-switch-to-login]');

    switchToRegister.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        document.querySelector('[data-auth-tab="register"]')?.click();
      });
    });

    switchToLogin.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        document.querySelector('[data-auth-tab="login"]')?.click();
      });
    });

    // Google login/register buttons - removed

    const authTabs = document.querySelectorAll('[data-auth-tab]');
    const authForms = document.querySelectorAll('[data-auth-form]');

    authTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const tabName = tab.getAttribute('data-auth-tab');

        authTabs.forEach(t => t.classList.remove('active'));
        authForms.forEach(f => f.classList.remove('active'));

        tab.classList.add('active');
        document.querySelector(`[data-auth-form="${tabName}"]`)?.classList.add('active');
      });
    });

    // Login form submission
    const loginForm = document.querySelector('[data-login-form]');
    const loginMessage = document.querySelector('[data-login-message]');

    if (loginForm) {
      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const formData = new FormData(loginForm);
        const data = {
          username: formData.get('username'),
          password: formData.get('password'),
        };

        const submitBtn = loginForm.querySelector('button[type="submit"]');
        const btnText = submitBtn?.querySelector('.btn-text');
        if (submitBtn) {
          submitBtn.disabled = true;
          if (btnText) btnText.textContent = 'Signing in...';
        }

        try {
          const response = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });

          const result = await response.json();

          if (response.ok) {
            showAuthMessage(loginMessage, 'Login successful! Redirecting...', 'success');
            setTimeout(() => {
              window.location.reload();
            }, 1000);
          } else {
            showAuthMessage(loginMessage, result.error || 'Login failed', 'error');
          }

          if (submitBtn) {
            submitBtn.disabled = false;
            if (btnText) btnText.textContent = 'Sign In';
          }
        } catch (error) {
          if (submitBtn) {
            submitBtn.disabled = false;
            if (btnText) btnText.textContent = 'Sign In';
          }
          showAuthMessage(loginMessage, 'An error occurred. Please try again.', 'error');
        }
      });
    }

    // Register form submission
    const registerForm = document.querySelector('[data-register-form]');
    const registerMessage = document.querySelector('[data-register-message]');

    if (registerForm) {
      registerForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const formData = new FormData(registerForm);
        const data = {
          username: formData.get('username'),
          email: formData.get('email'),
          password: formData.get('password'),
          firstName: formData.get('firstName'),
          lastName: formData.get('lastName'),
        };

        const submitBtn = registerForm.querySelector('button[type="submit"]');
        const btnText = submitBtn?.querySelector('.btn-text');
        if (submitBtn) {
          submitBtn.disabled = true;
          if (btnText) btnText.textContent = 'Creating...';
        }

        try {
          const response = await fetch('/api/auth/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });

          const result = await response.json();

          if (response.ok) {
            showAuthMessage(registerMessage, result.message || 'Account created! Please log in.', 'success');
            registerForm.reset();

            // Switch to login tab after 2 seconds
            setTimeout(() => {
              document.querySelector('[data-auth-tab="login"]')?.click();
            }, 2000);
          } else {
            showAuthMessage(registerMessage, result.error || 'Registration failed', 'error');
          }

          if (submitBtn) {
            submitBtn.disabled = false;
            if (btnText) btnText.textContent = 'Create Account';
          }
        } catch (error) {
          if (submitBtn) {
            submitBtn.disabled = false;
            if (btnText) btnText.textContent = 'Create Account';
          }
          showAuthMessage(registerMessage, 'An error occurred. Please try again.', 'error');
        }
      });
    }

    function showAuthMessage(element, message, type) {
      if (element) {
        element.textContent = message;
        element.className = `auth-message ${type}`;
        element.style.display = 'block';

        setTimeout(() => {
          element.style.display = 'none';
        }, 5000);
      }
    }
  });
</script>
