</style>

<script>
  import { CartManager } from '../lib/cart-manager';
  import { showInfo } from '../lib/alert';

  // 移动端菜单交互逻辑
  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenuBtn = document.querySelector('[data-mobile-menu-btn]');
    const mobileMenu = document.querySelector('[data-mobile-menu]');
    const mobileMenuOverlay = document.querySelector('[data-mobile-menu-overlay]');
    const mobileMenuClose = document.querySelector('[data-mobile-menu-close]');
    const submenuToggles = document.querySelectorAll('[data-mobile-submenu-toggle]');
    const submenuBacks = document.querySelectorAll('[data-mobile-submenu-back]');

    // 打开移动端菜单
    if (mobileMenuBtn) {
      mobileMenuBtn.addEventListener('click', () => {
        mobileMenu?.classList.add('active');
        mobileMenuBtn.classList.add('active');
        document.body.style.overflow = 'hidden';
      });
    }

    // 关闭移动端菜单
    const closeMobileMenu = () => {
      mobileMenu?.classList.remove('active');
      mobileMenuBtn?.classList.remove('active');
      document.body.style.overflow = '';
      // 关闭所有子菜单
      document.querySelectorAll('.mobile-menu-item').forEach(item => {
        item.classList.remove('submenu-open');
      });
    };

    if (mobileMenuClose) {
      mobileMenuClose.addEventListener('click', closeMobileMenu);
    }

    if (mobileMenuOverlay) {
      mobileMenuOverlay.addEventListener('click', closeMobileMenu);
    }

    // 子菜单切换
    submenuToggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        const menuItem = toggle.closest('.mobile-menu-item');
        menuItem?.classList.add('submenu-open');
      });
    });

    // 返回按钮
    submenuBacks.forEach(back => {
      back.addEventListener('click', () => {
        const menuItem = back.closest('.mobile-menu-item');
        menuItem?.classList.remove('submenu-open');
      });
    });

    // 点击链接后关闭菜单
    const mobileMenuLinks = document.querySelectorAll('.mobile-menu-link:not(.mobile-menu-link--parent), .mobile-submenu-item');
    mobileMenuLinks.forEach(link => {
      link.addEventListener('click', closeMobileMenu);
    });

  // Mega Menu 交互逻辑
    const navItems = document.querySelectorAll('.nav-item');

    navItems.forEach((navItem) => {
      const megaMenu = navItem.querySelector('[data-mega-menu]');
      const backdrop = navItem.querySelector('[data-mega-backdrop]');

      if (megaMenu) {
        let isHovering = false;
        let hoverTimeout: number;

        // 鼠标进入导航项
        navItem.addEventListener('mouseenter', () => {
          clearTimeout(hoverTimeout);
          isHovering = true;
          megaMenu.classList.add('show');
        });

        // 鼠标离开导航项
        navItem.addEventListener('mouseleave', () => {
          isHovering = false;
          hoverTimeout = setTimeout(() => {
            if (!isHovering) {
              megaMenu.classList.remove('show');
            }
          }, 100);
        });

        // 鼠标进入 Mega Menu
        megaMenu.addEventListener('mouseenter', () => {
          clearTimeout(hoverTimeout);
          isHovering = true;
        });

        // 鼠标离开 Mega Menu
        megaMenu.addEventListener('mouseleave', () => {
          isHovering = false;
          hoverTimeout = setTimeout(() => {
            if (!isHovering) {
              megaMenu.classList.remove('show');
            }
          }, 100);
        });

        // 鼠标进入 backdrop 区域时关闭菜单
        if (backdrop) {
          backdrop.addEventListener('mouseenter', () => {
            isHovering = false;
            megaMenu.classList.remove('show');
          });

          // 点击背景遮罩关闭
          backdrop.addEventListener('click', () => {
            megaMenu.classList.remove('show');
          });
        }
      }
    });

    // Cart button click handler
    const cartBtn = document.querySelector('[data-open-cart]');
    if (cartBtn) {
      cartBtn.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('open-cart'));
      });
    }

    // Search button click handler
    const searchBtn = document.querySelector('[data-open-search]');
    if (searchBtn) {
      searchBtn.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('open-search'));
      });
    }

    // Update cart badge
    function updateCartBadge() {
      const badge = document.querySelector('[data-cart-badge]') as HTMLElement;
      if (badge) {
        const count = CartManager.getItemCount();
        badge.textContent = count.toString();
        badge.style.display = count > 0 ? 'flex' : 'none';
      }
    }

    // Update badge on page load
    updateCartBadge();

    // Listen for cart updates
    window.addEventListener('cart-updated', () => {
      updateCartBadge();
    });

    // ==================== Auth Modal ====================
    const authBtn = document.querySelector('[data-open-auth]');
    const authModal = document.querySelector('[data-auth-modal]');
    const closeAuthBtns = document.querySelectorAll('[data-close-auth]');

    if (authBtn) {
      authBtn.addEventListener('click', async () => {
        // Check if user is logged in
        const response = await fetch('/api/auth/session');
        const data = await response.json();

        if (data.authenticated) {
          // Show user menu
          showUserMenu(data.user);
        } else {
          // Show login modal
          if (authModal) {
            authModal.classList.add('active');
            document.body.style.overflow = 'hidden';
          }
        }
      });
    }

    closeAuthBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (authModal) {
          authModal.classList.remove('active');
          document.body.style.overflow = '';
        }
      });
    });

    // Handle forgot password link
    const forgotPasswordLink = document.querySelector('.forgot-password');
    if (forgotPasswordLink) {
      forgotPasswordLink.addEventListener('click', (e) => {
        e.preventDefault();
        // Close auth modal
        if (authModal) {
          authModal.classList.remove('active');
          document.body.style.overflow = '';
        }
        // Navigate to reset password page
        window.location.href = '/reset-password';
      });
    }

    function showUserMenu(user) {
      // Simple implementation - redirect to account page or show dropdown
      showInfo(
        `Welcome, ${user.name}!\n\nFeatures:\n- View Orders\n- Account Settings\n- Logout`,
        'Account'
      );
      // TODO: Implement proper user dropdown menu
    }

    // Check auth status on page load
    checkAuthStatus();

    async function checkAuthStatus() {
      try {
        const response = await fetch('/api/auth/session');
        const data = await response.json();

        const userBtn = document.querySelector('[data-user-btn]');
        const userIcon = document.querySelector('[data-user-icon]');
        const userAvatar = document.querySelector('[data-user-avatar]');
        const dropdown = document.querySelector('[data-user-dropdown]');
        const dropdownAvatar = document.querySelector('[data-dropdown-avatar]');
        const dropdownName = document.querySelector('[data-dropdown-name]');
        const dropdownEmail = document.querySelector('[data-dropdown-email]');

        if (data.authenticated) {
          // Show user avatar instead of icon
          if (userAvatar && userIcon) {
            userAvatar.src = `${data.user.avatar}?t=${Date.now()}`;
            userAvatar.style.display = 'block';
            userIcon.style.display = 'none';
          }

          // Update dropdown info
          if (dropdownAvatar) dropdownAvatar.src = `${data.user.avatar}?t=${Date.now()}`;
          if (dropdownName) dropdownName.textContent = data.user.name;
          if (dropdownEmail) dropdownEmail.textContent = data.user.email;

          // Add dropdown toggle functionality
          if (userBtn && dropdown) {
            userBtn.addEventListener('click', (e) => {
              e.stopPropagation();
              dropdown.classList.toggle('active');
            });

            // Close dropdown when clicking outside
            document.addEventListener('click', () => {
              dropdown.classList.remove('active');
            });

            dropdown.addEventListener('click', (e) => {
              e.stopPropagation();
            });
          }

          // Handle logout
          const logoutBtn = document.querySelector('[data-logout-btn]');
          if (logoutBtn) {
            logoutBtn.addEventListener('click', async () => {
              try {
                await fetch('/api/auth/logout', { method: 'POST' });
                window.location.reload();
              } catch (error) {
                console.error('Logout error:', error);
              }
            });
          }
        } else {
          // Not logged in - keep showing login icon
          if (userBtn) {
            userBtn.addEventListener('click', () => {
              authModal.classList.add('active');
            });
          }
        }
      } catch (error) {
        console.error('Auth check error:', error);
      }
    }
  });
</script>

