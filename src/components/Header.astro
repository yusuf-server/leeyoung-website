---
import { getProductCategories, getProducts, type WooCategory, type WooProduct } from '../lib/woocommerce';
import { getEnv } from '../lib/env';

const navItems = [
  { name: 'Home', href: '/' },
  { name: 'Products', href: '/shop', hasMegaMenu: true },
  { name: 'About', href: '/about' },
  { name: 'Blog', href: '/blog' },
  { name: 'Contact', href: '/contact' },
];

// 获取环境变量（兼容 Cloudflare Pages）
const env = getEnv(Astro.locals);

// 从 WooCommerce 获取所有产品（不是分类）
let productCategories = [];
try {
  const products: WooProduct[] = await getProducts({
    per_page: 100,
    orderby: 'menu_order',
    order: 'asc',
    stock_status: 'instock',
    env,
  });

  productCategories = products.map(product => ({
    name: product.name.toUpperCase(),
    image: product.images[0]?.src || 'https://via.placeholder.com/300',
    href: `/products/${product.slug}`,
  }));
} catch (error) {
  console.error('Failed to fetch products:', error);
}
---

<header class="header">
  <div class="container">
    <div class="header-content">
      <a href="/" class="logo">
        <span class="logo-text">LEEYOUNG</span>
      </a>

      <nav class="nav">
        {navItems.map((item) => (
          <div class="nav-item">
            <a href={item.href} class="nav-link">
              {item.name}
              {item.hasMegaMenu && (
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M6 9l6 6 6-6"/>
                </svg>
              )}
            </a>

            {item.hasMegaMenu && (
              <div class="mega-menu" data-mega-menu>
                <div class="mega-menu-backdrop" data-mega-backdrop></div>
                <div class="mega-menu-content" data-mega-content>
                  <div class="mega-menu-grid">
                    {productCategories.map((category, index) => (
                      <a
                        href={category.href}
                        class="mega-menu-item"
                        data-animate-menu="fade-up"
                        style={`animation-delay: ${index * 50}ms`}
                      >
                        <div class="mega-menu-image">
                          <img src={category.image} alt={category.name} />
                          <div class="mega-menu-overlay"></div>
                        </div>
                        <h3 class="mega-menu-title">{category.name}</h3>
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            )}
          </div>
        ))}
      </nav>

      <div class="header-actions">
        <button class="icon-btn" aria-label="搜索" data-open-search>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.35-4.35"/>
          </svg>
        </button>

        <!-- User Account Button -->
        <button class="icon-btn user-btn" aria-label="账户" data-user-btn>
          <img src="" alt="User" class="user-avatar" data-user-avatar style="display: none;" />
          <svg class="user-icon" data-user-icon width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </button>

        <!-- User Dropdown Menu -->
        <div class="user-dropdown" data-user-dropdown>
          <div class="dropdown-header">
            <img src="" alt="User" class="dropdown-avatar" data-dropdown-avatar />
            <div class="dropdown-user-info">
              <div class="dropdown-user-name" data-dropdown-name>User</div>
              <div class="dropdown-user-email" data-dropdown-email>user@example.com</div>
            </div>
          </div>
          <div class="dropdown-divider"></div>
          <nav class="dropdown-menu">
            <a href="/account/settings" class="dropdown-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M12 1v6m0 6v6m5.2-13.2l-4.2 4.2m0 6l4.2 4.2M23 12h-6m-6 0H1m13.2 5.2l-4.2-4.2m0-6l-4.2-4.2"></path>
              </svg>
              <span>Account Settings</span>
            </a>
            <a href="/account/orders" class="dropdown-item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
              <span>My Orders</span>
            </a>
            <div class="dropdown-divider"></div>
            <button class="dropdown-item" data-logout-btn>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
              </svg>
              <span>Logout</span>
            </button>
          </nav>
        </div>

        <button class="icon-btn cart-btn" aria-label="购物车" data-open-cart>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="9" cy="21" r="1"/>
            <circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
          </svg>
          <span class="cart-badge" data-cart-badge style="display: none;">0</span>
        </button>
      </div>

      <button class="mobile-menu-btn" aria-label="菜单" data-mobile-menu-btn>
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="mobile-menu" data-mobile-menu>
    <div class="mobile-menu-overlay" data-mobile-menu-overlay></div>
    <div class="mobile-menu-panel">
      <div class="mobile-menu-header">
        <span class="logo-text">LEEYOUNG</span>
        <button class="mobile-menu-close" data-mobile-menu-close aria-label="关闭菜单">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <nav class="mobile-menu-nav">
        <ul class="mobile-menu-list">
          {navItems.map((item) => (
            <li class="mobile-menu-item">
              {item.hasMegaMenu ? (
                <>
                  <button class="mobile-menu-link mobile-menu-link--parent" data-mobile-submenu-toggle>
                    <span>{item.name}</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M9 18l6-6-6-6"/>
                    </svg>
                  </button>
                  <div class="mobile-submenu" data-mobile-submenu>
                    <div class="mobile-submenu-header">
                      <button class="mobile-submenu-back" data-mobile-submenu-back>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M15 18l-6-6 6-6"/>
                        </svg>
                        <span>Back</span>
                      </button>
                      <span class="mobile-submenu-title">{item.name}</span>
                    </div>
                    <div class="mobile-submenu-grid">
                      <!-- View All Products 选项 -->
                      <a href="/shop" class="mobile-submenu-item mobile-submenu-item--all">
                        
                        <span class="mobile-submenu-name mobile-submenu-name--all">View All Products</span>
                      </a>
                      {productCategories.map((category) => (
                        <a href={category.href} class="mobile-submenu-item">
                          <div class="mobile-submenu-image">
                            <img src={category.image} alt={category.name} />
                          </div>
                          <span class="mobile-submenu-name">{category.name}</span>
                        </a>
                      ))}
                    </div>
                  </div>
                </>
              ) : (
                <a href={item.href} class="mobile-menu-link">
                  <span>{item.name}</span>
                </a>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: #000;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    transition: background-color 0.3s ease;
  }

  /* 首页特殊样式：初始透明 */
  body.home-page .header {
    background: transparent;
  }

  /* 首页滚动后变黑色 */
  body.home-page .header.scrolled {
    background: #000;
  }

  .container {
    max-width: 1800px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-sm) 0;
  }

  .logo-text {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--color-secondary);
  }

  .nav {
    display: flex;
    gap: var(--spacing-md);
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    color: var(--color-secondary);
    font-size: 0.9rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color 0.3s;
    padding: 0.5rem 0;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link:hover {
    color: var(--color-accent);
  }

  .nav-link svg {
    transition: transform 0.3s;
  }

  .nav-item:hover .nav-link svg {
    transform: rotate(180deg);
  }

  /* Mega Menu 样式 */
  .mega-menu {
    position: fixed;
    top: 80px;
    left: 0;
    right: 0;
    width: 100vw;
    background: transparent;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s, visibility 0.3s;
    z-index: 999;
    pointer-events: none;
  }

  .mega-menu.show {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* 模糊背景遮罩 */
  .mega-menu-backdrop {
    position: fixed;
    top: 80px;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(10px);
    z-index: -1;
  }

  .nav-item:hover .mega-menu.show {
    opacity: 1;
    visibility: visible;
  }

  .mega-menu-content {
    position: relative;
    background: #ffffff;
    padding: var(--spacing-lg) 0;
    border-bottom: 1px solid #e5e5e5;
  }

  .mega-menu-grid {
    max-width: 1800px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.5rem;
  }

  .mega-menu-item {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 0;
    background: transparent;
    transition: all 0.3s;
    opacity: 0;
    transform: translateY(20px);
  }

  .nav-item:hover .mega-menu-item[data-animate-menu] {
    animation: menuItemFadeIn 0.4s ease-out forwards;
  }

  @keyframes menuItemFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mega-menu-item:hover {
    transform: translateY(-5px);
  }

  .mega-menu-image {
    border-radius:10px;
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: #f8f8f8;
  }

  .mega-menu-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }

  .mega-menu-item:hover .mega-menu-image img {
    transform: scale(1.1);
  }

  .mega-menu-overlay {
    position: absolute;
    inset: 0;
    
    opacity: 0;
    transition: opacity 0.3s;
  }

  .mega-menu-item:hover .mega-menu-overlay {
    opacity: 1;
  }

  .mega-menu-title {
    position: relative;
    padding: 1.25rem 0.5rem;
    color: var(--color-primary);
    font-size: 0.65rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-align: center;
    z-index: 10;
    line-height: 1.2;
  }

  .header-actions {
    display: flex;
    gap: var(--spacing-sm);
  }

  .icon-btn {
    color: var(--color-secondary);
    padding: 0.5rem;
    transition: color 0.3s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-btn svg {
    width: 20px;
    height: 20px;
  }

  .icon-btn:hover {
    color: var(--color-accent);
  }

  /* User Button & Avatar */
  .user-btn {
    position: relative;
  }

  .user-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-accent);
  }

  .user-icon {
    display: block;
  }

  /* User Dropdown */
  .user-dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    width: 280px;
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition: all 0.3s ease;
    z-index: 1001;
  }

  .user-dropdown.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
  }

  .dropdown-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-accent);
  }

  .dropdown-user-info {
    flex: 1;
    min-width: 0;
  }

  .dropdown-user-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #000;
    margin-bottom: 0.25rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dropdown-user-email {
    font-size: 0.8125rem;
    color: #666;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dropdown-divider {
    height: 1px;
    background: #e5e5e5;
    margin: 0 1rem;
  }

  .dropdown-menu {
    padding: 0.5rem;
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.875rem 1rem;
    color: #333;
    font-size: 0.9375rem;
    text-decoration: none;
    background: none;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s;
    text-align: left;
  }

  .dropdown-item:hover {
    background: #f8f8f8;
    color: var(--color-accent);
  }

  .dropdown-item svg {
    flex-shrink: 0;
    color: #666;
    transition: color 0.2s;
  }

  .dropdown-item:hover svg {
    color: var(--color-accent);
  }

  .dropdown-item span {
    flex: 1;
  }

  .cart-btn {
    position: relative;
  }

  .cart-badge {
    position: absolute;
    top: 0;
    right: 0;
    background: var(--color-accent);
    color: #000;
    font-size: 0.7rem;
    font-weight: 700;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .mobile-menu-btn {
    display: none;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-menu-btn span {
    width: 24px;
    height: 2px;
    background: var(--color-secondary);
    transition: all 0.3s;
  }

  .mobile-menu-btn.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .mobile-menu-btn.active span:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-btn.active span:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -6px);
  }

  /* ==================== Mobile Menu ==================== */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s;
  }

  .mobile-menu.active {
    display: block;
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-menu-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
  }

  .mobile-menu-panel {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 85%;
    max-width: 400px;
    background: #000;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  .mobile-menu.active .mobile-menu-panel {
    transform: translateX(0);
  }

  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .mobile-menu-close {
    background: none;
    border: none;
    color: var(--color-secondary);
    cursor: pointer;
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-menu-nav {
    flex: 1;
    overflow-y: auto;
  }

  .mobile-menu-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .mobile-menu-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .mobile-menu-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 1rem 1.25rem;
    color: var(--color-secondary);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    transition: background 0.2s;
  }

  .mobile-menu-link:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .mobile-menu-link--parent svg {
    transition: transform 0.3s;
  }

  .mobile-menu-item.submenu-open .mobile-menu-link--parent svg {
    transform: rotate(90deg);
  }

  /* Mobile Submenu */
  .mobile-submenu {
    position: fixed;
    inset: 0;
    background: #000;
    z-index: 10;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  .mobile-menu-item.submenu-open .mobile-submenu {
    transform: translateX(0);
  }

  .mobile-submenu-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .mobile-submenu-back {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: none;
    border: none;
    color: var(--color-secondary);
    cursor: pointer;
    padding: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .mobile-submenu-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-secondary);
  }

  .mobile-submenu-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    padding: 1.25rem;
  }

  .mobile-submenu-item {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.2s, background 0.2s;
  }

  .mobile-submenu-item:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.05);
  }

  .mobile-submenu-image {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .mobile-submenu-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mobile-submenu-name {
    padding: 0.75rem;
    text-align: center;
    font-size: 0.5rem;
    font-weight: 400;
    color: var(--color-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.3;
    min-height: 2.2rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* View All Products 特殊样式 */
  .mobile-submenu-item--all {
    grid-column: 1 / -1;
    background: var(--color-secondary);
  }

  .mobile-submenu-item--all:hover {
    background: #e6b800;
    transform: translateY(-2px);
  }

  .mobile-submenu-image--all {
    background: rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mobile-submenu-image--all svg {
    color: var(--color-primary);
  }

  .mobile-submenu-name--all {
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.8rem;
  }

  /* ==================== Auth Modal ==================== */
  .auth-modal {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .auth-modal.active {
    display: flex;
  }

  /* Glassmorphism overlay - no purple gradient */
  .auth-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
  }

  .auth-modal-wrapper {
    position: relative;
    width: 100%;
    max-width: 440px;
    perspective: 1500px;
  }

  /* Glass card with 3D effect */
  .auth-modal-content {
    position: relative;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(24px);
    border-radius: 16px;
    padding: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4), 0 0 60px rgba(139, 92, 246, 0.1);
    transition: transform 0.3s ease;
    overflow-y: visible;
    transform: scale(0.9);
    transform-origin: center;
  }

  /* Hide scrollbars */
  .auth-modal-content::-webkit-scrollbar {
    display: none;
  }

  .auth-modal-content {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* Subtle grid pattern */
  .auth-modal-content::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(135deg, rgba(255, 255, 255, 0.04) 0.5px, transparent 0.5px),
                      linear-gradient(45deg, rgba(255, 255, 255, 0.04) 0.5px, transparent 0.5px);
    background-size: 30px 30px;
    opacity: 0.5;
    pointer-events: none;
    border-radius: 16px;
  }

  /* Animated border beams */
  .border-glow-container {
    position: absolute;
    inset: -1px;
    border-radius: 16px;
    overflow: hidden;
    pointer-events: none;
  }

  .border-beam {
    position: absolute;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.7), transparent);
    opacity: 0.7;
    filter: blur(2px);
  }

  .border-beam-top {
    top: 0;
    left: -50%;
    height: 3px;
    width: 50%;
    animation: beam-horizontal 2.5s ease-in-out infinite;
  }

  .border-beam-right {
    top: -50%;
    right: 0;
    width: 3px;
    height: 50%;
    animation: beam-vertical 2.5s ease-in-out infinite 0.6s;
  }

  .border-beam-bottom {
    bottom: 0;
    right: -50%;
    height: 3px;
    width: 50%;
    animation: beam-horizontal-reverse 2.5s ease-in-out infinite 1.2s;
  }

  .border-beam-left {
    bottom: -50%;
    left: 0;
    width: 3px;
    height: 50%;
    animation: beam-vertical-reverse 2.5s ease-in-out infinite 1.8s;
  }

  @keyframes beam-horizontal {
    0%, 100% { left: -50%; opacity: 0.3; }
    50% { left: 100%; opacity: 0.7; }
  }

  @keyframes beam-vertical {
    0%, 100% { top: -50%; opacity: 0.3; }
    50% { top: 100%; opacity: 0.7; }
  }

  @keyframes beam-horizontal-reverse {
    0%, 100% { right: -50%; opacity: 0.3; }
    50% { right: 100%; opacity: 0.7; }
  }

  @keyframes beam-vertical-reverse {
    0%, 100% { bottom: -50%; opacity: 0.3; }
    50% { bottom: 100%; opacity: 0.7; }
  }

  .auth-modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 36px;
    height: 36px;
    background: transparent;
    border: none;
