---
interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  faqs?: FAQ[];
  image?: string;
}

const { faqs = [], image } = Astro.props;

// 默认 FAQ 数据（硬编码）
const defaultFaqs: FAQ[] = [
  {
    question: "How easy is it to fold and store? What are the folded dimensions?",
    answer: "It folds flat in just a few seconds with a simple one-touch mechanism. Once folded, it becomes super compact and can easily slide under a bed, fit into a car trunk, or slip into tight closet spaces."
  },
  {
    question: "Does this product require assembly upon opening the box?",
    answer: "No complicated installation required! It comes ready to use right out of the box—just unfold the nose plate and extend the handle to start moving immediately."
  },
  {
    question: "Will the wheels scratch indoor wooden floors or make loud noise outdoors?",
    answer: "No. Equipped with premium, wear-resistant TPR/PU quiet wheels, it ensures smooth and whisper-quiet rolling on both indoor hardwood floors and rough outdoor surfaces like concrete or asphalt without leaving marks."
  },
  {
    question: "Do these products come with bungee cords or elastic straps?",
    answer: "Yes! Most of our folding hand trucks come equipped with strong elastic bungee straps to securely anchor your boxes or cargo during transport, preventing tipping or slipping."
  },
  {
    question: "How long does shipping take?",
    answer: "Orders are processed within 24 hours. Fast nationwide delivery typically arrives within 3-7 business days directly from our local US warehouse."
  },
  {
    question: "What is your warranty policy if a part breaks or if I'm not satisfied?",
    answer: "We stand behind our quality with a 30-day risk-free return policy and structural warranty. If you encounter any performance or quality issues, contact our support team for a hassle-free replacement or assistance."
  }
];

// 使用传入的 faqs 或默认 faqs
const displayFaqs = faqs.length > 0 ? faqs : defaultFaqs;

// 如果没有 FAQ 数据，不显示组件
if (!displayFaqs || displayFaqs.length === 0) {
  return null;
}
---

<section class="faq-section">
  <div class="faq-container">
    <!-- FAQ 内容 - 全宽居中 -->
    <div class="faq-content">
      <div class="faq-header">
        <p class="faq-badge" data-faq="badge">FAQ's</p>
        <h2 class="faq-title" data-faq="title">Frequently Asked Questions</h2>
        <p class="faq-description" data-faq="desc">
          Find answers to commonly asked questions about this product.
        </p>
      </div>

      <div class="faq-list">
        {displayFaqs.map((faq, index) => (
          <div class="faq-item" data-faq-item={index}>
            <button class="faq-question" data-faq-toggle>
              <h3>{faq.question}</h3>
              <svg width="20" height="20" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg" class="faq-icon">
                <path d="m4.5 7.2 3.793 3.793a1 1 0 0 0 1.414 0L13.5 7.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // FAQ 展开/收起（使用原生 JavaScript，不依赖 GSAP）
  const faqItems = document.querySelectorAll('.faq-item');

  faqItems.forEach((item) => {
    const toggle = item.querySelector('[data-faq-toggle]');
    const answer = item.querySelector('.faq-answer');

    if (!toggle || !answer) return;

    // 初始状态：收起
    answer.style.height = '0';
    answer.style.opacity = '0';
    answer.style.transition = 'height 0.3s ease, opacity 0.3s ease';

    toggle.addEventListener('click', () => {
      const isOpen = item.classList.contains('open');

      if (isOpen) {
        // 收起
        item.classList.remove('open');
        answer.style.height = '0';
        answer.style.opacity = '0';
      } else {
        // 收起其他已展开的项
        faqItems.forEach((otherItem) => {
          if (otherItem !== item && otherItem.classList.contains('open')) {
            otherItem.classList.remove('open');
            const otherAnswer = otherItem.querySelector('.faq-answer');
            if (otherAnswer) {
              otherAnswer.style.height = '0';
              otherAnswer.style.opacity = '0';
            }
          }
        });

        // 展开当前项
        item.classList.add('open');
        const scrollHeight = answer.scrollHeight;
        answer.style.height = scrollHeight + 'px';
        answer.style.opacity = '1';
      }
    });
  });
</script>

<style>
  .faq-section {
    background: #f9fafb;
    padding: 5rem 0;
  }

  .faq-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-xl);
  }

  /* FAQ 内容 */
  .faq-content {
    width: 100%;
  }

  .faq-header {
    text-align: center;
    margin-bottom: 3rem;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .faq-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: #d4af37;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: rgba(212, 175, 55, 0.1);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    margin-bottom: 1rem;
  }

  .faq-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: #000;
    margin-bottom: 1rem;
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .faq-description {
    font-size: 1rem;
    color: #666;
    line-height: 1.6;
    margin-bottom: 0;
  }

  /* FAQ 列表 */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.3s;
  }

  .faq-item:hover {
    border-color: #d4af37;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  }

  .faq-item.open {
    border-color: #d4af37;
  }

  .faq-question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: none;
    border: none;
    padding: 1.5rem;
    cursor: pointer;
    text-align: left;
    transition: background 0.3s;
  }

  .faq-question:hover {
    background: #fafafa;
  }

  .faq-question h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #000;
    margin: 0;
    padding-right: 1.5rem;
    flex: 1;
    text-transform: none;
    letter-spacing: normal;
  }

  .faq-icon {
    flex-shrink: 0;
    color: #d4af37;
    transition: transform 0.3s ease;
  }

  .faq-item.open .faq-icon {
    transform: rotate(180deg);
  }

  .faq-answer {
    overflow: hidden;
    border-top: 1px solid #f0f0f0;
  }

  .faq-answer p {
    font-size: 0.95rem;
    color: #666;
    line-height: 1.7;
    margin: 0;
    padding: 1.5rem;
  }

  /* 响应式 */
  @media (max-width: 768px) {
    .faq-section {
      padding: 3.5rem 0;
    }

    .faq-container {
      padding: 0 1rem;
    }

    .faq-header {
      margin-bottom: 2rem;
    }

    .faq-badge {
      font-size: 0.65rem;
      padding: 0.4rem 0.85rem;
    }

    .faq-title {
      font-size: clamp(1.5rem, 6vw, 2rem);
      margin-bottom: 0.75rem;
    }

    .faq-description {
      font-size: 0.9rem;
    }

    .faq-list {
      gap: 0.75rem;
    }

    .faq-question {
      padding: 1.25rem;
    }

    .faq-question h3 {
      font-size: 0.95rem;
      padding-right: 1rem;
    }

    .faq-icon {
      width: 18px;
      height: 18px;
    }

    .faq-answer p {
      font-size: 0.875rem;
      padding: 1.25rem;
      line-height: 1.6;
    }
  }

  @media (max-width: 480px) {
    .faq-question {
      padding: 1rem;
    }

    .faq-question h3 {
      font-size: 0.9rem;
    }

    .faq-answer p {
      font-size: 0.85rem;
      padding: 1rem;
    }
  }
</style>
