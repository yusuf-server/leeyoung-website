---
interface Props {
  desktopImage?: string;
  mobileImage?: string;
  eyebrow?: string;
  title: string;
  description: string;
  buttonText?: string;
  buttonLink?: string;
  textPosition?: 'left' | 'center' | 'right';
  textPositionMobile?: 'left' | 'center' | 'right';
}

const {
  desktopImage = 'https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=3840&h=2160&fit=crop',
  mobileImage = 'https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=1500&h=2500&fit=crop',
  eyebrow = 'LEEYOUNG PROFESSIONAL',
  title = 'Trusted by Industry Leaders',
  description = 'Our hand trucks are developed in cooperation with warehouse professionals and logistics experts, who test them in the most demanding industrial conditions. This way, you work with equipment that is proven where real performance truly matters.',
  buttonText = 'See Our Solutions',
  buttonLink = '#products',
  textPosition = 'center',
  textPositionMobile = 'left',
} = Astro.props;
---

<section class="image-banner" data-banner="section">
  <div class="banner-wrapper">
    <div class="banner-container">
      <!-- 图片容器 -->
      <div class="banner-image-container">
        <!-- 移动端图片 -->
        <picture class="banner-picture banner-picture-mobile">
          <img
            src={mobileImage}
            alt={title}
            class="banner-img banner-img-mobile"
            loading="lazy"
          />
        </picture>

        <!-- 桌面端图片 -->
        <picture class="banner-picture banner-picture-desktop">
          <img
            src={desktopImage}
            alt={title}
            class="banner-img banner-img-desktop"
            loading="lazy"
          />
        </picture>
      </div>

      <!-- 内容覆盖层 -->
      <div
        class={`banner-overlay banner-overlay-${textPosition} banner-overlay-mobile-${textPositionMobile}`}
        data-banner="overlay"
      >
        <div class="banner-content">
          <!-- Eyebrow -->
          {eyebrow && (
            <div class="banner-eyebrow" data-banner="eyebrow">
              {eyebrow}
            </div>
          )}

          <!-- 标题 -->
          <h2 class="banner-title" data-banner="title">
            {title}
          </h2>

          <!-- 描述 -->
          <div class="banner-description" data-banner="description">
            <p>{description}</p>
          </div>

          <!-- 按钮 -->
          {buttonText && buttonLink && (
            <div class="banner-button-wrapper" data-banner="button">
              <a href={buttonLink} class="banner-button">
                <span>{buttonText}</span>
              </a>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from '../lib/gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  // Banner 入场动画
  const bannerTL = gsap.timeline({
    scrollTrigger: {
      trigger: '[data-banner="section"]',
      start: 'top 70%',
      toggleActions: 'play none none reverse',
    },
  });

  bannerTL
    .from('[data-banner="eyebrow"]', {
      y: 30,
      opacity: 0,
      duration: 0.6,
    })
    .from(
      '[data-banner="title"]',
      {
        y: 40,
        opacity: 0,
        duration: 0.8,
      },
      '-=0.3'
    )
    .from(
      '[data-banner="description"]',
      {
        y: 30,
        opacity: 0,
        duration: 0.6,
      },
      '-=0.4'
    )
    .from(
      '[data-banner="button"]',
      {
        y: 20,
        opacity: 0,
        duration: 0.6,
      },
      '-=0.3'
    );

  // 图片视差效果
  gsap.to('.banner-img-desktop', {
    scrollTrigger: {
      trigger: '[data-banner="section"]',
      start: 'top bottom',
      end: 'bottom top',
      scrub: 1,
    },
    y: 100,
    ease: 'none',
  });
</script>

<style>
  .image-banner {
    position: relative;
    width: 100%;
    overflow: hidden;
    box-shadow: inset 0 30px 60px rgba(255, 255, 255, 0.3);
  }

  .banner-wrapper {
    width: 100%;
  }

  .banner-container {
    position: relative;
    width: 100%;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* 图片容器 */
  .banner-image-container {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .banner-picture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 桌面端图片 - 默认显示 */
  .banner-picture-desktop {
    display: block;
  }

  .banner-picture-mobile {
    display: none;
  }

  /* 移动端显示移动端图片 */
  @media (max-width: 768px) {
    .banner-picture-desktop {
      display: none;
    }

    .banner-picture-mobile {
      display: block;
    }

    .banner-container {
      min-height: 500px;
    }
  }

  /* 内容覆盖层 */
  .banner-overlay {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 1800px;
    padding: 4rem 2rem;
    display: flex;
  }

  /* 文字位置 - 桌面端 */
  .banner-overlay-left {
    justify-content: flex-start;
    text-align: left;
  }

  .banner-overlay-center {
    justify-content: center;
    text-align: center;
  }

  .banner-overlay-right {
    justify-content: flex-end;
    text-align: right;
  }

  /* 内容容器 */
  .banner-content {
    max-width: 700px;
    background: rgba(255, 255, 255, 0.15);
    padding: 3rem;
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.3);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
  }

  /* Eyebrow */
  .banner-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 1.5rem;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  /* 标题 */
  .banner-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #fff;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.3);
  }

  /* 描述 */
  .banner-description {
    font-size: 1rem;
    line-height: 1.8;
    color: #fff;
    margin-bottom: 2rem;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.2);
  }

  .banner-description p {
    margin: 0;
  }

  /* 按钮 */
  .banner-button-wrapper {
    display: flex;
  }

  .banner-button {
    display: inline-block;
    padding: 1rem 2.5rem;
    background: rgba(255, 255, 255, 0.9);
    color: #000;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-decoration: none;
    transition: all 0.3s;
    border: 1px solid rgba(255, 255, 255, 0.5);
  }

  .banner-button:hover {
    background: #fff;
    transform: translateX(5px);
    box-shadow: 0 4px 16px rgba(255, 255, 255, 0.3);
  }

  /* 移动端样式 */
  @media (max-width: 768px) {
    .banner-overlay {
      padding: 3rem 1.5rem;
    }

    /* 移动端文字位置 */
    .banner-overlay-mobile-left {
      justify-content: flex-start;
      text-align: left;
    }

    .banner-overlay-mobile-center {
      justify-content: center;
      text-align: center;
    }

    .banner-overlay-mobile-right {
      justify-content: flex-end;
      text-align: right;
    }

    .banner-content {
      padding: 2rem;
    }

    .banner-title {
      font-size: 1.75rem;
      margin-bottom: 1rem;
    }

    .banner-description {
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
    }

    .banner-button-wrapper {
      justify-content: inherit;
    }

    .banner-button {
      padding: 0.875rem 2rem;
      font-size: 0.75rem;
    }
  }

  /* 对齐方式调整 */
  .banner-overlay-center .banner-button-wrapper {
    justify-content: center;
  }

  .banner-overlay-right .banner-button-wrapper {
    justify-content: flex-end;
  }
</style>
